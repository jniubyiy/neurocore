#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint op_type;
    uint alpha_bits;
    uint total_elements;
} pc;

layout(binding = 0, std430) readonly buffer InBuf {
    float input_data[];
};
layout(binding = 1, std430) readonly buffer GradOutBuf {
    float grad_out_data[];
};
layout(binding = 2, std430) writeonly buffer GradInBuf {
    float grad_in_data[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total_elements) return;
    float x = input_data[idx];
    float go = grad_out_data[idx];
    float gi = 0.0;
    if (pc.op_type == 0u) {
        gi = x > 0.0 ? go : 0.0;
    } else if (pc.op_type == 1u) {
        gi = go * x * (1.0 - x);
    } else if (pc.op_type == 2u) {
        gi = go * (1.0 - x * x);
    } else if (pc.op_type == 3u) {
        float alpha = uintBitsToFloat(pc.alpha_bits);
        gi = x > 0.0 ? go : go * alpha;
    }
    grad_in_data[idx] = gi;
}