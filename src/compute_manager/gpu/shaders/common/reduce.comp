#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint rows;
} pc;

layout(binding = 0, std430) readonly buffer InBuf {
    float data[];
};

layout(binding = 1, std430) writeonly buffer OutBuf {
    float result[];
};

// Суммирование по строкам: каждая workgroup обрабатывает один столбец
void main() {
    uint col = gl_GlobalInvocationID.x;
    if (col >= gl_NumWorkGroups.x) return; // защита (хотя dispatch делает точно нужное число групп)

    uint cols = gl_NumWorkGroups.x;
    float sum = 0.0;
    for (uint r = 0; r < pc.rows; ++r) {
        sum += data[r * cols + col];
    }
    result[col] = sum;
}