#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint rows;
    uint cols;
} pc;

layout(binding = 0, std430) readonly buffer InBuf {
    float data[];
};
layout(binding = 1, std430) writeonly buffer OutBuf {
    float result[];
};

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.rows) return;
    float max_val = -1e30;
    for (uint c = 0; c < pc.cols; ++c) {
        float v = data[r * pc.cols + c];
        if (v > max_val) max_val = v;
    }
    float sum = 0.0;
    for (uint c = 0; c < pc.cols; ++c) {
        sum += exp(data[r * pc.cols + c] - max_val);
    }
    for (uint c = 0; c < pc.cols; ++c) {
        float val = exp(data[r * pc.cols + c] - max_val) / sum;
        result[r * pc.cols + c] = val;
    }
}