#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint rows;
    uint cols;
} pc;

layout(binding = 0, std430) readonly buffer YBuf {
    float y_data[];
};
layout(binding = 1, std430) readonly buffer GradOutBuf {
    float grad_out_data[];
};
layout(binding = 2, std430) writeonly buffer GradInBuf {
    float grad_in_data[];
};

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.rows) return;
    float dot = 0.0;
    for (uint c = 0; c < pc.cols; ++c) {
        dot += y_data[r * pc.cols + c] * grad_out_data[r * pc.cols + c];
    }
    for (uint c = 0; c < pc.cols; ++c) {
        float y = y_data[r * pc.cols + c];
        float g = y * (grad_out_data[r * pc.cols + c] - dot);
        grad_in_data[r * pc.cols + c] = g;
    }
}