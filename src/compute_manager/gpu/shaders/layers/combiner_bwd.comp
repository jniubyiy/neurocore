#version 450
layout(local_size_x = 256) in;
layout(push_constant) uniform PushConsts { uint batch; uint n; uint m; } pc;
layout(binding = 0, std430) readonly buffer DOut { float dout[]; };
layout(binding = 1, std430) readonly buffer Pre { float pre[]; };
layout(binding = 2, std430) readonly buffer A { float a[]; };
layout(binding = 3, std430) readonly buffer B { float b[]; };
layout(binding = 4, std430) readonly buffer Wa { float wa[]; };
layout(binding = 5, std430) readonly buffer Wb { float wb[]; };
layout(binding = 6, std430) writeonly buffer DA { float da[]; };
layout(binding = 7, std430) writeonly buffer DB { float db[]; };
layout(binding = 8, std430) writeonly buffer DWa { float dwa[]; }; // заполним в отдельном проходе
layout(binding = 9, std430) writeonly buffer DWb { float dwb[]; };
layout(binding = 10, std430) writeonly buffer DBias { float dbias[]; };

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.batch) return;
    // DPre = dout * relu'(pre)
    // da = DPre * Wa^T
    // db = DPre * Wb^T
    for (uint k = 0; k < pc.n; k++) {
        float da_sum = 0.0, db_sum = 0.0;
        for (uint j = 0; j < pc.m; j++) {
            float dpre = (pre[row * pc.m + j] > 0.0) ? dout[row * pc.m + j] : 0.0;
            da_sum += dpre * wa[j * pc.n + k];
            db_sum += dpre * wb[j * pc.n + k];
        }
        da[row * pc.n + k] = da_sum;
        db[row * pc.n + k] = db_sum;
    }
}