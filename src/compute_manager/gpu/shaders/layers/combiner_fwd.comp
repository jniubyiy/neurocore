#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;
    uint m;
} pc;

layout(binding = 0, std430) readonly buffer InA {
    float a[];
};
layout(binding = 1, std430) readonly buffer InB {
    float b[];
};
layout(binding = 2, std430) readonly buffer Wa {
    float wa[];
};
layout(binding = 3, std430) readonly buffer Wb {
    float wb[];
};
layout(binding = 4, std430) readonly buffer Bias {
    float bias[];
};
layout(binding = 5, std430) writeonly buffer OutBuf {
    float out_val[];
};
layout(binding = 6, std430) writeonly buffer PreAct {
    float pre[];
};

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.batch) return;

    uint n = pc.n;
    uint m = pc.m;

    for (uint j = 0; j < m; j++) {
        float sum = bias[j];
        for (uint k = 0; k < n; k++) {
            sum += a[row * n + k] * wa[j * n + k];
            sum += b[row * n + k] * wb[j * n + k];
        }
        pre[row * m + j] = sum;
        out_val[row * m + j] = max(sum, 0.0f);
    }
}