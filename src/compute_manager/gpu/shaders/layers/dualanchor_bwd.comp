#version 450
#extension GL_EXT_shader_atomic_float : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    uint features;
    float alpha;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};
layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};
layout(binding = 2, std430) readonly buffer MinBuf {
    float min_vals[];
};
layout(binding = 3, std430) readonly buffer MaxBuf {
    float max_vals[];
};
layout(binding = 4, std430) writeonly buffer GradInBuf {
    float gi[];
};
layout(binding = 5, std430) buffer GradMinBuf {
    float gmin[];
};
layout(binding = 6, std430) buffer GradMaxBuf {
    float gmax[];
};
layout(binding = 7, std430) buffer GradAlphaBuf {
    float galpha[];      // один элемент
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;

    uint c = i % pc.features;
    float x_val = x[i];
    float min_v = min_vals[c];
    float max_v = max_vals[c];
    float d_min = abs(x_val - min_v);
    float d_max = abs(x_val - max_v);
    float is_min = (d_min <= d_max) ? 1.0f : 0.0f;
    float go_val = go[i];

    // Градиент по x (без атомарности, каждый поток пишет в свою ячейку)
    gi[i] = go_val * (1.0f - pc.alpha);

    // Атомарное накопление градиентов по min и max
    atomicAdd(gmin[c], go_val * pc.alpha * is_min);
    atomicAdd(gmax[c], go_val * pc.alpha * (1.0f - is_min));

    // Атомарное накопление градиента по alpha (один скаляр для всех потоков)
    float closest = (is_min != 0.0f) ? min_v : max_v;
    atomicAdd(galpha[0], go_val * (closest - x_val));
}