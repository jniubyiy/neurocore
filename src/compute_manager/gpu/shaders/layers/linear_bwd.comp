#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer WeightBuf {
    float w[];
};

layout(binding = 2, std430) readonly buffer GradOutBuf {
    float dout[];
};

layout(binding = 3, std430) writeonly buffer GradInBuf {
    float dx[];
};

layout(binding = 4, std430) buffer GradWeightBuf {
    uint dw[];  // битовое представление float
};

layout(binding = 5, std430) buffer GradBiasBuf {
    uint db[];  // битовое представление float
};

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.batch) return;

    // Вычисляем dx для этой строки
    for (uint in_col = 0; in_col < pc.in_features; ++in_col) {
        float sum = 0.0;
        for (uint out_col = 0; out_col < pc.out_features; ++out_col) {
            float dout_val = dout[out_col * pc.batch + row];
            float w_val = w[out_col * pc.in_features + in_col];
            sum += dout_val * w_val;
        }
        dx[in_col * pc.batch + row] = sum;
    }

    // Атомарно накапливаем dW и db
    for (uint out_col = 0; out_col < pc.out_features; ++out_col) {
        float dout_val = dout[out_col * pc.batch + row];

        // db[out_col] += dout_val
        {
            uint expected = db[out_col];
            uint desired;
            do {
                float cur = uintBitsToFloat(expected);
                desired = floatBitsToUint(cur + dout_val);
                uint old = atomicCompSwap(db[out_col], expected, desired);
                if (old == expected) break;
                expected = old;
            } while (true);
        }

        // dW[out_col, in_col] += dout_val * x[in_col, row]
        for (uint in_col = 0; in_col < pc.in_features; ++in_col) {
            float x_val = x[in_col * pc.batch + row];
            float inc = dout_val * x_val;
            uint target_index = out_col * pc.in_features + in_col;
            uint expected = dw[target_index];
            uint desired;
            do {
                float cur = uintBitsToFloat(expected);
                desired = floatBitsToUint(cur + inc);
                uint old = atomicCompSwap(dw[target_index], expected, desired);
                if (old == expected) break;
                expected = old;
            } while (true);
        }
    }
}