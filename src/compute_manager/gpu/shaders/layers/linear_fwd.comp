#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];          // column-major: x[in_col * batch + row]
};

layout(binding = 1, std430) readonly buffer WeightBuf {
    float w[];          // row-major: w[out_idx * in_features + in_idx]
};

layout(binding = 2, std430) readonly buffer BiasBuf {
    float bias[];       // длина out_features
};

layout(binding = 3, std430) writeonly buffer OutputBuf {
    float y[];          // column-major: y[out_col * batch + row]
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.out_features;
    if (idx >= total) return;

    uint row = idx / pc.out_features;
    uint out_col = idx % pc.out_features;

    float sum = bias[out_col];
    for (uint in_col = 0; in_col < pc.in_features; ++in_col) {
        float x_val = x[in_col * pc.batch + row];
        float w_val = w[out_col * pc.in_features + in_col];
        sum += x_val * w_val;
    }

    y[out_col * pc.batch + row] = sum;
}