#version 450
layout(local_size_x = 256) in;
layout(push_constant) uniform PushConsts { uint total; float alpha; } pc;
layout(binding = 0, std430) readonly buffer GradOut { float go[]; };
layout(binding = 1, std430) writeonly buffer GradIn { float gi[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;
    gi[i] = go[i] * (1.0 - pc.alpha);
}