#version 450
#extension GL_EXT_shader_atomic_float : enable
#extension GL_EXT_shader_atomic_float2 : enable

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
    float alpha;
} pc;

layout(binding = 0, std430) readonly buffer In {
    float x[];
};

layout(binding = 1, std430) buffer StateBuf {
    float state[];   // [min[0..features-1], max[features..2*features]]
};

layout(binding = 2, std430) writeonly buffer Out {
    float y[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.batch * pc.features) return;

    uint c = i % pc.features;
    float x_val = x[i];

    float min_val = state[c];
    float max_val = state[pc.features + c];

    float d_min = abs(x_val - min_val);
    float d_max = abs(x_val - max_val);
    float closest = (d_min <= d_max) ? min_val : max_val;
    float y_val = x_val + pc.alpha * (closest - x_val);
    y[i] = y_val;

    // Атомарное обновление минимума и максимума
    atomicMin(state[c], x_val);
    atomicMax(state[pc.features + c], x_val);
}