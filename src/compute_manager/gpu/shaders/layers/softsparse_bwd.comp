#version 450
#extension GL_EXT_shader_atomic_float : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    float temperature;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};
layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};
layout(binding = 2, std430) readonly buffer ThreshBuf {
    float thresh[];
};
layout(binding = 3, std430) writeonly buffer GradInBuf {
    float gi[];
};
layout(binding = 4, std430) buffer GradThreshBuf {
    float gthresh[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;

    uint c = i % pc.features;
    float x_val = x[i];
    float abs_x = abs(x_val);
    float z = (abs_x - thresh[c]) / pc.temperature;
    float s = 1.0f / (1.0f + exp(-z));
    float ds = s * (1.0f - s) / pc.temperature;
    float df_dx = s + abs_x * ds;

    gi[i] = go[i] * df_dx;

    // градиент по порогу: атомарное сложение для безопасного суммирования по всем элементам батча
    float d_s_dthr = -ds;
    atomicAdd(gthresh[c], go[i] * x_val * d_s_dthr);
}