#version 450
#extension GL_EXT_shader_atomic_float : enable

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;   // input features
    uint p;   // output A features
    uint q;   // output B features
} pc;

// Входные данные
layout(binding = 0, std430) readonly buffer X    { float x[]; };
layout(binding = 1, std430) readonly buffer Da   { float da[]; };
layout(binding = 2, std430) readonly buffer Db   { float db[]; };
layout(binding = 3, std430) readonly buffer PreA { float pre_a[]; };
layout(binding = 4, std430) readonly buffer PreB { float pre_b[]; };
layout(binding = 5, std430) readonly buffer Wa   { float wa[]; };
layout(binding = 6, std430) readonly buffer Wb   { float wb[]; };

// Выходные данные
layout(binding = 7, std430) writeonly buffer Dx       { float dx[]; };
layout(binding = 8, std430) buffer         DWa       { float dwa[]; };
layout(binding = 9, std430) buffer         DBiasA    { float dbiasa[]; };
layout(binding =10, std430) buffer         DWb       { float dwb[]; };
layout(binding =11, std430) buffer         DBiasB    { float dbiasb[]; };

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.batch) return;

    // 1. Вычисляем d_pre_a и d_pre_b (ReLU backward)
    float d_pre_a[256]; // предполагаем, что p и q не превышают 256 (локальный размер группы)
    float d_pre_b[256];
    // Примечание: размер массивов должен быть динамическим, но для простоты будем использовать цикл без массива,
    // вычисляя значения на лету.

    // 2. Вычисляем dx = d_pre_a * Wa + d_pre_b * Wb
    for (uint k = 0; k < pc.n; ++k) {
        float sum = 0.0;
        for (uint j = 0; j < pc.p; ++j) {
            float dpa = da[row * pc.p + j] * (pre_a[row * pc.p + j] > 0.0 ? 1.0 : 0.0);
            sum += dpa * wa[j * pc.n + k];
            // атомарный градиент для Wa[j,k]
            atomicAdd(dwa[j * pc.n + k], dpa * x[row * pc.n + k]);
        }
        for (uint j = 0; j < pc.q; ++j) {
            float dpb = db[row * pc.q + j] * (pre_b[row * pc.q + j] > 0.0 ? 1.0 : 0.0);
            sum += dpb * wb[j * pc.n + k];
            atomicAdd(dwb[j * pc.n + k], dpb * x[row * pc.n + k]);
        }
        dx[row * pc.n + k] = sum;
    }

    // 3. Градиенты биасов
    for (uint j = 0; j < pc.p; ++j) {
        float dpa = da[row * pc.p + j] * (pre_a[row * pc.p + j] > 0.0 ? 1.0 : 0.0);
        atomicAdd(dbiasa[j], dpa);
    }
    for (uint j = 0; j < pc.q; ++j) {
        float dpb = db[row * pc.q + j] * (pre_b[row * pc.q + j] > 0.0 ? 1.0 : 0.0);
        atomicAdd(dbiasb[j], dpb);
    }
}