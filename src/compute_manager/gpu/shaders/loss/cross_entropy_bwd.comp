#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint num_classes;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float data[];
};
layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};
layout(binding = 2, std430) writeonly buffer GradInBuf {
    float gi[];
};

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.batch) return;

    uint base = r * (pc.num_classes + 1);
    uint class_idx = uint(data[base + pc.num_classes]);
    float grad = go[r];

    // Устойчивый softmax
    float max_val = data[base];
    for (uint c = 1; c < pc.num_classes; c++) {
        if (data[base + c] > max_val) max_val = data[base + c];
    }

    float sum_exp = 0.0f;
    for (uint c = 0; c < pc.num_classes; c++) {
        sum_exp += exp(data[base + c] - max_val);
    }

    // Градиенты по логитам: softmax_j - one_hot(j == class_idx)
    for (uint j = 0; j < pc.num_classes; j++) {
        float softmax_j = exp(data[base + j] - max_val) / sum_exp;
        float indicator = (j == class_idx) ? 1.0f : 0.0f;
        gi[base + j] = grad * (softmax_j - indicator);
    }
    // Градиент по индексу класса всегда 0
    gi[base + pc.num_classes] = 0.0f;
}