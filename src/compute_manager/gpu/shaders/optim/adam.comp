#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    float beta1;
    float beta2;
    float eps;
    float bias_correction1;
    float bias_correction2;
    uint total;
} pc;

layout(binding = 0, std430) buffer GradBuf {
    float grads[];
};
layout(binding = 1, std430) buffer StateBuf {
    float state[];   // чередование m и v: [m0,v0, m1,v1, ...]
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;

    uint idx2 = i * 2;
    float m = state[idx2];
    float v = state[idx2 + 1];

    float g = grads[i];
    m = pc.beta1 * m + (1.0f - pc.beta1) * g;
    v = pc.beta2 * v + (1.0f - pc.beta2) * g * g;

    float m_hat = m / pc.bias_correction1;
    float v_hat = v / pc.bias_correction2;

    state[idx2] = m;
    state[idx2 + 1] = v;

    grads[i] = m_hat / (sqrt(v_hat) + pc.eps);
}