#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    float min_val;   // огромное отрицательное, если не задано
    float max_val;   // огромное положительное, если не задано
    uint total;
} pc;

layout(binding = 0, std430) buffer GradBuf {
    float grads[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;
    float g = grads[i];
    if (g < pc.min_val) g = pc.min_val;
    if (g > pc.max_val) g = pc.max_val;
    grads[i] = g;
}