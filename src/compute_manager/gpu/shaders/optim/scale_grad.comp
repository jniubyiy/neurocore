#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    float factor;
    uint total;
} pc;

layout(binding = 0, std430) buffer GradBuf {
    float grads[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;
    grads[i] *= pc.factor;
}