#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;          // batch * features
    uint features;       // количество признаков
    uint num_activations; // количество базовых активаций
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // вход (сохранённый при прямом проходе)
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];  // градиент по выходу
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float logits[]; // логиты: logits[k * features + c]
};

layout(binding = 3, std430) writeonly buffer GradInBuf {
    float gi[];  // градиент по входу
};

layout(binding = 4, std430) buffer GradParamsBuf {
    uint grad_logits[]; // битовое представление float для накопления градиентов по логитам
};

// Базовые активации
float activation_value(uint k, float v) {
    if (k == 0u) {
        return max(v, 0.0); // ReLU
    } else if (k == 1u) {
        float sig = 1.0 / (1.0 + exp(-1.702 * v));
        return v * sig;
    } else if (k == 2u) {
        float sig = 1.0 / (1.0 + exp(-v));
        return v * sig;
    } else if (k == 3u) {
        return tanh(v); // Tanh
    } else {
        return max(v, 0.0);
    }
}

// Производные базовых активаций
float activation_derivative(uint k, float v) {
    if (k == 0u) {
        return (v > 0.0) ? 1.0 : 0.0;
    } else if (k == 1u) {
        float sig = 1.0 / (1.0 + exp(-1.702 * v));
        return sig + v * sig * (1.0 - sig) * 1.702;
    } else if (k == 2u) {
        float sig = 1.0 / (1.0 + exp(-v));
        return sig + v * sig * (1.0 - sig);
    } else if (k == 3u) {
        float t = tanh(v);
        return 1.0 - t * t;
    } else {
        return (v > 0.0) ? 1.0 : 0.0;
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    uint c = idx % pc.features;
    float x_val = x[idx];
    float gout = go[idx];

    // Вычисляем softmax логитов для признака c (аналогично forward)
    float max_l = logits[0 * pc.features + c];
    for (uint k = 1; k < pc.num_activations; ++k) {
        float l = logits[k * pc.features + c];
        if (l > max_l) max_l = l;
    }

    float sum_exp = 0.0;
    float w[4];
    for (uint k = 0; k < pc.num_activations; ++k) {
        float l = logits[k * pc.features + c];
        float e = exp(l - max_l);
        w[k] = e;
        sum_exp += e;
    }
    for (uint k = 0; k < pc.num_activations; ++k) {
        w[k] /= sum_exp;
    }

    // Пересчитываем выход (для градиентов по логитам)
    float y_val = 0.0;
    for (uint k = 0; k < pc.num_activations; ++k) {
        y_val += w[k] * activation_value(k, x_val);
    }

    // Градиент по входу
    float sum_der = 0.0;
    for (uint k = 0; k < pc.num_activations; ++k) {
        sum_der += w[k] * activation_derivative(k, x_val);
    }
    gi[idx] = gout * sum_der;

    // Градиенты по логитам (атомарное накопление)
    for (uint k = 0; k < pc.num_activations; ++k) {
        float d_l = gout * (activation_value(k, x_val) - y_val) * w[k];
        uint param_idx = k * pc.features + c;
        uint expected = grad_logits[param_idx];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + d_l);
            uint old = atomicCompSwap(grad_logits[param_idx], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
}
