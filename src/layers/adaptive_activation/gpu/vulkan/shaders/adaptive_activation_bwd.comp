// src/layers/adaptive_activation/gpu/vulkan/shaders/adaptive_activation_bwd.comp
//
// Обратный проход AdaptivePerFeatureActivation на GPU (column-major).
//
// Формулы (совпадают с CPU-версией):
//   gi[idx]           = go[idx] · Σ_k w_k · activation_derivative_k(x_val)
//   grad_logits[k,c] += go[idx] · (activation_k(x_val) − y_val) · w_k
//
// где w = softmax_k(logits[k, c]).
//
// Накопление градиентов по логитам — через канонический макрос
// ATOMIC_ADD_FLOAT над uint-буфером.
//
// Push-константы: total, features, num_activations.
// Dispatch: batch · features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;            // batch · features
    uint features;         // количество признаков
    uint num_activations;  // количество базовых активаций (2..4)
} pc;

layout(binding = 0, std430) readonly buffer InputBuf    { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf  { float go[]; };
layout(binding = 2, std430) readonly buffer ParamsBuf   { float logits[]; };
layout(binding = 3, std430) writeonly buffer GradInBuf  { float gi[]; };
layout(binding = 4, std430) buffer GradParamsBuf        { uint grad_logits[]; };

// Канонический макрос атомарного сложения float через CAS.
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

// Базовые активации
float activation_value(uint k, float v) {
    if (k == 0u) return max(v, 0.0);
    if (k == 1u) { float s = 1.0 / (1.0 + exp(-1.702 * v)); return v * s; }
    if (k == 2u) { float s = 1.0 / (1.0 + exp(-v));        return v * s; }
    if (k == 3u) return tanh(v);
    return max(v, 0.0);
}

// Производные базовых активаций
float activation_derivative(uint k, float v) {
    if (k == 0u) return (v > 0.0) ? 1.0 : 0.0;
    if (k == 1u) { float s = 1.0 / (1.0 + exp(-1.702 * v)); return s + v * s * (1.0 - s) * 1.702; }
    if (k == 2u) { float s = 1.0 / (1.0 + exp(-v));        return s + v * s * (1.0 - s); }
    if (k == 3u) { float t = tanh(v); return 1.0 - t * t; }
    return (v > 0.0) ? 1.0 : 0.0;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    uint batch = pc.total / pc.features;
    uint c = idx / batch;

    float x_val = x[idx];
    float gout = go[idx];

    // Softmax логитов для признака c (численно устойчиво).
    float max_l = logits[0u * pc.features + c];
    for (uint k = 1u; k < pc.num_activations; ++k) {
        float l = logits[k * pc.features + c];
        if (l > max_l) max_l = l;
    }

    float sum_exp = 0.0;
    float w[4];
    for (uint k = 0u; k < pc.num_activations; ++k) {
        float e = exp(logits[k * pc.features + c] - max_l);
        w[k] = e;
        sum_exp += e;
    }
    for (uint k = 0u; k < pc.num_activations; ++k) {
        w[k] /= sum_exp;
    }

    // Пересчёт выхода (для градиентов по логитам).
    float y_val = 0.0;
    for (uint k = 0u; k < pc.num_activations; ++k) {
        y_val += w[k] * activation_value(k, x_val);
    }

    // Градиент по входу.
    float sum_der = 0.0;
    for (uint k = 0u; k < pc.num_activations; ++k) {
        sum_der += w[k] * activation_derivative(k, x_val);
    }
    gi[idx] = gout * sum_der;

    // Градиенты по логитам — атомарное накопление через канонический макрос.
    for (uint k = 0u; k < pc.num_activations; ++k) {
        float d_l = gout * (activation_value(k, x_val) - y_val) * w[k];
        uint param_idx = k * pc.features + c;
        ATOMIC_ADD_FLOAT(grad_logits[param_idx], d_l);
    }
}
