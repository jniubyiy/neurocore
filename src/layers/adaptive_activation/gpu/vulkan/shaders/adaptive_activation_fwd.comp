// src/layers/adaptive_activation/gpu/vulkan/shaders/adaptive_activation_fwd.comp
//
// Прямой проход AdaptivePerFeatureActivation на GPU (column-major).
//
// Раскладка активаций — column-major: x[c · batch + r].
// Логиты хранятся row-major по k: logits[k · features + c].
//
// Формула для каждого признака c:
//   w = softmax_k(logits[k, c])
//   y[c, r] = Σ_k w_k · activation_k(x[c, r])
//
// Поддерживается num_activations ∈ [2, 4] (см. CPU-версию).
//
// Push-константы: total, features, num_activations.
// Dispatch: batch · features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;            // batch · features
    uint features;         // количество признаков
    uint num_activations;  // количество базовых активаций (2..4)
} pc;

layout(binding = 0, std430) readonly buffer InputBuf  { float x[]; };
layout(binding = 1, std430) readonly buffer ParamsBuf { float logits[]; };
layout(binding = 2, std430) writeonly buffer OutputBuf { float y[]; };

// Базовые активации
float activation_value(uint k, float v) {
    if (k == 0u) return max(v, 0.0);                                      // ReLU
    if (k == 1u) { float s = 1.0 / (1.0 + exp(-1.702 * v)); return v * s; } // GELU
    if (k == 2u) { float s = 1.0 / (1.0 + exp(-v));        return v * s; }   // SiLU
    if (k == 3u) return tanh(v);                                          // Tanh
    return max(v, 0.0);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    // Column-major: idx = c · batch + r ⇒ c = idx / batch,
    // где batch = total / features.
    uint batch = pc.total / pc.features;
    uint c = idx / batch;

    float x_val = x[idx];

    // Softmax логитов для признака c (численно устойчиво).
    float max_l = logits[0u * pc.features + c];
    for (uint k = 1u; k < pc.num_activations; ++k) {
        float l = logits[k * pc.features + c];
        if (l > max_l) max_l = l;
    }

    float sum_exp = 0.0;
    float w[4];
    for (uint k = 0u; k < pc.num_activations; ++k) {
        float e = exp(logits[k * pc.features + c] - max_l);
        w[k] = e;
        sum_exp += e;
    }
    for (uint k = 0u; k < pc.num_activations; ++k) {
        w[k] /= sum_exp;
    }

    float y_val = 0.0;
    for (uint k = 0u; k < pc.num_activations; ++k) {
        y_val += w[k] * activation_value(k, x_val);
    }

    y[idx] = y_val;
}