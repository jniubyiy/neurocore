#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;          // batch * features
    uint features;       // количество признаков
    uint num_activations; // количество базовых активаций
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major: x[c * batch + r], но здесь просто линейный индекс по элементам
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float logits[]; // логиты: logits[k * features + c] для активации k и признака c
};

layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];
};

// Базовые активации
float activation_value(uint k, float v) {
    if (k == 0u) {
        return max(v, 0.0); // ReLU
    } else if (k == 1u) {
        // GELU (сигмоидальная аппроксимация)
        float sig = 1.0 / (1.0 + exp(-1.702 * v));
        return v * sig;
    } else if (k == 2u) {
        // SiLU / Swish
        float sig = 1.0 / (1.0 + exp(-v));
        return v * sig;
    } else if (k == 3u) {
        return tanh(v); // Tanh
    } else {
        return max(v, 0.0);
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    uint c = idx % pc.features; // индекс признака
    float x_val = x[idx];

    // Вычисляем softmax логитов для признака c
    // Максимальное количество активаций ограничено 4 в данной реализации,
    // но шейдер обрабатывает любое num_activations до 4.
    float max_l = logits[0 * pc.features + c];
    for (uint k = 1; k < pc.num_activations; ++k) {
        float l = logits[k * pc.features + c];
        if (l > max_l) max_l = l;
    }

    float sum_exp = 0.0;
    float w[4];
    for (uint k = 0; k < pc.num_activations; ++k) {
        float l = logits[k * pc.features + c];
        float e = exp(l - max_l);
        w[k] = e;
        sum_exp += e;
    }
    for (uint k = 0; k < pc.num_activations; ++k) {
        w[k] /= sum_exp;
    }

    // Вычисляем выход
    float y_val = 0.0;
    for (uint k = 0; k < pc.num_activations; ++k) {
        y_val += w[k] * activation_value(k, x_val);
    }

    y[idx] = y_val;
}