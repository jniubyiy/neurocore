#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;          // batch * features
    uint features;       // количество признаков
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];           // column-major: x[c * batch + r]
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[];      // [theta (features), T_raw (features)] — всего 2*features
};

layout(binding = 3, std430) readonly buffer MaskBuf {
    float mask[];        // бинарная маска z (0.0 или 1.0)
};

layout(binding = 4, std430) readonly buffer ArgBuf {
    float arg[];         // аргумент a = (|x| - theta) / T
};

layout(binding = 5, std430) writeonly buffer GradInBuf {
    float gi[];          // градиент по входу
};

layout(binding = 6, std430) buffer GradParamsBuf {
    uint grad_params[];  // битовое представление float для атомарного накопления
};

// Вспомогательная функция атомарного сложения float
void atomicAddFloat(inout uint target, float value) {
    uint expected = target;
    uint desired;
    do {
        float cur = uintBitsToFloat(expected);
        desired = floatBitsToUint(cur + value);
        uint old = atomicCompSwap(target, expected, desired);
        if (old == expected) return;
        expected = old;
    } while (true);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    uint batch = pc.total / pc.features;
    uint c = idx / batch; // индекс признака
    // uint r = idx % batch; // не требуется

    float theta = params[c];
    float T_raw = params[pc.features + c];
    float T = abs(T_raw) + 1e-6; // как в forward

    float x_val = x[idx];
    float go_val = go[idx];
    float z = mask[idx];
    float a = arg[idx];

    float p = 1.0 / (1.0 + exp(-a));
    float dsig = p * (1.0 - p);
    float p_plus_eps = p + 1e-6;
    float inv_p_plus_eps_sq = 1.0 / (p_plus_eps * p_plus_eps);

    // Градиент по входу
    gi[idx] = go_val * z / p_plus_eps;

    // Производная выхода по p: dy/dp = -x * z / (p + eps)^2
    float dy_dp = -x_val * z * inv_p_plus_eps_sq;

    // Производная p по theta: dp/dtheta = -dsig / T
    float dp_dtheta = -dsig / T;

    // Производная p по T: dp/dT = -dsig * a / T
    float dp_dT = -dsig * a / T;

    // Градиенты по параметрам
    float grad_theta_contrib = go_val * dy_dp * dp_dtheta;
    float grad_T_contrib = go_val * dy_dp * dp_dT;

    // Атомарно накапливаем
    atomicAddFloat(grad_params[c], grad_theta_contrib);
    atomicAddFloat(grad_params[pc.features + c], grad_T_contrib);
}