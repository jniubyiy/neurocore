#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;          // batch * features
    uint features;       // количество признаков
    uint seed;           // зерно для ГПСЧ
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];           // column-major: x[c * batch + r]
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[];      // [theta (features), T (features)] — всего 2*features
};

layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];           // column-major
};

layout(binding = 3, std430) writeonly buffer MaskBuf {
    float mask[];        // бинарная маска z (0.0 или 1.0)
};

layout(binding = 4, std430) writeonly buffer ArgBuf {
    float arg[];         // аргумент a = (|x| - theta) / T
};

// ------------------- Генератор псевдослучайных чисел (xorshift) -------------------
uint rng_state;

uint rand_xorshift() {
    uint x = rng_state;
    x ^= x << 13;
    x ^= x >> 17;
    x ^= x << 5;
    rng_state = x;
    return x;
}

// Возвращает случайное число в (0,1)
float u_rand() {
    uint val = rand_xorshift() & 0x00FFFFFFu; // 24 бита
    return (float(val) + 0.5) / float(0x01000000u); // примерно (0,1)
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    // Инициализация состояния ГПСЧ на основе seed и индекса
    rng_state = pc.seed + idx * 1664525u + 1013904223u;
    // Разогрев генератора
    for (int i = 0; i < 4; i++) {
        rand_xorshift();
    }

    // Определяем размер батча через total и features
    uint batch = pc.total / pc.features;
    uint c = idx / batch;  // признак
    // uint r = idx % batch; // пример (не используется)

    float theta = params[c];
    float T_raw = params[pc.features + c];
    float T = abs(T_raw) + 1e-6; // гарантируем положительность

    float x_val = x[idx];
    float abs_x = abs(x_val);
    float a = (abs_x - theta) / T;
    float p = 1.0 / (1.0 + exp(-a));

    // Генерация Bernoulli
    float u = u_rand();
    u = clamp(u, 1e-6, 1.0 - 1e-6);
    float z = (u < p) ? 1.0 : 0.0;

    float eps = 1e-6;
    y[idx] = x_val * z / (p + eps);
    mask[idx] = z;
    arg[idx] = a;
}