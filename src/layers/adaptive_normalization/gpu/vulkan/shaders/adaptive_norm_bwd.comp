#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

// Входной тензор
layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

// Градиент по выходу
layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

// Параметры слоя
layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[];   // 7 * features
};

// Градиент по входу
layout(binding = 3, std430) writeonly buffer GradInBuf {
    float gi[];
};

// Градиенты по параметрам (атомарное накопление)
layout(binding = 4, std430) buffer GradParamsBuf {
    uint grad_params[]; // битовое представление float
};

// Статистики (вычислены заранее)
layout(binding = 5, std430) readonly buffer RowMeanBuf {
    float row_mean[];
};

layout(binding = 6, std430) readonly buffer RowVarBuf {
    float row_var[];
};

layout(binding = 7, std430) readonly buffer RowRmsSqBuf {
    float row_rms_sq[];
};

layout(binding = 8, std430) readonly buffer ColMeanBuf {
    float col_mean[];
};

layout(binding = 9, std430) readonly buffer ColVarBuf {
    float col_var[];
};

// Макрос атомарного сложения float
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint c = idx / pc.batch;

    // Параметры для признака c
    float ln_gamma   = params[0 * pc.features + c];
    float ln_beta    = params[1 * pc.features + c];
    float rms_gamma  = params[2 * pc.features + c];
    float bn_gamma   = params[3 * pc.features + c];
    float bn_beta    = params[4 * pc.features + c];
    float logits_ln  = params[5 * pc.features + c];
    float logits_rms = params[6 * pc.features + c];
    // логит для BN фиксирован как 0

    float eps = 1e-5;

    // Статистики с добавлением eps
    float var_r    = max(row_var[r], 0.0) + eps;
    float rms_sq_r = max(row_rms_sq[r], 0.0) + eps;
    float var_c    = max(col_var[c], 0.0) + eps;

    float x_val = x[idx];
    float gout  = go[idx];

    // Вычисляем ветви нормализации (как в forward)
    float ln  = (x_val - row_mean[r]) / sqrt(var_r) * ln_gamma + ln_beta;
    float rms = x_val / sqrt(rms_sq_r) * rms_gamma;
    float bn  = (x_val - col_mean[c]) / sqrt(var_c) * bn_gamma + bn_beta;

    // Softmax логитов
    float max_l = max(logits_ln, max(logits_rms, 0.0));
    float e0 = exp(logits_ln - max_l);
    float e1 = exp(logits_rms - max_l);
    float e2 = exp(0.0 - max_l);
    float sum_exp = e0 + e1 + e2;
    float w_ln  = e0 / sum_exp;
    float w_rms = e1 / sum_exp;
    float w_bn  = e2 / sum_exp;

    float y_combined = w_ln * ln + w_rms * rms + w_bn * bn;

    // 1. Градиент по входу (без учёта влияния на статистики)
    float dln_dx  = ln_gamma  / sqrt(var_r);
    float drms_dx = rms_gamma / sqrt(rms_sq_r);
    float dbn_dx  = bn_gamma  / sqrt(var_c);
    float grad_x = gout * (w_ln * dln_dx + w_rms * drms_dx + w_bn * dbn_dx);
    gi[idx] = grad_x;

    // 2. Градиенты по параметрам нормализации (атомарно накапливаем)
    uint base_ln_gamma   = 0 * pc.features + c;
    uint base_ln_beta    = 1 * pc.features + c;
    uint base_rms_gamma  = 2 * pc.features + c;
    uint base_bn_gamma   = 3 * pc.features + c;
    uint base_bn_beta    = 4 * pc.features + c;
    uint base_logits_ln  = 5 * pc.features + c;
    uint base_logits_rms = 6 * pc.features + c;

    float d_ln_gamma  = gout * w_ln * (x_val - row_mean[r]) / sqrt(var_r);
    float d_ln_beta   = gout * w_ln;
    float d_rms_gamma = gout * w_rms * x_val / sqrt(rms_sq_r);
    float d_bn_gamma  = gout * w_bn * (x_val - col_mean[c]) / sqrt(var_c);
    float d_bn_beta   = gout * w_bn;

    ATOMIC_ADD_FLOAT(grad_params[base_ln_gamma],   d_ln_gamma);
    ATOMIC_ADD_FLOAT(grad_params[base_ln_beta],    d_ln_beta);
    ATOMIC_ADD_FLOAT(grad_params[base_rms_gamma],  d_rms_gamma);
    ATOMIC_ADD_FLOAT(grad_params[base_bn_gamma],   d_bn_gamma);
    ATOMIC_ADD_FLOAT(grad_params[base_bn_beta],    d_bn_beta);

    // 3. Градиенты по логитам
    float d_logits_ln  = gout * w_ln  * (ln  - y_combined);
    float d_logits_rms = gout * w_rms * (rms - y_combined);

    ATOMIC_ADD_FLOAT(grad_params[base_logits_ln],  d_logits_ln);
    ATOMIC_ADD_FLOAT(grad_params[base_logits_rms], d_logits_rms);
}