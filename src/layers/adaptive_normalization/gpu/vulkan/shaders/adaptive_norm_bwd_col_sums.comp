// src/layers/adaptive_normalization/gpu/vulkan/shaders/adaptive_norm_bwd_col_sums.comp
//
// Адаптивная нормализация: две суммы по столбцу c, используемые
// в формуле градиента по входу для BatchNorm.
//
//   sum_dbn_per_col[c]    = Σ_r dbn[c,r]
//   sum_dbn_x_per_col[c]  = Σ_r dbn[c,r] * (x[c,r] - col_mean[c])
//
// где dbn[c,r] = go[c,r] * w_bn[c].
//
// Один поток на столбец c. Цикл по r — линейный, O(B) на поток.
// Локальных массивов нет, ограничений нет.
//
// Push-константы: batch, features.
// Dispatch: features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf    { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf  { float go[]; };
layout(binding = 2, std430) readonly buffer WBnBuf      { float w_bn[]; };
layout(binding = 3, std430) readonly buffer ColMeanBuf  { float col_mean[]; };
layout(binding = 4, std430) writeonly buffer SumDbnBuf   { float sum_dbn_per_col[]; };
layout(binding = 5, std430) writeonly buffer SumDbnXBuf  { float sum_dbn_x_per_col[]; };

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.features) return;

    float mean = col_mean[c];
    float w    = w_bn[c];
    float s1 = 0.0;
    float s2 = 0.0;

    for (uint r = 0u; r < pc.batch; ++r) {
        uint idx = c * pc.batch + r;
        float x_val = x[idx];
        float dbn   = go[idx] * w;

        s1 += dbn;
        s2 += dbn * (x_val - mean);
    }

    sum_dbn_per_col[c]   = s1;
    sum_dbn_x_per_col[c] = s2;
}