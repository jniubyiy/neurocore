// src/layers/adaptive_normalization/gpu/vulkan/shaders/adaptive_norm_bwd_input.comp
//
// Адаптивная нормализация: градиент по входу.
//
// Один поток на элемент (c, r). Локальных массивов нет, ограничений нет.
//
// Формула:
//   gi[c,r] = term_ln + term_rms + term_bn,
// где
//   term_ln  = ln_gamma  * inv_std_ln  * ( dln  - sum_dln/ F
//                    - (x - row_mean) / (F * var_r)   * sum_dln_x )
//   term_rms = rms_gamma * inv_std_rms * ( drms - x / (F * rms_sq_r) * sum_drms_x )
//   term_bn  = bn_gamma  * inv_std_bn  * ( dbn  - sum_dbn/ B
//                    - (x - col_mean) / (B * var_c)   * sum_dbn_x )
//
// с dln = go·w_ln, drms = go·w_rms, dbn = go·w_bn.
//
// Push-константы: batch, features.
// Dispatch: batch * features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0,  std430) readonly buffer InputBuf     { float x[]; };
layout(binding = 1,  std430) readonly buffer GradOutBuf   { float go[]; };
layout(binding = 2,  std430) readonly buffer ParamsBuf    { float params[]; };
layout(binding = 3,  std430) readonly buffer RowMeanBuf   { float row_mean[]; };
layout(binding = 4,  std430) readonly buffer RowVarBuf    { float row_var[]; };
layout(binding = 5,  std430) readonly buffer RowRmsSqBuf  { float row_rms_sq[]; };
layout(binding = 6,  std430) readonly buffer ColMeanBuf   { float col_mean[]; };
layout(binding = 7,  std430) readonly buffer ColVarBuf    { float col_var[]; };
layout(binding = 8,  std430) readonly buffer WLnBuf       { float w_ln[]; };
layout(binding = 9,  std430) readonly buffer WRmsBuf      { float w_rms[]; };
layout(binding = 10, std430) readonly buffer WBnBuf       { float w_bn[]; };
layout(binding = 11, std430) readonly buffer SumDlnBuf    { float sum_dln_per_row[]; };
layout(binding = 12, std430) readonly buffer SumDlnXBuf   { float sum_dln_x_per_row[]; };
layout(binding = 13, std430) readonly buffer SumDrmsXBuf  { float sum_drms_x_per_row[]; };
layout(binding = 14, std430) readonly buffer SumDbnBuf    { float sum_dbn_per_col[]; };
layout(binding = 15, std430) readonly buffer SumDbnXBuf   { float sum_dbn_x_per_col[]; };
layout(binding = 16, std430) writeonly buffer GradInBuf   { float gi[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.features;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint c = idx / pc.batch;

    float eps = 1e-5;

    float ln_gamma  = params[0u * pc.features + c];
    float rms_gamma = params[2u * pc.features + c];
    float bn_gamma  = params[3u * pc.features + c];

    float mean_r    = row_mean[r];
    float var_r     = max(row_var[r], 0.0) + eps;
    float rms_sq_r  = max(row_rms_sq[r], 0.0) + eps;
    float mean_c    = col_mean[c];
    float var_c     = max(col_var[c], 0.0) + eps;

    float x_val = x[idx];
    float gout  = go[idx];

    float dln  = gout * w_ln[c];
    float drms = gout * w_rms[c];
    float dbn  = gout * w_bn[c];

    float inv_std_ln  = 1.0 / sqrt(var_r);
    float inv_std_rms = 1.0 / sqrt(rms_sq_r);
    float inv_std_bn  = 1.0 / sqrt(var_c);

    float F = float(pc.features);
    float B = float(pc.batch);

    float term_ln = ln_gamma * inv_std_ln * (
        dln
        - sum_dln_per_row[r] / F
        - (x_val - mean_r) / (F * var_r) * sum_dln_x_per_row[r]
    );

    float term_rms = rms_gamma * inv_std_rms * (
        drms
        - (x_val / (F * rms_sq_r)) * sum_drms_x_per_row[r]
    );

    float term_bn = bn_gamma * inv_std_bn * (
        dbn
        - sum_dbn_per_col[c] / B
        - (x_val - mean_c) / (B * var_c) * sum_dbn_x_per_col[c]
    );

    gi[idx] = term_ln + term_rms + term_bn;
}