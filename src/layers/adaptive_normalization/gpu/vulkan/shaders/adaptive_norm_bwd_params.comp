// src/layers/adaptive_normalization/gpu/vulkan/shaders/adaptive_norm_bwd_params.comp
//
// Адаптивная нормализация: градиенты по параметрам.
//
// Один поток на признак c. Внутри — линейный цикл по батчу r.
// Запись идёт в 7 отдельных позиций без атомики: каждый индекс
// (bias) пишется ровно одним потоком.
//
//   grad_ln_gamma[c]   = Σ_r dln  * (x - row_mean) * inv_std_ln
//   grad_ln_beta[c]    = Σ_r dln
//   grad_rms_gamma[c]  = Σ_r drms * x * inv_std_rms
//   grad_bn_gamma[c]   = Σ_r dbn  * (x - col_mean) * inv_std_bn
//   grad_bn_beta[c]    = Σ_r dbn
//   grad_logits_ln[c]  = Σ_r go * w_ln  * (ln  - y_combined)
//   grad_logits_rms[c] = Σ_r go * w_rms * (rms - y_combined)
//
// Push-константы: batch, features.
// Dispatch: features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf     { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf   { float go[]; };
layout(binding = 2, std430) readonly buffer ParamsBuf    { float params[]; };
layout(binding = 3, std430) readonly buffer RowMeanBuf   { float row_mean[]; };
layout(binding = 4, std430) readonly buffer RowVarBuf    { float row_var[]; };
layout(binding = 5, std430) readonly buffer RowRmsSqBuf  { float row_rms_sq[]; };
layout(binding = 6, std430) readonly buffer ColMeanBuf   { float col_mean[]; };
layout(binding = 7, std430) readonly buffer ColVarBuf    { float col_var[]; };
layout(binding = 8, std430) readonly buffer WLnBuf       { float w_ln[]; };
layout(binding = 9, std430) readonly buffer WRmsBuf      { float w_rms[]; };
layout(binding = 10, std430) readonly buffer WBnBuf      { float w_bn[]; };
layout(binding = 11, std430) writeonly buffer GradParamsBuf { float grad_params[]; };

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.features) return;

    float eps = 1e-5;
    uint  f   = pc.features;

    float ln_gamma  = params[0u * f + c];
    float ln_beta   = params[1u * f + c];
    float rms_gamma = params[2u * f + c];
    float bn_gamma  = params[3u * f + c];
    float bn_beta   = params[4u * f + c];

    float w_ln_c  = w_ln[c];
    float w_rms_c = w_rms[c];
    float w_bn_c  = w_bn[c];

    float mean_c = col_mean[c];
    float var_c  = max(col_var[c], 0.0) + eps;
    float inv_std_bn = 1.0 / sqrt(var_c);

    float g_gamma_ln    = 0.0;
    float g_beta_ln     = 0.0;
    float g_gamma_rms   = 0.0;
    float g_gamma_bn    = 0.0;
    float g_beta_bn     = 0.0;
    float g_logits_ln   = 0.0;
    float g_logits_rms  = 0.0;

    for (uint r = 0u; r < pc.batch; ++r) {
        uint idx = c * pc.batch + r;
        float x_val = x[idx];
        float gout  = go[idx];

        float mean_r   = row_mean[r];
        float var_r    = max(row_var[r], 0.0) + eps;
        float rms_sq_r = max(row_rms_sq[r], 0.0) + eps;

        float inv_std_ln  = 1.0 / sqrt(var_r);
        float inv_std_rms = 1.0 / sqrt(rms_sq_r);

        float ln_val  = (x_val - mean_r) * inv_std_ln  * ln_gamma  + ln_beta;
        float rms_val = x_val            * inv_std_rms * rms_gamma;
        float bn_val  = (x_val - mean_c) * inv_std_bn  * bn_gamma  + bn_beta;

        float y_val = w_ln_c * ln_val + w_rms_c * rms_val + w_bn_c * bn_val;

        float dln  = gout * w_ln_c;
        float drms = gout * w_rms_c;
        float dbn  = gout * w_bn_c;

        g_gamma_ln   += dln  * (x_val - mean_r) * inv_std_ln;
        g_beta_ln    += dln;
        g_gamma_rms  += drms * x_val * inv_std_rms;
        g_gamma_bn   += dbn  * (x_val - mean_c) * inv_std_bn;
        g_beta_bn    += dbn;
        g_logits_ln  += gout * w_ln_c  * (ln_val  - y_val);
        g_logits_rms += gout * w_rms_c * (rms_val - y_val);
    }

    grad_params[0u * f + c] = g_gamma_ln;
    grad_params[1u * f + c] = g_beta_ln;
    grad_params[2u * f + c] = g_gamma_rms;
    grad_params[3u * f + c] = g_gamma_bn;
    grad_params[4u * f + c] = g_beta_bn;
    grad_params[5u * f + c] = g_logits_ln;
    grad_params[6u * f + c] = g_logits_rms;
}