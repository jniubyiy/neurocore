// src/layers/adaptive_normalization/gpu/vulkan/shaders/adaptive_norm_bwd_row_sums.comp
//
// Адаптивная нормализация: три суммы по строке r, используемые
// в формуле градиента по входу для LayerNorm и RMSNorm.
//
//   sum_dln_per_row[r]     = Σ_c dln[c,r]
//   sum_dln_x_per_row[r]   = Σ_c dln[c,r] * (x[c,r] - row_mean[r])
//   sum_drms_x_per_row[r]  = Σ_c drms[c,r] * x[c,r]
//
// где dln[c,r] = go[c,r] * w_ln[c], drms[c,r] = go[c,r] * w_rms[c].
//
// Один поток на строку r. Цикл по c — линейный, O(F) на поток.
// Локальных массивов нет, ограничений нет.
//
// Push-константы: batch, features.
// Dispatch: batch потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf      { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf    { float go[]; };
layout(binding = 2, std430) readonly buffer WLnBuf        { float w_ln[]; };
layout(binding = 3, std430) readonly buffer WRmsBuf       { float w_rms[]; };
layout(binding = 4, std430) readonly buffer RowMeanBuf    { float row_mean[]; };
layout(binding = 5, std430) writeonly buffer SumDlnBuf    { float sum_dln_per_row[]; };
layout(binding = 6, std430) writeonly buffer SumDlnXBuf   { float sum_dln_x_per_row[]; };
layout(binding = 7, std430) writeonly buffer SumDrmsXBuf  { float sum_drms_x_per_row[]; };

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.batch) return;

    float mean = row_mean[r];
    float s1 = 0.0;
    float s2 = 0.0;
    float s3 = 0.0;

    for (uint c = 0u; c < pc.features; ++c) {
        uint idx = c * pc.batch + r;
        float x_val = x[idx];
        float gout  = go[idx];

        float dln  = gout * w_ln[c];
        float drms = gout * w_rms[c];

        s1 += dln;
        s2 += dln * (x_val - mean);
        s3 += drms * x_val;
    }

    sum_dln_per_row[r]    = s1;
    sum_dln_x_per_row[r]  = s2;
    sum_drms_x_per_row[r] = s3;
}