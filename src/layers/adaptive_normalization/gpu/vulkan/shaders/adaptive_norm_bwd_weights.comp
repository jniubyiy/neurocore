// src/layers/adaptive_normalization/gpu/vulkan/shaders/adaptive_norm_bwd_weights.comp
//
// Адаптивная нормализация: вычисление весов softmax для каждой колонки c.
//
// Используется в обратном проходе как общий этап: w_ln, w_rms, w_bn
// зависят только от признака c (через логиты ln и rms; логит bn = 0).
// Сохраняются в отдельные буферы, чтобы избежать пересчёта softmax
// в каждом последующем шейдере.
//
// Один поток на признак c. Локальных массивов нет, ограничений нет.
//
// Раскладка params — плоский блок (7 * features):
//   [0*f)   ln_gamma
//   [1*f)   ln_beta
//   [2*f)   rms_gamma
//   [3*f)   bn_gamma
//   [4*f)   bn_beta
//   [5*f)   logits_ln
//   [6*f)   logits_rms
//
// Push-константы: features.
// Dispatch: features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer ParamsBuf { float params[]; };
layout(binding = 1, std430) writeonly buffer WLnBuf   { float w_ln[]; };
layout(binding = 2, std430) writeonly buffer WRmsBuf  { float w_rms[]; };
layout(binding = 3, std430) writeonly buffer WBnBuf   { float w_bn[]; };

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.features) return;

    float logit_ln  = params[5u * pc.features + c];
    float logit_rms = params[6u * pc.features + c];
    float logit_bn  = 0.0;

    float max_l = max(logit_ln, max(logit_rms, logit_bn));
    float e0 = exp(logit_ln  - max_l);
    float e1 = exp(logit_rms - max_l);
    float e2 = exp(logit_bn  - max_l);
    float sum_exp = e0 + e1 + e2;

    w_ln[c]  = e0 / sum_exp;
    w_rms[c] = e1 / sum_exp;
    w_bn[c]  = e2 / sum_exp;
}