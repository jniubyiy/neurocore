#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;      // количество строк (примеров)
    uint features;   // количество признаков
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];        // column-major: x[c * batch + r]
};

layout(binding = 1, std430) writeonly buffer OutputBuf {
    float y[];        // column-major: y[c * batch + r]
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[];   // 7 * features элементов:
                      // [0..f)          ln_gamma
                      // [f..2f)         ln_beta
                      // [2f..3f)        rms_gamma
                      // [3f..4f)        bn_gamma
                      // [4f..5f)        bn_beta
                      // [5f..6f)        logits_ln
                      // [6f..7f)        logits_rms
};

layout(binding = 3, std430) readonly buffer RowMeanBuf {
    float row_mean[];    // размер batch
};

layout(binding = 4, std430) readonly buffer RowVarBuf {
    float row_var[];     // размер batch
};

layout(binding = 5, std430) readonly buffer RowRmsSqBuf {
    float row_rms_sq[];  // размер batch (среднее квадратов)
};

layout(binding = 6, std430) readonly buffer ColMeanBuf {
    float col_mean[];    // размер features
};

layout(binding = 7, std430) readonly buffer ColVarBuf {
    float col_var[];     // размер features
};

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch; // номер примера
    uint c = idx / pc.batch; // номер признака

    // Читаем параметры для признака c
    float ln_gamma   = params[0 * pc.features + c];
    float ln_beta    = params[1 * pc.features + c];
    float rms_gamma  = params[2 * pc.features + c];
    float bn_gamma   = params[3 * pc.features + c];
    float bn_beta    = params[4 * pc.features + c];
    float logits_ln  = params[5 * pc.features + c];
    float logits_rms = params[6 * pc.features + c];
    // логит для BatchNorm фиксирован и равен 0

    float eps = 1e-5;

    // Статистики
    float mean_r     = row_mean[r];
    float var_r      = max(row_var[r], 0.0) + eps;        // для LayerNorm
    float rms_sq_r   = max(row_rms_sq[r], 0.0) + eps;     // для RMSNorm
    float mean_c     = col_mean[c];
    float var_c      = max(col_var[c], 0.0) + eps;        // для BatchNorm

    float x_val = x[idx];

    // Вычисляем каждую ветвь нормализации
    float ln  = (x_val - mean_r) / sqrt(var_r) * ln_gamma + ln_beta;
    float rms = x_val / sqrt(rms_sq_r) * rms_gamma;
    float bn  = (x_val - mean_c) / sqrt(var_c) * bn_gamma + bn_beta;

    // Устойчивый softmax для логитов (ln, rms, bn=0)
    float max_l = max(logits_ln, max(logits_rms, 0.0));
    float e0 = exp(logits_ln - max_l);
    float e1 = exp(logits_rms - max_l);
    float e2 = exp(0.0 - max_l);
    float sum_exp = e0 + e1 + e2;

    float w_ln  = e0 / sum_exp;
    float w_rms = e1 / sum_exp;
    float w_bn  = e2 / sum_exp;

    // Итоговый выход
    y[idx] = w_ln * ln + w_rms * rms + w_bn * bn;
}