#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major: x[c * batch + r]
};

layout(binding = 1, std430) writeonly buffer RowMeanBuf {
    float row_mean[];
};

layout(binding = 2, std430) writeonly buffer RowVarBuf {
    float row_var[];
};

layout(binding = 3, std430) writeonly buffer RowRmsSqBuf {
    float row_rms_sq[];
};

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.batch) return;

    float sum = 0.0;
    float sum_sq = 0.0;
    for (uint c = 0; c < pc.features; c++) {
        float val = x[c * pc.batch + r];
        sum += val;
        sum_sq += val * val;
    }
    float mean = sum / float(pc.features);
    float mean_sq = sum_sq / float(pc.features);
    float var = mean_sq - mean * mean;
    var = max(var, 0.0); // избегаем отрицательных значений из-за округления

    row_mean[r] = mean;
    row_var[r] = var;
    row_rms_sq[r] = mean_sq;
}