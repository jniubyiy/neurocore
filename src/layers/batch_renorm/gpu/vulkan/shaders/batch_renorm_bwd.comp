#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[]; // [gamma; beta; r; d] для каждого признака (всего 4*features)
};

layout(binding = 3, std430) readonly buffer ColMeanBuf {
    float col_mean[];
};

layout(binding = 4, std430) readonly buffer ColVarBuf {
    float col_var[];
};

layout(binding = 5, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 6, std430) buffer GradParamsBuf {
    uint grad_params[]; // битовое представление float, размер 4*features
};

// Вспомогательная функция атомарного сложения float
void atomicAddFloat(inout uint target, float value) {
    uint expected = target;
    uint desired;
    do {
        float cur = uintBitsToFloat(expected);
        desired = floatBitsToUint(cur + value);
        uint old = atomicCompSwap(target, expected, desired);
        if (old == expected) return;
        expected = old;
    } while (true);
}

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint c = idx / pc.batch;

    float gamma = params[0 * pc.features + c];
    float beta  = params[1 * pc.features + c];
    float r_par = params[2 * pc.features + c];
    float d_par = params[3 * pc.features + c];

    float mean = col_mean[c];
    float var  = max(col_var[c], 0.0) + 1e-5;
    float inv_std = inversesqrt(var);

    float x_val = x[idx];
    float gout  = go[idx];
    float x_hat = (x_val - mean) * inv_std;

    // Градиент по входу (упрощённо, без учёта влияния на статистики)
    gi[idx] = gout * gamma * r_par * inv_std;

    // Накопление градиентов по параметрам
    float d_gamma = gout * (x_hat * r_par + d_par);
    float d_beta  = gout;
    float d_r     = gout * gamma * x_hat;
    float d_d     = gout * gamma;

    atomicAddFloat(grad_params[0 * pc.features + c], d_gamma);
    atomicAddFloat(grad_params[1 * pc.features + c], d_beta);
    atomicAddFloat(grad_params[2 * pc.features + c], d_r);
    atomicAddFloat(grad_params[3 * pc.features + c], d_d);
}