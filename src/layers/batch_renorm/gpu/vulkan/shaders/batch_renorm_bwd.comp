#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[];
};

layout(binding = 3, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 4, std430) buffer GradParamsBuf {
    uint grad_params[]; // битовое представление float
};

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint c = idx / pc.batch;
    uint r = idx % pc.batch;

    float gamma = params[0 * pc.features + c];
    float beta  = params[1 * pc.features + c];
    float r_par = params[2 * pc.features + c];
    float d_par = params[3 * pc.features + c];

    // Заглушка
    float mean = 0.0;
    float std = 1.0;

    float x_hat = (x[idx] - mean) / std;
    float gout = go[idx];

    // Градиент по входу
    gi[idx] = gout * gamma * r_par / std;

    // Градиенты по параметрам (атомарное накопление)
    // gamma
    {
        float inc = gout * (x_hat * r_par + d_par);
        uint expected = grad_params[0 * pc.features + c];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_params[0 * pc.features + c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
    // beta
    {
        float inc = gout;
        uint expected = grad_params[1 * pc.features + c];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_params[1 * pc.features + c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
    // r
    {
        float inc = gout * gamma * x_hat;
        uint expected = grad_params[2 * pc.features + c];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_params[2 * pc.features + c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
    // d
    {
        float inc = gout * gamma;
        uint expected = grad_params[3 * pc.features + c];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_params[3 * pc.features + c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
}