// src/layers/batch_renorm/gpu/vulkan/shaders/batch_renorm_bwd.comp
//
// Основной backward-шейдер BatchRenorm1d.
//
// Реализует каноническую BN-формулу для градиента по входу, согласованную
// с CPU-реализацией (`src/layers/batch_renorm/cpu/mod.rs`):
//
//   gi[r,c] = (γ[c]·r[c]/σ) · [ gout[r,c]
//                             − (1/(n·σ))·sum_gamma_r[c]
//                             − x_hat[r,c]·(1/(n·σ))·sum_gamma_r_xhat[c] ]
//
// где σ = sqrt(var[c] + eps), а суммы sum_gamma_r и sum_gamma_r_xhat
// посчитаны в отдельном шейдере `batch_renorm_bwd_sums.comp`.
//
// Градиенты по параметрам (накопление атомарное, CAS-loop):
//
//   grad_γ[c] += gout · (x_hat·r + d)
//   grad_β[c] += gout
//   grad_r[c] += gout · γ · x_hat
//   grad_d[c] += gout · γ
//
// Один поток на элемент (r, c). Dispatch: batch · features потоков.
//
// Раскладка активаций — column-major: x[c * batch + r].
//
// Push-константы: batch, features.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[]; // [γ; β; r; d] для каждого признака
};

layout(binding = 3, std430) readonly buffer ColMeanBuf {
    float col_mean[];
};

layout(binding = 4, std430) readonly buffer ColVarBuf {
    float col_var[];
};

layout(binding = 5, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 6, std430) buffer GradParamsBuf {
    uint grad_params[]; // битовое представление float
};

layout(binding = 7, std430) readonly buffer SumGammaRBuf {
    float sum_gamma_r[];
};

layout(binding = 8, std430) readonly buffer SumGammaRXhatBuf {
    float sum_gamma_r_xhat[];
};

// Макрос атомарного сложения float через CAS.
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint c = idx / pc.batch;

    float gamma = params[0u * pc.features + c];
    float r_par = params[2u * pc.features + c];
    float d_par = params[3u * pc.features + c];

    float mean = col_mean[c];
    float var  = max(col_var[c], 0.0) + 1e-5;
    float sigma   = sqrt(var);
    float inv_std = 1.0 / sigma;

    float x_val = x[idx];
    float gout  = go[idx];
    float x_hat = (x_val - mean) * inv_std;

    // ============ Градиент по входу ============
    //
    // Каноническая BN-формула:
    //   gi = (γ·r/σ)·[ g − mean(g) − x̂·mean(g·x̂) ]
    //
    // где mean(g) и mean(g·x̂) раскрыты через сохранённые суммы:
    //   mean(g)      = sum_gamma_r      / (n·σ)
    //   mean(g·x̂)   = sum_gamma_r_xhat / (n·σ)
    float n = float(pc.batch);
    float sgr  = sum_gamma_r[c];
    float sgrx = sum_gamma_r_xhat[c];

    float term1 = gout * gamma * r_par * inv_std;
    float term2 = sgr  / (n * sigma);
    float term3 = x_hat * sgrx / (n * sigma);

    gi[idx] = term1 - term2 - term3;

    // ============ Градиенты по параметрам ============
    float d_gamma = gout * (x_hat * r_par + d_par);
    float d_beta  = gout;
    float d_r     = gout * gamma * x_hat;
    float d_d     = gout * gamma;

    ATOMIC_ADD_FLOAT(grad_params[0u * pc.features + c], d_gamma);
    ATOMIC_ADD_FLOAT(grad_params[1u * pc.features + c], d_beta);
    ATOMIC_ADD_FLOAT(grad_params[2u * pc.features + c], d_r);
    ATOMIC_ADD_FLOAT(grad_params[3u * pc.features + c], d_d);
}