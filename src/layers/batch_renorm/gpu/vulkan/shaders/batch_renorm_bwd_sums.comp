// src/layers/batch_renorm/gpu/vulkan/shaders/batch_renorm_bwd_sums.comp
//
// Промежуточный проход backward для BatchRenorm1d.
//
// Для каждого признака c считает две суммы по батчу:
//   sum_gamma_r[c]      = Σ_r gout[r,c] · γ[c] · r[c]
//   sum_gamma_r_xhat[c] = Σ_r gout[r,c] · γ[c] · r[c] · x_hat[r,c]
//
// где x_hat[r,c] = (x[r,c] − mean[c]) / sqrt(var[c] + eps).
//
// Эти суммы используются в основном backward-шейдере для канонической
// формулы градиента по входу:
//
//   gi[r,c] = (γ[c]·r[c]/σ) · [ gout[r,c]
//                             − (1/(n·σ))·sum_gamma_r[c]
//                             − x_hat[r,c]·(1/(n·σ))·sum_gamma_r_xhat[c] ]
//
// Один поток на признак c. Внутри — линейный цикл по batch.
// Порядок суммирования фиксирован (r = 0..batch), что совпадает с CPU-версией.
//
// Раскладка активаций — column-major: x[c * batch + r].
//
// Push-константы: batch, features.
// Dispatch: features потоков.
// Выход: два буфера по features элементов (float).

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer GradOutBuf {
    float go[];         // column-major: go[c * batch + r]
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[];     // [γ; β; r; d], каждый вектор длины features
};

layout(binding = 2, std430) readonly buffer InputBuf {
    float x[];          // column-major: x[c * batch + r]
};

layout(binding = 3, std430) readonly buffer ColMeanBuf {
    float col_mean[];   // длина features
};

layout(binding = 4, std430) readonly buffer ColVarBuf {
    float col_var[];    // длина features
};

layout(binding = 5, std430) writeonly buffer SumGammaRBuf {
    float sum_gamma_r[];        // длина features
};

layout(binding = 6, std430) writeonly buffer SumGammaRXhatBuf {
    float sum_gamma_r_xhat[];   // длина features
};

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.features) return;

    float gamma = params[0u * pc.features + c];
    float r_par = params[2u * pc.features + c];

    float mean = col_mean[c];
    float var  = max(col_var[c], 0.0) + 1e-5;
    float inv_std = inversesqrt(var);

    float s1 = 0.0;
    float s2 = 0.0;
    for (uint r = 0u; r < pc.batch; ++r) {
        uint idx = c * pc.batch + r;
        float gout  = go[idx];
        float x_val = x[idx];
        float x_hat = (x_val - mean) * inv_std;

        float gy = gout * gamma * r_par;
        s1 += gy;
        s2 += gy * x_hat;
    }

    sum_gamma_r[c]      = s1;
    sum_gamma_r_xhat[c] = s2;
}