#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major: x[c * batch + r]
};

layout(binding = 1, std430) writeonly buffer ColMeanBuf {
    float col_mean[];   // размер features
};

layout(binding = 2, std430) writeonly buffer ColVarBuf {
    float col_var[];    // размер features
};

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.features) return;

    float sum = 0.0;
    float sum_sq = 0.0;
    for (uint r = 0; r < pc.batch; r++) {
        float val = x[c * pc.batch + r];
        sum += val;
        sum_sq += val * val;
    }
    float mean = sum / float(pc.batch);
    float mean_sq = sum_sq / float(pc.batch);
    float var = mean_sq - mean * mean;
    var = max(var, 0.0); // численная стабильность

    col_mean[c] = mean;
    col_var[c] = var;
}