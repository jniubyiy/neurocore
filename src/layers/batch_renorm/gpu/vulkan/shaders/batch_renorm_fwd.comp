#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[]; // [gamma; beta; r; d]
};

layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];
};

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint c = idx / pc.batch; // feature
    uint r = idx % pc.batch; // sample

    // Параметры для этого признака
    float gamma = params[0 * pc.features + c];
    float beta  = params[1 * pc.features + c];
    float r_par = params[2 * pc.features + c];
    float d_par = params[3 * pc.features + c];

    // Вычисляем среднее и дисперсию для признака c по всему батчу.
    // Для этого каждая нить должна вычислить сумму, но проще сделать это
    // в отдельном проходе. Здесь мы используем упрощённый вариант:
    // предполагаем, что статистики уже известны (не реализовано).
    // В реальности нужен отдельный буфер статистик.
    // Для демонстрации используем фиктивные значения (0 и 1).
    float mean = 0.0; // заглушка
    float std = 1.0;  // заглушка

    float x_hat = (x[idx] - mean) / std;
    float renorm = x_hat * r_par + d_par;
    y[idx] = renorm * gamma + beta;
}