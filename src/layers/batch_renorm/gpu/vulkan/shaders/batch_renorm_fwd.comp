#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major: x[c * batch + r]
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[]; // [gamma; beta; r; d] для каждого признака (всего 4*features)
};

layout(binding = 2, std430) readonly buffer ColMeanBuf {
    float col_mean[];   // длина features
};

layout(binding = 3, std430) readonly buffer ColVarBuf {
    float col_var[];    // длина features
};

layout(binding = 4, std430) writeonly buffer OutputBuf {
    float y[];          // column-major: y[c * batch + r]
};

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint c = idx / pc.batch;

    // Параметры для признака c
    float gamma = params[0 * pc.features + c];
    float beta  = params[1 * pc.features + c];
    float r_par = params[2 * pc.features + c];
    float d_par = params[3 * pc.features + c];

    float mean = col_mean[c];
    float var  = max(col_var[c], 0.0) + 1e-5;  // eps = 1e-5 (как в CPU-версии)

    float x_val = x[idx];
    float inv_std = inversesqrt(var);
    float x_hat = (x_val - mean) * inv_std;

    float y_val = x_hat * r_par * gamma + d_par * gamma + beta;
    y[idx] = y_val;
}