#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;
    uint m;
} pc;

layout(binding = 0, std430) readonly buffer DOut {
    float dout[];
};

layout(binding = 1, std430) readonly buffer Pre {
    float pre[];
};

layout(binding = 2, std430) readonly buffer A {
    float a[];
};

layout(binding = 3, std430) readonly buffer B {
    float b[];
};

layout(binding = 4, std430) readonly buffer Wa {
    float wa[];
};

layout(binding = 5, std430) readonly buffer Wb {
    float wb[];
};

layout(binding = 6, std430) writeonly buffer DA {
    float da[];
};

layout(binding = 7, std430) writeonly buffer DB {
    float db[];
};

layout(binding = 8, std430) buffer DWa {
    uint dwa[];  // битовое представление float
};

layout(binding = 9, std430) buffer DWb {
    uint dwb[];  // битовое представление float
};

layout(binding = 10, std430) buffer DBias {
    uint dbias[]; // битовое представление float
};

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.batch) return;

    // Вычисляем градиенты по входам da и db
    for (uint k = 0; k < pc.n; ++k) {
        float da_sum = 0.0;
        float db_sum = 0.0;
        for (uint j = 0; j < pc.m; ++j) {
            float dpre = (pre[row * pc.m + j] > 0.0) ? dout[row * pc.m + j] : 0.0;
            da_sum += dpre * wa[j * pc.n + k];
            db_sum += dpre * wb[j * pc.n + k];
        }
        da[row * pc.n + k] = da_sum;
        db[row * pc.n + k] = db_sum;
    }

    // Атомарно накапливаем градиенты весов и смещений
    for (uint j = 0; j < pc.m; ++j) {
        float dpre = (pre[row * pc.m + j] > 0.0) ? dout[row * pc.m + j] : 0.0;

        // dbias[j] += dpre
        {
            uint expected = dbias[j];
            uint desired;
            do {
                float cur = uintBitsToFloat(expected);
                desired = floatBitsToUint(cur + dpre);
                uint old = atomicCompSwap(dbias[j], expected, desired);
                if (old == expected) break;
                expected = old;
            } while (true);
        }

        // dWa[j, k] += dpre * a[row, k]
        for (uint k = 0; k < pc.n; ++k) {
            float inc = dpre * a[row * pc.n + k];
            uint idx = j * pc.n + k;
            uint expected = dwa[idx];
            uint desired;
            do {
                float cur = uintBitsToFloat(expected);
                desired = floatBitsToUint(cur + inc);
                uint old = atomicCompSwap(dwa[idx], expected, desired);
                if (old == expected) break;
                expected = old;
            } while (true);
        }

        // dWb[j, k] += dpre * b[row, k]
        for (uint k = 0; k < pc.n; ++k) {
            float inc = dpre * b[row * pc.n + k];
            uint idx = j * pc.n + k;
            uint expected = dwb[idx];
            uint desired;
            do {
                float cur = uintBitsToFloat(expected);
                desired = floatBitsToUint(cur + inc);
                uint old = atomicCompSwap(dwb[idx], expected, desired);
                if (old == expected) break;
                expected = old;
            } while (true);
        }
    }
}