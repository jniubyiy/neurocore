// src/layers/combiner/gpu/vulkan/shaders/combiner_bwd_dx.comp
//
// Обратный проход Combiner: градиенты по входам a и b.
//
// Один поток на элемент (r, c). Цикл по k — линейный.
//
//   da[c, r] = Σ_k d_pre[k, r] · wa[k, c]
//   db[c, r] = Σ_k d_pre[k, r] · wb[k, c]
//   где d_pre[k, r] = (pre[k,r] > 0) ? dout[k,r] : 0
//
// Push-константы: batch, n, m.
// Dispatch: batch · n потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;
    uint m;
} pc;

layout(binding = 0, std430) readonly buffer DOutBuf { float dout[]; };
layout(binding = 1, std430) readonly buffer PreBuf  { float pre[]; };
layout(binding = 2, std430) readonly buffer WaBuf   { float wa[]; };
layout(binding = 3, std430) readonly buffer WbBuf   { float wb[]; };
layout(binding = 4, std430) writeonly buffer DaBuf  { float da[]; };
layout(binding = 5, std430) writeonly buffer DbBuf  { float db[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.batch * pc.n) return;

    uint r = gid % pc.batch;
    uint c = gid / pc.batch;

    float sum_a = 0.0;
    float sum_b = 0.0;
    for (uint k = 0u; k < pc.m; ++k) {
        float pre_val = pre[k * pc.batch + r];
        float d_pre = (pre_val > 0.0) ? dout[k * pc.batch + r] : 0.0;
        sum_a += d_pre * wa[k * pc.n + c];
        sum_b += d_pre * wb[k * pc.n + c];
    }
    da[c * pc.batch + r] = sum_a;
    db[c * pc.batch + r] = sum_b;
}