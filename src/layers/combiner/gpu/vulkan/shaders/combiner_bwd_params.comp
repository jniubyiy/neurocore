// src/layers/combiner/gpu/vulkan/shaders/combiner_bwd_params.comp
//
// Обратный проход Combiner: градиенты по wa, wb, bias.
//
// Один поток на параметр.
//   [0, m·n)          — grad_wa[j·n + k]
//   [m·n, 2·m·n)      — grad_wb[j·n + k]
//   [2·m·n, 2·m·n+m)  — grad_bias[j]
//
// Прямая запись — каждый индекс пишется ровно один раз, атомика не нужна.
//
// Push-константы: batch, n, m.
// Dispatch: 2·m·n + m потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;
    uint m;
} pc;

layout(binding = 0, std430) readonly buffer ABuf     { float a[]; };
layout(binding = 1, std430) readonly buffer BBuf     { float b[]; };
layout(binding = 2, std430) readonly buffer DOutBuf  { float dout[]; };
layout(binding = 3, std430) readonly buffer PreBuf   { float pre[]; };
layout(binding = 4, std430) writeonly buffer DWaBuf   { float d_wa[]; };
layout(binding = 5, std430) writeonly buffer DWbBuf   { float d_wb[]; };
layout(binding = 6, std430) writeonly buffer DBiasBuf { float d_bias[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint m_n = pc.m * pc.n;
    uint total = 2u * m_n + pc.m;
    if (gid >= total) return;

    if (gid < m_n) {
        uint j = gid / pc.n;
        uint k = gid % pc.n;
        float acc = 0.0;
        for (uint r = 0u; r < pc.batch; ++r) {
            float pre_val = pre[j * pc.batch + r];
            float d_pre = (pre_val > 0.0) ? dout[j * pc.batch + r] : 0.0;
            acc += d_pre * a[k * pc.batch + r];
        }
        d_wa[gid] = acc;
    } else if (gid < 2u * m_n) {
        uint local = gid - m_n;
        uint j = local / pc.n;
        uint k = local % pc.n;
        float acc = 0.0;
        for (uint r = 0u; r < pc.batch; ++r) {
            float pre_val = pre[j * pc.batch + r];
            float d_pre = (pre_val > 0.0) ? dout[j * pc.batch + r] : 0.0;
            acc += d_pre * b[k * pc.batch + r];
        }
        d_wb[local] = acc;
    } else {
        uint j = gid - 2u * m_n;
        float acc = 0.0;
        for (uint r = 0u; r < pc.batch; ++r) {
            float pre_val = pre[j * pc.batch + r];
            float d_pre = (pre_val > 0.0) ? dout[j * pc.batch + r] : 0.0;
            acc += d_pre;
        }
        d_bias[j] = acc;
    }
}