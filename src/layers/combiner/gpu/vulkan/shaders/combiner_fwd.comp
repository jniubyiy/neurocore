// src/layers/combiner/gpu/vulkan/shaders/combiner_fwd.comp
//
// Прямой проход Combiner (column-major).
//
// Один поток на выходной элемент (r, j), j ∈ [0, m).
//
//   sum = bias[j] + Σ_k a[k, r] · wa[j, k] + Σ_k b[k, r] · wb[j, k]
//   out[j, r] = ReLU(sum)
//
// Раскладка активаций — column-major.
// Веса — row-major.
//
// Push-константы: batch, n, m.
// Dispatch: batch · m потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;
    uint m;
} pc;

layout(binding = 0, std430) readonly buffer ABuf     { float a[]; };
layout(binding = 1, std430) readonly buffer BBuf     { float b[]; };
layout(binding = 2, std430) readonly buffer WaBuf    { float wa[]; };
layout(binding = 3, std430) readonly buffer WbBuf    { float wb[]; };
layout(binding = 4, std430) readonly buffer BiasBuf  { float bias[]; };
layout(binding = 5, std430) writeonly buffer OutBuf  { float out_val[]; };
layout(binding = 6, std430) writeonly buffer PreBuf  { float pre[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.batch * pc.m) return;

    uint r = gid % pc.batch;
    uint j = gid / pc.batch;

    float sum = bias[j];
    for (uint k = 0u; k < pc.n; ++k) {
        sum += a[k * pc.batch + r] * wa[j * pc.n + k];
        sum += b[k * pc.batch + r] * wb[j * pc.n + k];
    }
    pre[j * pc.batch + r] = sum;
    out_val[j * pc.batch + r] = max(sum, 0.0);
}