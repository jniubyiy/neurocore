#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;          // batch * features
    float temperature;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer LogitBuf {
    float logit_p;       // обучаемый параметр (скаляр)
};

layout(binding = 3, std430) readonly buffer ArgBuf {
    float a[];           // сохранённые аргументы сигмоиды
};

layout(binding = 4, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 5, std430) buffer GradLogitBuf {
    uint grad_logit;     // битовое представление float для атомарного накопления
};

// Вспомогательная функция атомарного сложения float
void atomicAddFloat(inout uint target, float value) {
    uint expected = target;
    uint desired;
    do {
        float cur = uintBitsToFloat(expected);
        desired = floatBitsToUint(cur + value);
        uint old = atomicCompSwap(target, expected, desired);
        if (old == expected) return;
        expected = old;
    } while (true);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    float x_val = x[idx];
    float go_val = go[idx];
    float a_val = a[idx];

    float z = 1.0 / (1.0 + exp(-a_val));

    // Градиент по входу
    gi[idx] = go_val * z;

    // Градиент по logit_p через атомарное накопление
    float dz_da = z * (1.0 - z);
    float grad_a = go_val * x_val * dz_da;
    float grad_logit_contrib = grad_a / pc.temperature;

    atomicAddFloat(grad_logit, grad_logit_contrib);
}