#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;          // batch * features
    float temperature;   // температура
    uint seed;           // зерно для ГПСЧ
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];           // входной тензор (column-major)
};

layout(binding = 1, std430) readonly buffer LogitBuf {
    float logit_p;       // обучаемый параметр (скаляр)
};

layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];           // выходной тензор
};

layout(binding = 3, std430) writeonly buffer ArgBuf {
    float a[];           // сохранённые аргументы сигмоиды для обратного прохода
};

// ------------------- Генератор псевдослучайных чисел (xorshift) -------------------
uint rng_state;

uint rand_xorshift() {
    uint x = rng_state;
    x ^= x << 13;
    x ^= x >> 17;
    x ^= x << 5;
    rng_state = x;
    return x;
}

// Возвращает случайное число в (0,1) с хорошим распределением
float u_rand() {
    uint val = rand_xorshift() & 0x00FFFFFFu; // 24 бита
    return (float(val) + 0.5) / float(0x01000000u); // примерно (0,1)
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    // Инициализация состояния ГПСЧ на основе seed и индекса
    rng_state = pc.seed + idx * 1664525u + 1013904223u;
    // Разогрев генератора
    for (int i = 0; i < 4; i++) {
        rand_xorshift();
    }

    float u = u_rand();
    // Защита от log(0) и log(1-u)
    u = clamp(u, 1e-6, 1.0 - 1e-6);

    float logit = logit_p; // скаляр
    float a_val = (logit + log(u) - log(1.0 - u)) / pc.temperature;
    float z = 1.0 / (1.0 + exp(-a_val));

    y[idx] = x[idx] * z;
    a[idx] = a_val;
}