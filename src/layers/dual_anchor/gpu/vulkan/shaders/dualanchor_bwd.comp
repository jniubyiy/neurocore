#version 450
// NO extensions required

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    uint features;
    float alpha;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf { float go[]; };
layout(binding = 2, std430) readonly buffer MinBuf { float min_vals[]; };
layout(binding = 3, std430) readonly buffer MaxBuf { float max_vals[]; };
layout(binding = 4, std430) writeonly buffer GradInBuf { float gi[]; };
layout(binding = 5, std430) buffer GradMinBuf { int gmin[]; };
layout(binding = 6, std430) buffer GradMaxBuf { int gmax[]; };
layout(binding = 7, std430) buffer GradAlphaBuf { int galpha[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;

    uint c = i % pc.features;
    float x_val = x[i];
    float min_v = min_vals[c];
    float max_v = max_vals[c];
    float d_min = abs(x_val - min_v);
    float d_max = abs(x_val - max_v);
    float is_min = (d_min <= d_max) ? 1.0f : 0.0f;
    float go_val = go[i];

    gi[i] = go_val * (1.0f - pc.alpha);

    // Атомарное сложение для gmin[c]
    {
        float inc = go_val * pc.alpha * is_min;
        int expected = gmin[c];
        int desired;
        do {
            float cur = intBitsToFloat(expected);
            desired = floatBitsToInt(cur + inc);
            int old = atomicCompSwap(gmin[c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }

    // Атомарное сложение для gmax[c]
    {
        float inc = go_val * pc.alpha * (1.0f - is_min);
        int expected = gmax[c];
        int desired;
        do {
            float cur = intBitsToFloat(expected);
            desired = floatBitsToInt(cur + inc);
            int old = atomicCompSwap(gmax[c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }

    // Атомарное сложение для galpha[0]
    {
        float closest = (is_min != 0.0f) ? min_v : max_v;
        float inc = go_val * (closest - x_val);
        int expected = galpha[0];
        int desired;
        do {
            float cur = intBitsToFloat(expected);
            desired = floatBitsToInt(cur + inc);
            int old = atomicCompSwap(galpha[0], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
}