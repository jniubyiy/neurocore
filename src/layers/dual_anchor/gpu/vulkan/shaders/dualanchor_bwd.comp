// src/layers/dual_anchor/gpu/vulkan/shaders/dualanchor_bwd.comp
//
// Обратный проход DualAnchor на GPU (column-major).
//
// Формулы (совпадают с CPU-версией):
//   gi[i]          = go[i] · (1 − alpha)
//   grad_min[c]   += go[i] · alpha · is_min
//   grad_max[c]   += go[i] · alpha · (1 − is_min)
//   grad_alpha[0] += go[i] · (closest − x_val)
//
// Накопление градиентов по параметрам — через канонический макрос
// ATOMIC_ADD_FLOAT над uint-буферами.
//
// Push-константы: batch, features, alpha.
// Dispatch: batch · features потоков.

#version 450
// NO extensions required

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint  batch;
    uint  features;
    float alpha;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf    { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf  { float go[]; };
layout(binding = 2, std430) readonly buffer MinBuf      { float min_vals[]; };
layout(binding = 3, std430) readonly buffer MaxBuf      { float max_vals[]; };
layout(binding = 4, std430) writeonly buffer GradInBuf  { float gi[]; };
layout(binding = 5, std430) buffer GradMinBuf           { uint gmin[]; };
layout(binding = 6, std430) buffer GradMaxBuf           { uint gmax[]; };
layout(binding = 7, std430) buffer GradAlphaBuf         { uint galpha[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.batch * pc.features) return;

    uint c = i / pc.batch;

    float x_val = x[i];
    float min_v = min_vals[c];
    float max_v = max_vals[c];
    float d_min = abs(x_val - min_v);
    float d_max = abs(x_val - max_v);
    float is_min = (d_min <= d_max) ? 1.0 : 0.0;
    float go_val = go[i];

    // Градиент по входу.
    gi[i] = go_val * (1.0 - pc.alpha);

    // Градиент по min.
    ATOMIC_ADD_FLOAT(gmin[c], go_val * pc.alpha * is_min);

    // Градиент по max.
    ATOMIC_ADD_FLOAT(gmax[c], go_val * pc.alpha * (1.0 - is_min));

    // Градиент по alpha (единственный скаляр).
    float closest = (is_min != 0.0) ? min_v : max_v;
    ATOMIC_ADD_FLOAT(galpha[0], go_val * (closest - x_val));
}