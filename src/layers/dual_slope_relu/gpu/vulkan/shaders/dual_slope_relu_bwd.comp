#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;      // batch * features
    uint features;   // количество признаков
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer AlphaBuf {
    float alpha[];
};

layout(binding = 3, std430) readonly buffer BetaBuf {
    float beta[];
};

layout(binding = 4, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 5, std430) buffer GradAlphaBuf {
    uint grad_alpha[];  // битовое представление float
};

layout(binding = 6, std430) buffer GradBetaBuf {
    uint grad_beta[];   // битовое представление float
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    uint c = idx % pc.features;
    float x_val = x[idx];
    float gout = go[idx];

    if (x_val >= 0.0) {
        gi[idx] = gout * beta[c];

        // атомарное накопление в grad_beta[c]
        float inc = gout * x_val;
        uint expected = grad_beta[c];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_beta[c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    } else {
        gi[idx] = gout * alpha[c];

        // атомарное накопление в grad_alpha[c]
        float inc = gout * x_val;
        uint expected = grad_alpha[c];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_alpha[c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
}