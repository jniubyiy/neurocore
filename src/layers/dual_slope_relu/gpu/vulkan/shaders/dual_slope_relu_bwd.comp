// src/layers/dual_slope_relu/gpu/vulkan/shaders/dual_slope_relu_bwd.comp
//
// Обратный проход DualSlopeReLU на GPU.
//
// Раскладка активаций — column-major: x[c * batch + r].
// Для элемента с индексом idx:
//   batch = total / features
//   c = idx / batch,  r = idx % batch.
//
// y = beta[c] * x   при x >= 0
// y = alpha[c] * x  при x < 0
//
// ∂y/∂x = beta[c]  или alpha[c]
// ∂y/∂beta[c]  += go * x   (при x >= 0)
// ∂y/∂alpha[c] += go * x   (при x < 0)
//
// Push: total, features.
// Dispatch: total потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf   { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf { float go[]; };
layout(binding = 2, std430) readonly buffer AlphaBuf   { float alpha[]; };
layout(binding = 3, std430) readonly buffer BetaBuf    { float beta[]; };
layout(binding = 4, std430) writeonly buffer GradInBuf { float gi[]; };
layout(binding = 5, std430) buffer GradAlphaBuf        { uint grad_alpha[]; };
layout(binding = 6, std430) buffer GradBetaBuf         { uint grad_beta[]; };

// Канонический макрос атомарного сложения float через CAS.
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    // Column-major: c = idx / batch.
    uint batch = pc.total / pc.features;
    uint c = idx / batch;

    float x_val = x[idx];
    float gout = go[idx];

    if (x_val >= 0.0) {
        gi[idx] = gout * beta[c];
        ATOMIC_ADD_FLOAT(grad_beta[c], gout * x_val);
    } else {
        gi[idx] = gout * alpha[c];
        ATOMIC_ADD_FLOAT(grad_alpha[c], gout * x_val);
    }
}