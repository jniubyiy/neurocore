// src/layers/dual_slope_relu/gpu/vulkan/shaders/dual_slope_relu_fwd.comp
//
// Прямой проход DualSlopeReLU на GPU.
//
// Раскладка активаций — column-major: x[c * batch + r].
// Для элемента с индексом idx:
//   batch = total / features
//   c = idx / batch,  r = idx % batch.
//
// Каждый признак c имеет свои alpha[c], beta[c].
//
// Push: total, features.
// Dispatch: total потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf { float x[]; };
layout(binding = 1, std430) readonly buffer AlphaBuf { float alpha[]; };
layout(binding = 2, std430) readonly buffer BetaBuf  { float beta[]; };
layout(binding = 3, std430) writeonly buffer OutputBuf { float y[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    // Column-major: c = idx / batch.
    uint batch = pc.total / pc.features;
    uint c = idx / batch;

    float x_val = x[idx];
    float slope = (x_val >= 0.0) ? beta[c] : alpha[c];
    y[idx] = slope * x_val;
}