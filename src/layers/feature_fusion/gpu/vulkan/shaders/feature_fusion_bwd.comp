#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];   // column-major: go[j * batch + r]
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[];
};

layout(binding = 3, std430) writeonly buffer GradInBuf {
    float gi[];   // column-major: gi[i * batch + r]
};

layout(binding = 4, std430) buffer GradParamsBuf {
    uint grad_params[]; // битовое представление float
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.in_features;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint i = idx / pc.batch;

    // Вычисляем вклад в градиент по входу от всех выходов j
    float gi_val = 0.0;
    for (uint j = 0; j < pc.out_features; ++j) {
        // softmax логитов для выхода j
        float max_l = params[j * pc.in_features + 0];
        for (uint k = 1; k < pc.in_features; ++k) {
            float l = params[j * pc.in_features + k];
            if (l > max_l) max_l = l;
        }
        float sum_exp = 0.0;
        float weights[1024];
        for (uint k = 0; k < pc.in_features; ++k) {
            float e = exp(params[j * pc.in_features + k] - max_l);
            weights[k] = e;
            sum_exp += e;
        }
        float w_i = weights[i] / sum_exp;
        float gout = go[j * pc.batch + r];
        gi_val += gout * w_i;

        // Градиенты по логитам (для выхода j, признака i)
        // dL/dlogit_{j,i} = gout * (x_i * w_i * (1 - w_i))
        float dlogit = gout * x[i * pc.batch + r] * w_i * (1.0 - w_i);
        uint param_idx = j * pc.in_features + i;
        uint expected = grad_params[param_idx];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + dlogit);
            uint old = atomicCompSwap(grad_params[param_idx], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }

    gi[i * pc.batch + r] = gi_val;

    // Градиент по bias (просто сумма gout по батчу) — накапливаем в первом потоке? 
    // Для простоты не реализовано в этом шейдере, так как требуется отдельная редукция.
}