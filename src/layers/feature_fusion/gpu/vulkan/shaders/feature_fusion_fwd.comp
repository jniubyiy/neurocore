#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major: x[i * batch + r]
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[]; // [logits (out*in), bias (out)]
};

layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];   // column-major: y[j * batch + r]
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.out_features;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint j = idx / pc.batch;

    // softmax логитов для выхода j
    float max_l = params[j * pc.in_features + 0];
    for (uint i = 1; i < pc.in_features; ++i) {
        float l = params[j * pc.in_features + i];
        if (l > max_l) max_l = l;
    }

    float sum_exp = 0.0;
    float weights[1024]; // предполагаем, что in_features <= 1024 (можно увеличить)
    for (uint i = 0; i < pc.in_features; ++i) {
        float e = exp(params[j * pc.in_features + i] - max_l);
        weights[i] = e;
        sum_exp += e;
    }

    float bias = params[pc.out_features * pc.in_features + j];
    float acc = bias;
    for (uint i = 0; i < pc.in_features; ++i) {
        float w = weights[i] / sum_exp;
        acc += w * x[i * pc.batch + r];
    }
    y[j * pc.batch + r] = acc;
}