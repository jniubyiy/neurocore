// src/layers/feature_fusion/gpu/vulkan/shaders/feature_fusion_grad_T.comp
//
// Финализация градиента по температуре FeatureFusion.
//
// На вход приходит накопленный в dot_ldz[j] = Σ_k L[j,k] · dz[j,k].
// Записывает в grad_params[temp_idx]:
//
//   ∂L/∂T_raw[j] = −sign(T_raw[j]) · dot_ldz[j] / T_eff[j]²
//
// где T_eff[j] = |T_raw[j]| + 1e-6, sign берётся от T_raw[j].
//
// dot_ldz — uint-буфер (см. накопление через ATOMIC_ADD_FLOAT в
// feature_fusion_grad_params.comp); читается через uintBitsToFloat.
//
// Push-константы: out_features, in_features.
// Dispatch: out_features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint out_features;
    uint in_features;
} pc;

layout(binding = 0, std430) readonly buffer ParamsBuf {
    float params[];
};

layout(binding = 1, std430) readonly buffer DotLdzBuf {
    uint dot_ldz[];
};

layout(binding = 2, std430) writeonly buffer GradParamsBuf {
    float grad_params[];
};

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.out_features) return;

    uint fin = pc.in_features;
    uint fout = pc.out_features;
    uint temp_idx = fout * fin + j;

    float t_raw = params[temp_idx];
    float t_eff = abs(t_raw) + 1e-6;
    float inv_t = 1.0 / t_eff;
    float sign_t = (t_raw > 0.0) ? 1.0 : ((t_raw < 0.0) ? -1.0 : 0.0);

    float dot_val = uintBitsToFloat(dot_ldz[j]);
    grad_params[temp_idx] = -sign_t * dot_val * inv_t * inv_t;
}