// src/layers/feature_fusion/gpu/vulkan/shaders/feature_fusion_grad_input.comp
//
// Градиент по входу FeatureFusion: gi[i, r] = Σ_j go[j, r] * weights[j, i].
//
// Один поток на элемент входа (r, i). Локальных массивов нет.
//
// Раскладка:
//   go      — column-major, go[j * batch + r].
//   weights — row-major, weights[j * in_features + i].
//   gi      — column-major, gi[i * batch + r].
//
// Push-константы: batch, in_features, out_features.
// Dispatch: batch * in_features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer GradOutBuf { float go[]; };
layout(binding = 1, std430) readonly buffer WeightsBuf { float weights[]; };
layout(binding = 2, std430) writeonly buffer GradInBuf { float gi[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.in_features;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint i = idx / pc.batch;

    float sum = 0.0;
    for (uint j = 0u; j < pc.out_features; ++j) {
        sum += go[j * pc.batch + r] * weights[j * pc.in_features + i];
    }
    gi[idx] = sum;
}