// src/layers/feature_fusion/gpu/vulkan/shaders/feature_fusion_grad_params.comp
//
// Градиенты по параметрам FeatureFusion.
//
// Для логитов:  grad_logits[j, i] = Σ_r go[j, r] * x[i, r] * w[j, i] * (1 - w[j, i])
//               где w = softmax(логиты) для выхода j.
// Для смещений: grad_bias[j]     = Σ_r go[j, r].
//
// Каждый индекс (j, i) и (j) пишется ровно один раз — атомика не нужна.
// Локальных массивов нет.
//
// Раскладка:
//   x           — column-major, x[i * batch + r].
//   go          — column-major, go[j * batch + r].
//   weights     — row-major, weights[j * in_features + i] (выход softmax).
//   grad_logits — row-major, grad_logits[j * in_features + i].
//   grad_bias   — линейный, grad_bias[j].
//
// Push-константы: batch, in_features, out_features.
// Dispatch: out_features * in_features + out_features потоков.
//   [0, out*in)        → grad_logits для (j, i)
//   [out*in, out*in+out) → grad_bias для j

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf      { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf    { float go[]; };
layout(binding = 2, std430) readonly buffer WeightsBuf    { float weights[]; };
layout(binding = 3, std430) writeonly buffer GradLogitsBuf { float grad_logits[]; };
layout(binding = 4, std430) writeonly buffer GradBiasBuf   { float grad_bias[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint n_logits = pc.out_features * pc.in_features;
    uint total = n_logits + pc.out_features;
    if (idx >= total) return;

    if (idx < n_logits) {
        // Ветвь 1: grad_logits[j, i]
        uint j = idx / pc.in_features;
        uint i = idx % pc.in_features;

        float w = weights[idx];
        float acc = 0.0;
        for (uint r = 0u; r < pc.batch; ++r) {
            acc += go[j * pc.batch + r] * x[i * pc.batch + r];
        }
        grad_logits[idx] = acc * w * (1.0 - w);
    } else {
        // Ветвь 2: grad_bias[j]
        uint j = idx - n_logits;
        float acc = 0.0;
        for (uint r = 0u; r < pc.batch; ++r) {
            acc += go[j * pc.batch + r];
        }
        grad_bias[j] = acc;
    }
}