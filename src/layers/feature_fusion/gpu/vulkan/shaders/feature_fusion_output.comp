// src/layers/feature_fusion/gpu/vulkan/shaders/feature_fusion_output.comp
//
// Прямой проход FeatureFusion: y[j, r] = bias[j] + Σ_i weights[j, i] * x[i, r].
//
// Один поток на выходной элемент (r, j). Локальных массивов нет.
//
// Раскладка:
//   x       — column-major, x[i * batch + r].
//   params  — плоский блок [logits (out*in), bias (out)], bias[j] по адресу
//             out_features * in_features + j.
//   weights — row-major, weights[j * in_features + i].
//   y       — column-major, y[j * batch + r].
//
// Push-константы: batch, in_features, out_features.
// Dispatch: batch * out_features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf   { float x[]; };
layout(binding = 1, std430) readonly buffer ParamsBuf  { float params[]; };
layout(binding = 2, std430) readonly buffer WeightsBuf { float weights[]; };
layout(binding = 3, std430) writeonly buffer OutBuf    { float y[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.out_features;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint j = idx / pc.batch;

    float bias = params[pc.out_features * pc.in_features + j];
    uint  w_base = j * pc.in_features;

    float sum = bias;
    for (uint i = 0u; i < pc.in_features; ++i) {
        sum += weights[w_base + i] * x[i * pc.batch + r];
    }
    y[idx] = sum;
}