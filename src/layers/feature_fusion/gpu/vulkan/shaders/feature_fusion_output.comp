// src/layers/feature_fusion/gpu/vulkan/shaders/feature_fusion_output.comp
//
// Прямой проход FeatureFusion: y[j, r] = Σ_i weights[j, i] * x[i, r].
//
// Bias отсутствует (см. CPU-реализацию).
//
// Один поток на выходной элемент (r, j). Локальных массивов нет.
//
// Раскладка:
//   x       — column-major, x[i * batch + r].
//   weights — row-major, weights[j * in_features + i].
//   y       — column-major, y[j * batch + r].
//
// Push-константы: batch, in_features, out_features.
// Dispatch: batch * out_features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer WeightsBuf {
    float weights[];
};

layout(binding = 2, std430) writeonly buffer OutBuf {
    float y[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.out_features;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint j = idx / pc.batch;

    uint w_base = j * pc.in_features;

    float acc = 0.0;
    for (uint i = 0u; i < pc.in_features; ++i) {
        acc += weights[w_base + i] * x[i * pc.batch + r];
    }
    y[j * pc.batch + r] = acc;
}