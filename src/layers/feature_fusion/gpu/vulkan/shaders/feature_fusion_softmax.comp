// src/layers/feature_fusion/gpu/vulkan/shaders/feature_fusion_softmax.comp
//
// Softmax логитов FeatureFusion для каждого выходного признака.
//
// Один поток обрабатывает один выход j (вектор логитов длины in_features).
// Локальных массивов нет — только линейные обходы.
// Ограничений на in_features нет.
//
// Раскладка:
//   params  — плоский блок [logits (out*in), bias (out)], row-major,
//             logits[j * in_features + i].
//   weights — выход softmax, row-major, weights[j * in_features + i].
//
// Push-константы: out_features, in_features.
// Dispatch: out_features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint out_features;
    uint in_features;
} pc;

layout(binding = 0, std430) readonly buffer ParamsBuf {
    float params[];
};

layout(binding = 1, std430) writeonly buffer WeightsBuf {
    float weights[];
};

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.out_features) return;

    uint base = j * pc.in_features;

    // Проход 1: максимум логитов (численная устойчивость).
    float max_l = params[base];
    for (uint i = 1u; i < pc.in_features; ++i) {
        float l = params[base + i];
        if (l > max_l) max_l = l;
    }

    // Проход 2: сумма экспонент.
    float sum_exp = 0.0;
    for (uint i = 0u; i < pc.in_features; ++i) {
        sum_exp += exp(params[base + i] - max_l);
    }
    float inv_sum = 1.0 / sum_exp;

    // Проход 3: запись нормализованных весов.
    for (uint i = 0u; i < pc.in_features; ++i) {
        weights[base + i] = exp(params[base + i] - max_l) * inv_sum;
    }
}