// src/layers/feature_fusion/gpu/vulkan/shaders/feature_fusion_softmax.comp
//
// Softmax логитов FeatureFusion с обучаемой температурой.
//
// Для каждого выхода j ∈ [0, out_features):
//   T_eff      = |T_raw[j]| + 1e-6
//   w[j,i]     = exp((L[j,i] - max_i L[j,:]) / T_eff) / Σ_k exp((L[j,k] - max_i L[j,:]) / T_eff)
//
// Сдвиг на max_i L — численно устойчивый softmax, не меняет результат,
// так как сдвиг одинаков для всех i.
//
// Раскладка:
//   params  — плоский блок [logits (out*in), T_raw (out)], row-major по j.
//             logits[j * in_features + i]
//             T_raw[out_features * in_features + j]
//   weights — выход softmax, row-major, weights[j * in_features + i].
//
// Push-константы: out_features, in_features.
// Dispatch: out_features потоков (один поток на выход j).

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint out_features;
    uint in_features;
} pc;

layout(binding = 0, std430) readonly buffer ParamsBuf {
    float params[];
};

layout(binding = 1, std430) writeonly buffer WeightsBuf {
    float weights[];
};

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.out_features) return;

    uint fin = pc.in_features;
    uint fout = pc.out_features;

    uint logits_base = j * fin;
    uint temp_idx = fout * fin + j;

    float t_raw = params[temp_idx];
    float t_eff = abs(t_raw) + 1e-6;
    float inv_t = 1.0 / t_eff;

    // Проход 1: максимум
    float max_l = params[logits_base];
    for (uint i = 1u; i < fin; ++i) {
        float l = params[logits_base + i];
        if (l > max_l) max_l = l;
    }

    // Проход 2: сумма экспонент
    float sum_exp = 0.0;
    for (uint i = 0u; i < fin; ++i) {
        sum_exp += exp((params[logits_base + i] - max_l) * inv_t);
    }
    float inv_sum = 1.0 / sum_exp;

    // Проход 3: запись нормализованных весов
    for (uint i = 0u; i < fin; ++i) {
        weights[logits_base + i] =
            exp((params[logits_base + i] - max_l) * inv_t) * inv_sum;
    }
}