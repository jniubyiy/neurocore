#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;   // input_dim
    uint seq_len;    // длина последовательности
    uint t;          // текущий шаг обратного прохода (0..seq_len-1)
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];          // column-major: x[(t*features + j)*batch + r]
};

layout(binding = 1, std430) readonly buffer WeightBuf {
    float w[];          // row-major: w[i*features + j]
};

layout(binding = 2, std430) readonly buffer UBuf {
    float u[];          // length features
};

layout(binding = 3, std430) readonly buffer GradOutBuf {
    float go[];         // column-major: go[(t*features + i)*batch + r]
};

layout(binding = 4, std430) readonly buffer HAllBuf {
    float h_all[];      // row-major: (batch * seq_len) x features
};

layout(binding = 5, std430) readonly buffer DeltaNextInBuf {
    float delta_next_in[]; // размер batch * features
};

layout(binding = 6, std430) buffer GradWeightBuf {
    uint grad_w[];      // битовое представление float, размер features*features
};

layout(binding = 7, std430) buffer GradUBuf {
    uint grad_u[];      // битовое представление float, размер features
};

layout(binding = 8, std430) buffer GradBiasBuf {
    uint grad_b[];      // битовое представление float, размер features
};

layout(binding = 9, std430) buffer GradInputBuf {
    uint gi[];          // битовое представление float, column-major как x (полный размер batch*seq_len*features)
};

layout(binding = 10, std430) writeonly buffer DeltaNextOutBuf {
    float delta_next_out[]; // размер batch * features
};

// Вспомогательная функция атомарного сложения float через CAS
void atomicAddFloat(inout uint target, float value) {
    uint expected = target;
    uint desired;
    do {
        float cur = uintBitsToFloat(expected);
        desired = floatBitsToUint(cur + value);
        uint old = atomicCompSwap(target, expected, desired);
        if (old == expected) return;
        expected = old;
    } while (true);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_elems = pc.batch * pc.features;
    if (idx >= total_elems) return;

    uint r = idx / pc.features;   // индекс примера
    uint i = idx % pc.features;   // индекс признака

    // Читаем h_prev (если t > 0)
    float h_prev = 0.0;
    if (pc.t > 0u) {
        uint h_prev_idx = (r * pc.seq_len + pc.t - 1u) * pc.features + i;
        h_prev = h_all[h_prev_idx];
    }

    // Читаем h_t
    uint h_t_idx = (r * pc.seq_len + pc.t) * pc.features + i;
    float h_t = h_all[h_t_idx];

    // Градиент по выходу текущего шага
    uint go_idx = (pc.t * pc.features + i) * pc.batch + r;
    float grad_out_t = go[go_idx];

    // delta_next из будущего шага
    float d_next = delta_next_in[r * pc.features + i];

    // Полный градиент до активации
    float dL_dh = grad_out_t + u[i] * d_next;

    // Производная ReLU
    float d_relu = (h_t > 0.0) ? 1.0 : 0.0;
    float delta_t = dL_dh * d_relu;

    // Сохраняем delta_t для прошлого шага
    delta_next_out[r * pc.features + i] = delta_t;

    // Накопление градиента по bias
    atomicAddFloat(grad_b[i], delta_t);

    // Накопление градиента по u (только если t>0, так как при t=0 h_prev=0)
    if (pc.t > 0u) {
        float grad_u_contrib = delta_t * h_prev;
        atomicAddFloat(grad_u[i], grad_u_contrib);
    }

    // Накопление градиента по W и градиента по входу
    for (uint j = 0u; j < pc.features; ++j) {
        // x_t_j
        uint x_idx = (pc.t * pc.features + j) * pc.batch + r;
        float x_t_j = x[x_idx];

        // grad_w[i*features + j] += delta_t * x_t_j
        float grad_w_contrib = delta_t * x_t_j;
        atomicAddFloat(grad_w[i * pc.features + j], grad_w_contrib);

        // gi[(t*features + j)*batch + r] += delta_t * w[i*features + j]
        float grad_x_contrib = delta_t * w[i * pc.features + j];
        uint gi_idx = (pc.t * pc.features + j) * pc.batch + r;
        atomicAddFloat(gi[gi_idx], grad_x_contrib);
    }
}