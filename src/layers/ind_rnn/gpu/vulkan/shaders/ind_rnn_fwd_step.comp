#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;   // input_dim
    uint seq_len;    // длина последовательности
    uint t;          // текущий шаг (0..seq_len-1)
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major: x[(t*features + j)*batch + r]
};

layout(binding = 1, std430) readonly buffer WeightBuf {
    float w[];   // row-major: w[i*features + j]
};

layout(binding = 2, std430) readonly buffer UBuf {
    float u[];   // length features
};

layout(binding = 3, std430) readonly buffer BiasBuf {
    float b[];   // length features
};

layout(binding = 4, std430) buffer HAllBuf {
    float h_all[]; // (batch * seq_len) x features, row-major по (r,t,i)
};

layout(binding = 5, std430) writeonly buffer OutputBuf {
    float y[];   // column-major: y[(t*features + i)*batch + r]
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.features;
    if (idx >= total) return;

    uint r = idx / pc.features;   // индекс примера
    uint i = idx % pc.features;   // индекс признака

    // Читаем предыдущее скрытое состояние (для t=0 равно нулю)
    float h_prev = 0.0;
    if (pc.t > 0u) {
        uint h_prev_idx = (r * pc.seq_len + pc.t - 1u) * pc.features + i;
        h_prev = h_all[h_prev_idx];
    }

    // Линейная комбинация входа + рекуррентная часть + смещение
    float sum = b[i];
    for (uint j = 0u; j < pc.features; ++j) {
        uint x_idx = (pc.t * pc.features + j) * pc.batch + r;
        sum += w[i * pc.features + j] * x[x_idx];
    }
    sum += u[i] * h_prev;

    // Активация ReLU
    float h = max(sum, 0.0);

    // Записываем выход
    uint y_idx = (pc.t * pc.features + i) * pc.batch + r;
    y[y_idx] = h;

    // Сохраняем скрытое состояние в общий буфер для последующих шагов и backward
    uint h_idx = (r * pc.seq_len + pc.t) * pc.features + i;
    h_all[h_idx] = h;
}