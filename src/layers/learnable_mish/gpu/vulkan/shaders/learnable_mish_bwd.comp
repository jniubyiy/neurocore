#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer LambdaBuf {
    float lambda;
};

layout(binding = 3, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 4, std430) buffer GradLambdaBuf {
    uint grad_lambda; // битовое представление float
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    float x_val = x[idx];
    float gout = go[idx];
    float sp = log(1.0 + exp(x_val));
    float tanh_sp = tanh(lambda * sp);
    float dtanh = 1.0 - tanh_sp * tanh_sp;
    float sigmoid = 1.0 / (1.0 + exp(-x_val));

    // Градиент по входу
    float dx = tanh_sp + x_val * dtanh * lambda * sigmoid;
    gi[idx] = gout * dx;

    // Градиент по lambda (атомарное накопление)
    float inc = gout * x_val * dtanh * sp;
    uint expected = grad_lambda;
    uint desired;
    do {
        float cur = uintBitsToFloat(expected);
        desired = floatBitsToUint(cur + inc);
        uint old = atomicCompSwap(grad_lambda, expected, desired);
        if (old == expected) break;
        expected = old;
    } while (true);
}