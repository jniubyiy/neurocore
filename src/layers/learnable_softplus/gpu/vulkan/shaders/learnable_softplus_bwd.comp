#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;      // batch * features
    uint features;   // количество признаков
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer BetaBuf {
    float beta[];
};

layout(binding = 3, std430) readonly buffer ThetaBuf {
    float theta[];
};

layout(binding = 4, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 5, std430) buffer GradBetaBuf {
    uint grad_beta[];  // битовое представление float
};

layout(binding = 6, std430) buffer GradThetaBuf {
    uint grad_theta[]; // битовое представление float
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    uint c = idx % pc.features;
    float x_val = x[idx];
    float gout = go[idx];
    float b = beta[c];
    float t = theta[c];
    float shifted = b * (x_val - t);
    float sigmoid = 1.0 / (1.0 + exp(-shifted));
    float y_val = (1.0 / b) * log(1.0 + exp(shifted));

    // Градиент по входу
    gi[idx] = gout * sigmoid;

    // Градиент по beta: (x - theta)*sigmoid - y/b
    float d_beta = (x_val - t) * sigmoid - y_val / b;
    // Атомарное накопление в grad_beta[c]
    {
        float inc = gout * d_beta;
        uint expected = grad_beta[c];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_beta[c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }

    // Градиент по theta: -sigmoid
    float d_theta = -sigmoid;
    // Атомарное накопление в grad_theta[c]
    {
        float inc = gout * d_theta;
        uint expected = grad_theta[c];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_theta[c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
}