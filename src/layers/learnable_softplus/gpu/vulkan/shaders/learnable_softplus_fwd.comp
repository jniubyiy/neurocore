#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;      // batch * features
    uint features;   // количество признаков
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer BetaBuf {
    float beta[];   // длина features
};

layout(binding = 2, std430) readonly buffer ThetaBuf {
    float theta[];  // длина features
};

layout(binding = 3, std430) writeonly buffer OutputBuf {
    float y[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    uint c = idx % pc.features;
    float x_val = x[idx];
    float b = beta[c];
    float t = theta[c];
    float shifted = b * (x_val - t);
    // log(1 + exp(shifted)) = log1p(exp(shifted))
    y[idx] = (1.0 / b) * log(1.0 + exp(shifted));
}