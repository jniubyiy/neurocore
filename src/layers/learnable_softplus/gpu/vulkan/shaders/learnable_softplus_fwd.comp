// src/layers/learnable_softplus/gpu/vulkan/shaders/learnable_softplus_fwd.comp
//
// Прямой проход LearnableSoftplus на GPU.
//
// Раскладка активаций — column-major: x[c * batch + r].
// Значит для элемента с глобальным индексом idx:
//   c = idx / batch,  r = idx % batch,  batch = total / features.
//
// β = exp(β_raw) > 0
// y = softplus(β·(x − θ)) / β
// softplus(z) = ln(1 + e^z) — численно устойчивая форма.
//
// Push: total, features.
// Dispatch: total потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf   { float x[]; };
layout(binding = 1, std430) readonly buffer BetaBuf    { float beta_raw[]; };
layout(binding = 2, std430) readonly buffer ThetaBuf   { float theta[]; };
layout(binding = 3, std430) writeonly buffer OutputBuf { float y[]; };

float softplus(float z) {
    return max(z, 0.0) + log(1.0 + exp(-abs(z)));
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    // Column-major: c = idx / batch.
    uint batch = pc.total / pc.features;
    uint c = idx / batch;

    float x_val = x[idx];

    float b = exp(beta_raw[c]);
    float t = theta[c];
    float shifted = b * (x_val - t);

    y[idx] = softplus(shifted) / b;
}