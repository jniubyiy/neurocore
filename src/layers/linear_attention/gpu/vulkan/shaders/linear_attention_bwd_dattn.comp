// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dattn.comp
//
// dL/dattn[r,t,i] = Σ_k go_h[r,t,k] · Wo[k,i]
//
// Один поток на (r,t,i). Цикл по k (d_model).
//
// Раскладка:
//   go     (batch, seq, d_model), column-major
//   wo     (d_model, d_head),   row-major: wo[k * d_head + i]
//   d_attn (batch, seq, d_head), column-major
//
// Push: [batch, seq, d_head, d_model]  (16 байт)
// Dispatch: batch · seq · d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf      { float go[]; };
layout(binding = 1, std430) readonly buffer WoBuf      { float wo[]; };
layout(binding = 2, std430) writeonly buffer DAttnBuf  { float d_attn[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i = tmp % pc.d_head;
    uint t = tmp / pc.d_head;

    uint go_base = (t * pc.d_model) * pc.batch + r;
    float sum = 0.0;
    for (uint k = 0u; k < pc.d_model; ++k) {
        sum += go[go_base + k * pc.batch] * wo[k * pc.d_head + i];
    }
    d_attn[idx] = sum;
}