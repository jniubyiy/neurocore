// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dk_phi.comp
//
//   d_k_phi[r,t,l] = Σ_i d_kv[r, l, i] · v_raw[r,t,i] + d_z[r, l]
//
// FIX: d_kv и d_z теперь per-example (индексация по r).
//
// Один поток на (r,t,l). Цикл по i (d_head).
//
// Push: [batch, seq, d_head]  (12 байт)
// Dispatch: batch · seq · d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer DKVBuf      { float d_kv[]; };
layout(binding = 1, std430) readonly buffer VRawBuf     { float v_raw[]; };
layout(binding = 2, std430) readonly buffer DZBuf       { float d_z[]; };
layout(binding = 3, std430) writeonly buffer DKPhiBuf   { float d_k_phi[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint l = tmp % pc.d_head;
    uint t = tmp / pc.d_head;

    uint base = (t * pc.d_head) * pc.batch + r;
    uint d_kv_r = r * pc.d_head * pc.d_head;
    uint d_z_r = r * pc.d_head;

    float sum = d_z[d_z_r + l];
    for (uint i = 0u; i < pc.d_head; ++i) {
        sum += d_kv[d_kv_r + l * pc.d_head + i] * v_raw[base + i * pc.batch];
    }
    d_k_phi[idx] = sum;
}