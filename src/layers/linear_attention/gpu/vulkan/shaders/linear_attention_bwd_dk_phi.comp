// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dk_phi.comp
//
// Третий этап обратного прохода LinearAttention.
//
// Один поток на (токен, l).
//
//   d_k_phi[tok,l] = d_z[l] + Σ_i d_kv[i,l] · v[tok,i]
//
// d_kv читается как битовое представление float (uint).
//
// Push: batch, seq_len, d_model.
// Dispatch: (batch · seq_len) · d_model потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer VBuf      { float v[]; };
layout(binding = 1, std430) readonly buffer DKVBuf    { uint d_kv[]; };
layout(binding = 2, std430) readonly buffer DZBuf     { uint d_z[]; };
layout(binding = 3, std430) writeonly buffer DKPhiBuf { float d_k_phi[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint d = pc.d_model;
    uint token_count = pc.batch * pc.seq_len;
    uint total = token_count * d;
    if (gid >= total) return;

    uint tok = gid / d;
    uint l = gid % d;

    uint r = tok % pc.batch;
    uint t = tok / pc.batch;
    uint tok_base = (t * d) * pc.batch + r;

    float sum = uintBitsToFloat(d_z[l]);
    for (uint i = 0u; i < d; ++i) {
        float dkv = uintBitsToFloat(d_kv[i * d + l]);
        sum += dkv * v[tok_base + i * pc.batch];
    }
    d_k_phi[tok_base + l * pc.batch] = sum;
}