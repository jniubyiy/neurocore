// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dkv.comp
//
//   d_kv[l,i] = Σ_{r,t} d_num[r,t,i] · q_phi[r,t,l]
//
// Один поток на (l,i). Цикл по (r,t).
//
// Push: [batch, seq, d_head]  (12 байт)
// Dispatch: d_head · d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer DNumBuf   { float d_num[]; };
layout(binding = 1, std430) readonly buffer QPhiBuf   { float q_phi[]; };
layout(binding = 2, std430) writeonly buffer DKVBuf   { float d_kv[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.d_head * pc.d_head) return;

    uint l = idx / pc.d_head;
    uint i = idx % pc.d_head;

    float sum = 0.0;
    for (uint t = 0u; t < pc.seq; ++t) {
        uint q_base = (t * pc.d_head) * pc.batch;
        uint n_base = (t * pc.d_head) * pc.batch;
        for (uint r = 0u; r < pc.batch; ++r) {
            sum += d_num[n_base + i * pc.batch + r]
                 * q_phi[q_base + l * pc.batch + r];
        }
    }
    d_kv[idx] = sum;
}