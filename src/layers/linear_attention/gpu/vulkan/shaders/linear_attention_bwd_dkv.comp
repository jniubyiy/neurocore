// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dkv.comp
//
//   d_kv[r, l, i] = Σ_t d_num[r,t,i] · q_phi[r,t,l]
//
// FIX: d_kv теперь per-example, размер (batch · d_head · d_head).
// Было: d_kv[l,i] — одна голова на весь батч.
//
// Dispatch: batch · d_head · d_head потоков.
// idx = r · d_head·d_head + l · d_head + i.
//
// Push: [batch, seq, d_head]  (12 байт).

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer DNumBuf   { float d_num[]; };
layout(binding = 1, std430) readonly buffer QPhiBuf   { float q_phi[]; };
layout(binding = 2, std430) writeonly buffer DKVBuf   { float d_kv[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint dh = pc.d_head;
    uint per_example = dh * dh;
    if (idx >= pc.batch * per_example) return;

    uint r     = idx / per_example;
    uint local = idx % per_example;
    uint l     = local / dh;
    uint i     = local % dh;

    float sum = 0.0;
    for (uint t = 0u; t < pc.seq; ++t) {
        uint q_base = (t * dh) * pc.batch;
        uint n_base = (t * dh) * pc.batch;
        sum += d_num[n_base + i * pc.batch + r]
             * q_phi[q_base + l * pc.batch + r];
    }
    d_kv[r * per_example + l * dh + i] = sum;
}