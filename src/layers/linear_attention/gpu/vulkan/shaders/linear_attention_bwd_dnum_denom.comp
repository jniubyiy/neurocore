// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dnum_denom.comp
//
//   d_num[r,t,i]   = d_attn[r,t,i] / denom[r,t]
//   d_denom[r,t]   = -Σ_i d_num[r,t,i] · attn[r,t,i]
//
// Один поток на (r,t). Цикл по i (d_head).
//
// Push: [batch, seq, d_head]  (12 байт)
// Dispatch: batch · seq потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer DAttnBuf  { float d_attn[]; };
layout(binding = 1, std430) readonly buffer DenomBuf  { float denom[]; };
layout(binding = 2, std430) readonly buffer AttnBuf   { float attn[]; };
layout(binding = 3, std430) writeonly buffer DNumBuf  { float d_num[]; };
layout(binding = 4, std430) writeonly buffer DDenomBuf { float d_denom[]; };

void main() {
    uint rt = gl_GlobalInvocationID.x;
    if (rt >= pc.batch * pc.seq) return;

    uint r = rt % pc.batch;
    uint t = rt / pc.batch;

    float inv_denom = 1.0 / denom[rt];

    uint base = (t * pc.d_head) * pc.batch + r;
    float ddenom = 0.0;
    for (uint i = 0u; i < pc.d_head; ++i) {
        uint off = base + i * pc.batch;
        float dnum = d_attn[off] * inv_denom;
        d_num[off] = dnum;
        ddenom -= dnum * attn[off];
    }
    d_denom[rt] = ddenom;
}