// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dq_phi.comp
//
//   d_q_phi[r,t,l] = d_denom[r,t] · z[l] + Σ_i d_num[r,t,i] · kv[l,i]
//
// Один поток на (r,t,l). Цикл по i (d_head).
//
// Push: [batch, seq, d_head]  (12 байт)
// Dispatch: batch · seq · d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer DDenomBuf { float d_denom[]; };
layout(binding = 1, std430) readonly buffer ZBuf      { float z[]; };
layout(binding = 2, std430) readonly buffer DNumBuf   { float d_num[]; };
layout(binding = 3, std430) readonly buffer KVBuf     { float kv[]; };
layout(binding = 4, std430) writeonly buffer DQPhiBuf { float d_q_phi[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint l = tmp % pc.d_head;
    uint t = tmp / pc.d_head;

    uint rt = t * pc.batch + r;
    uint base = (t * pc.d_head) * pc.batch + r;

    float sum = d_denom[rt] * z[l];
    for (uint i = 0u; i < pc.d_head; ++i) {
        sum += d_num[base + i * pc.batch] * kv[l * pc.d_head + i];
    }
    d_q_phi[idx] = sum;
}