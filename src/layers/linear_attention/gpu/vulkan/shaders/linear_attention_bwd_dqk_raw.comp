// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dqk_raw.comp
//
// Backward через φ:
//   φ(x)  = elu(x) + 1
//   φ'(x) = (x > 0) ? 1 : exp(x)
//
//   d_q_raw[r,t,j] = d_q_phi[r,t,j] · φ'(q_raw[r,t,j])
//   d_k_raw[r,t,j] = d_k_phi[r,t,j] · φ'(k_raw[r,t,j])
//
// Один поток на (r,t,j). Без циклов.
//
// Push: [batch, seq, d_head]  (12 байт)
// Dispatch: batch · seq · d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer DQPhiBuf   { float d_q_phi[]; };
layout(binding = 1, std430) readonly buffer QRawBuf    { float q_raw[]; };
layout(binding = 2, std430) writeonly buffer DQRawBuf  { float d_q_raw[]; };
layout(binding = 3, std430) readonly buffer DKPhiBuf   { float d_k_phi[]; };
layout(binding = 4, std430) readonly buffer KRawBuf    { float k_raw[]; };
layout(binding = 5, std430) writeonly buffer DKRawBuf  { float d_k_raw[]; };

float phi_derivative(float x) {
    return (x > 0.0) ? 1.0 : exp(x);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq * pc.d_head) return;

    d_q_raw[idx] = d_q_phi[idx] * phi_derivative(q_raw[idx]);
    d_k_raw[idx] = d_k_phi[idx] * phi_derivative(k_raw[idx]);
}