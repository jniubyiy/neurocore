// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dv.comp
//
//   d_v[r,t,i] = d_num[r,t,i] · self_bias + Σ_l d_kv[l,i] · k_phi[r,t,l]
//
// Один поток на (r,t,i). Цикл по l (d_head).
//
// Push: [batch, seq, d_head, self_bias_bits]  (16 байт)
// Dispatch: batch · seq · d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
    float self_bias;
} pc;

layout(binding = 0, std430) readonly buffer DNumBuf      { float d_num[]; };
layout(binding = 1, std430) readonly buffer DKVBuf       { float d_kv[]; };
layout(binding = 2, std430) readonly buffer KPhiBuf      { float k_phi[]; };
layout(binding = 3, std430) writeonly buffer DVBuf       { float d_v[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i = tmp % pc.d_head;
    uint t = tmp / pc.d_head;

    uint base = (t * pc.d_head) * pc.batch + r;

    float sum = d_num[base + i * pc.batch] * pc.self_bias;
    for (uint l = 0u; l < pc.d_head; ++l) {
        sum += d_kv[l * pc.d_head + i] * k_phi[base + l * pc.batch];
    }
    d_v[idx] = sum;
}