// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dv.comp
//
// Четвёртый этап обратного прохода LinearAttention.
//
// Один поток на (токен, i).
//
//   d_v[tok,i] = Σ_l d_kv[i,l] · k_phi[tok,l]
//
// Push: batch, seq_len, d_model.
// Dispatch: (batch · seq_len) · d_model потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer KPhiBuf  { float k_phi[]; };
layout(binding = 1, std430) readonly buffer DKVBuf   { uint d_kv[]; };
layout(binding = 2, std430) writeonly buffer DVBuf   { float d_v[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint d = pc.d_model;
    uint token_count = pc.batch * pc.seq_len;
    uint total = token_count * d;
    if (gid >= total) return;

    uint tok = gid / d;
    uint i = gid % d;

    uint r = tok % pc.batch;
    uint t = tok / pc.batch;
    uint tok_base = (t * d) * pc.batch + r;

    float sum = 0.0;
    for (uint l = 0u; l < d; ++l) {
        float dkv = uintBitsToFloat(d_kv[i * d + l]);
        sum += dkv * k_phi[tok_base + l * pc.batch];
    }
    d_v[tok_base + i * pc.batch] = sum;
}