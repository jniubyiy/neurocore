// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dx.comp
//
//   d_x[r,t,i] = Σ_j ( d_q_raw[r,t,j] · Wq[j,i]
//                   + d_k_raw[r,t,j] · Wk[j,i]
//                   + d_v    [r,t,j] · Wv[j,i] )
//
// Один поток на (r,t,i). Цикл по j (d_head).
//
// Раскладка W-матриц: row-major, (d_head × d_model): w[j * d_model + i].
//
// Push: [batch, seq, d_head, d_model]  (16 байт)
// Dispatch: batch · seq · d_model потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer DQRawBuf    { float d_q_raw[]; };
layout(binding = 1, std430) readonly buffer DKRawBuf    { float d_k_raw[]; };
layout(binding = 2, std430) readonly buffer DVBuf       { float d_v[]; };
layout(binding = 3, std430) readonly buffer WqBuf       { float wq[]; };
layout(binding = 4, std430) readonly buffer WkBuf       { float wk[]; };
layout(binding = 5, std430) readonly buffer WvBuf       { float wv[]; };
layout(binding = 6, std430) writeonly buffer DxBuf      { float d_x[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq * pc.d_model) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i = tmp % pc.d_model;
    uint t = tmp / pc.d_model;

    uint head_base = (t * pc.d_head) * pc.batch + r;

    float sum = 0.0;
    for (uint j = 0u; j < pc.d_head; ++j) {
        uint off = head_base + j * pc.batch;
        sum += d_q_raw[off] * wq[j * pc.d_model + i]
             + d_k_raw[off] * wk[j * pc.d_model + i]
             + d_v    [off] * wv[j * pc.d_model + i];
    }
    d_x[idx] = sum;
}