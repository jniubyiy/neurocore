// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_dz.comp
//
//   d_z[r, l] = Σ_t d_denom[r,t] · q_phi[r,t,l]
//
// FIX: d_z теперь per-example, размер (batch · d_head).
// Было: d_z[l] — одна голова на весь батч.
//
// Dispatch: batch · d_head потоков.
// idx = r · d_head + l.
//
// Push: [batch, seq, d_head]  (12 байт).

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer DDenomBuf { float d_denom[]; };
layout(binding = 1, std430) readonly buffer QPhiBuf   { float q_phi[]; };
layout(binding = 2, std430) writeonly buffer DZBuf    { float d_z[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.d_head) return;

    uint r = idx / pc.d_head;
    uint l = idx % pc.d_head;

    float sum = 0.0;
    for (uint t = 0u; t < pc.seq; ++t) {
        uint q_base = (t * pc.d_head) * pc.batch;
        sum += d_denom[t * pc.batch + r] * q_phi[q_base + l * pc.batch + r];
    }
    d_z[r * pc.d_head + l] = sum;
}