// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_gi_params.comp
//
// Финальный этап обратного прохода LinearAttention:
// градиент по входу и градиенты по W_q,b_q,W_k,b_k,W_v,b_v.
//
// Один поток на (токен, i). Внутри линейный цикл по j.
//
//   dq_raw[j] = d_q_phi[tok,j] · φ'(q_raw[tok,j])
//   dk_raw[j] = d_k_phi[tok,j] · φ'(k_raw[tok,j])
//   dv[j]     = d_v[tok,j]
//
//   gi[tok,i]      = Σ_j (dq_raw[j] · W_q[j,i] + dk_raw[j] · W_k[j,i] + dv[j] · W_v[j,i])
//   grad_W_q[j,i] += dq_raw[j] · x[tok,i]
//   grad_W_k[j,i] += dk_raw[j] · x[tok,i]
//   grad_W_v[j,i] += dv[j]     · x[tok,i]
//   grad_b_q[j]   += dq_raw[j]
//   grad_b_k[j]   += dk_raw[j]
//   grad_b_v[j]   += dv[j]
//
// φ'(x) = 1 при x > 0, exp(x) при x ≤ 0.
//
// Push: batch, seq_len, d_model.
// Dispatch: (batch · seq_len) · d_model потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer XBuf        { float x[]; };
layout(binding = 1, std430) readonly buffer QRawBuf     { float q_raw[]; };
layout(binding = 2, std430) readonly buffer KRawBuf     { float k_raw[]; };
layout(binding = 3, std430) readonly buffer DQPhiBuf    { float d_q_phi[]; };
layout(binding = 4, std430) readonly buffer DKPhiBuf    { float d_k_phi[]; };
layout(binding = 5, std430) readonly buffer DVBuf       { float d_v[]; };
layout(binding = 6, std430) readonly buffer ParamsBuf   { float params[]; };
layout(binding = 7, std430) writeonly buffer GradInBuf  { float gi[]; };
layout(binding = 8, std430) buffer GradParamsBuf        { uint grad_params[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

float phi_derivative(float x_val) {
    return (x_val > 0.0) ? 1.0 : exp(x_val);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint d = pc.d_model;
    uint token_count = pc.batch * pc.seq_len;
    uint total = token_count * d;
    if (gid >= total) return;

    uint tok = gid / d;
    uint i = gid % d;

    uint r = tok % pc.batch;
    uint t = tok / pc.batch;
    uint tok_base = (t * d) * pc.batch + r;

    uint d2 = d * d;
    uint wq_start = 0u;
    uint bq_start = wq_start + d2;
    uint wk_start = bq_start + d;
    uint bk_start = wk_start + d2;
    uint wv_start = bk_start + d;
    uint bv_start = wv_start + d2;

    float x_i = x[tok_base + i * pc.batch];
    float gi_i = 0.0;

    for (uint j = 0u; j < d; ++j) {
        float qr = q_raw[tok_base + j * pc.batch];
        float kr = k_raw[tok_base + j * pc.batch];
        float dq = d_q_phi[tok_base + j * pc.batch] * phi_derivative(qr);
        float dk = d_k_phi[tok_base + j * pc.batch] * phi_derivative(kr);
        float dv = d_v[tok_base + j * pc.batch];

        gi_i += dq * params[wq_start + j * d + i]
              + dk * params[wk_start + j * d + i]
              + dv * params[wv_start + j * d + i];

        ATOMIC_ADD_FLOAT(grad_params[wq_start + j * d + i], dq * x_i);
        ATOMIC_ADD_FLOAT(grad_params[wk_start + j * d + i], dk * x_i);
        ATOMIC_ADD_FLOAT(grad_params[wv_start + j * d + i], dv * x_i);

        // Bias накапливаем только от потока i == 0, чтобы не считать d раз.
        if (i == 0u) {
            ATOMIC_ADD_FLOAT(grad_params[bq_start + j], dq);
            ATOMIC_ADD_FLOAT(grad_params[bk_start + j], dk);
            ATOMIC_ADD_FLOAT(grad_params[bv_start + j], dv);
        }
    }

    gi[tok_base + i * pc.batch] = gi_i;
}