// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_grad_bo.comp
//
// grad_bo[k] = Σ_{r,t} go_h[r,t,k]
//
// Один поток на k. Цикл по (r,t).
//
// Push: [batch, seq, d_model]  (12 байт)
// Dispatch: d_model потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf       { float go[]; };
layout(binding = 1, std430) writeonly buffer GradBoBuf  { float grad_bo[]; };

void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= pc.d_model) return;

    float sum = 0.0;
    for (uint t = 0u; t < pc.seq; ++t) {
        uint base = (t * pc.d_model) * pc.batch;
        for (uint r = 0u; r < pc.batch; ++r) {
            sum += go[base + k * pc.batch + r];
        }
    }
    grad_bo[k] = sum;
}