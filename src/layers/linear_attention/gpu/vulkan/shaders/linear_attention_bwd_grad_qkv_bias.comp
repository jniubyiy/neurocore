// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_grad_qkv_bias.comp
//
//   grad_bq[j] = Σ_{r,t} d_q_raw[r,t,j]
//   grad_bk[j] = Σ_{r,t} d_k_raw[r,t,j]
//   grad_bv[j] = Σ_{r,t} d_v[r,t,j]
//
// Один поток на j. Цикл по (r,t).
//
// Push: [batch, seq, d_head]  (12 байт)
// Dispatch: d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer DQRawBuf     { float d_q_raw[]; };
layout(binding = 1, std430) readonly buffer DKRawBuf     { float d_k_raw[]; };
layout(binding = 2, std430) readonly buffer DVBuf        { float d_v[]; };
layout(binding = 3, std430) writeonly buffer GradBqBuf   { float grad_bq[]; };
layout(binding = 4, std430) writeonly buffer GradBkBuf   { float grad_bk[]; };
layout(binding = 5, std430) writeonly buffer GradBvBuf   { float grad_bv[]; };

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.d_head) return;

    float sq = 0.0;
    float sk = 0.0;
    float sv = 0.0;
    for (uint t = 0u; t < pc.seq; ++t) {
        uint base = (t * pc.d_head) * pc.batch;
        for (uint r = 0u; r < pc.batch; ++r) {
            sq += d_q_raw[base + j * pc.batch + r];
            sk += d_k_raw[base + j * pc.batch + r];
            sv += d_v    [base + j * pc.batch + r];
        }
    }
    grad_bq[j] = sq;
    grad_bk[j] = sk;
    grad_bv[j] = sv;
}