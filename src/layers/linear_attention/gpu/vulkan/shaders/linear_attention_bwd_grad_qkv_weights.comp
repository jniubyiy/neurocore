// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_grad_qkv_weights.comp
//
//   grad_Wq[j,i] = Σ_{r,t} d_q_raw[r,t,j] · x[r,t,i]
//   grad_Wk[j,i] = Σ_{r,t} d_k_raw[r,t,j] · x[r,t,i]
//   grad_Wv[j,i] = Σ_{r,t} d_v[r,t,j]     · x[r,t,i]
//
// Один поток на (j,i). Цикл по (r,t).
// Прямое присваивание — каждый (j,i) пишется одним потоком.
//
// Раскладка W-матриц: row-major, (d_head × d_model): w[j * d_model + i].
//
// Push: [batch, seq, d_head, d_model]  (16 байт)
// Dispatch: d_head · d_model потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer DQRawBuf     { float d_q_raw[]; };
layout(binding = 1, std430) readonly buffer DKRawBuf     { float d_k_raw[]; };
layout(binding = 2, std430) readonly buffer DVBuf        { float d_v[]; };
layout(binding = 3, std430) readonly buffer XBuf         { float x[]; };
layout(binding = 4, std430) writeonly buffer GradWqBuf   { float grad_wq[]; };
layout(binding = 5, std430) writeonly buffer GradWkBuf   { float grad_wk[]; };
layout(binding = 6, std430) writeonly buffer GradWvBuf   { float grad_wv[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.d_head * pc.d_model) return;

    uint j = idx / pc.d_model;
    uint i = idx % pc.d_model;

    float sq = 0.0;
    float sk = 0.0;
    float sv = 0.0;
    for (uint t = 0u; t < pc.seq; ++t) {
        uint head_base = (t * pc.d_head) * pc.batch;
        uint in_base   = (t * pc.d_model) * pc.batch;
        for (uint r = 0u; r < pc.batch; ++r) {
            float xv = x[in_base + i * pc.batch + r];
            sq += d_q_raw[head_base + j * pc.batch + r] * xv;
            sk += d_k_raw[head_base + j * pc.batch + r] * xv;
            sv += d_v    [head_base + j * pc.batch + r] * xv;
        }
    }
    grad_wq[idx] = sq;
    grad_wk[idx] = sk;
    grad_wv[idx] = sv;
}