// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_grad_wo.comp
//
// Градиенты выходного линейного слоя LinearAttention.
//
// Один поток на (токен, j).
//
//   grad_bo[j]     += go[tok,j]
//   grad_Wo[j,i]   += go[tok,j] · attn_out[tok,i]   (для всех i)
//
// Смещения в grad_params:
//   W_q:  [0, d²)
//   b_q:  [d², d² + d)
//   W_k:  [d² + d, 2d² + d)
//   b_k:  [2d² + d, 2d² + 2d)
//   W_v:  [2d² + 2d, 3d² + 2d)
//   b_v:  [3d² + 2d, 3d² + 3d)
//   W_o:  [3d² + 3d, 4d² + 3d)
//   b_o:  [4d² + 3d, 4d² + 4d)
//
// Push: batch, seq_len, d_model.
// Dispatch: (batch · seq_len) · d_model потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf         { float go[]; };
layout(binding = 1, std430) readonly buffer AttnOutBuf    { float attn_out[]; };
layout(binding = 2, std430) buffer GradParamsBuf          { uint grad_params[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint d = pc.d_model;
    uint token_count = pc.batch * pc.seq_len;
    uint total = token_count * d;
    if (gid >= total) return;

    uint tok = gid / d;
    uint j = gid % d;

    uint r = tok % pc.batch;
    uint t = tok / pc.batch;
    uint tok_base = (t * d) * pc.batch + r;

    uint d2 = d * d;
    uint wo_start = 3u * d2 + 3u * d;
    uint bo_start = wo_start + d2;

    float go_j = go[tok_base + j * pc.batch];
    ATOMIC_ADD_FLOAT(grad_params[bo_start + j], go_j);

    for (uint i = 0u; i < d; ++i) {
        float ao_i = attn_out[tok_base + i * pc.batch];
        ATOMIC_ADD_FLOAT(grad_params[wo_start + j * d + i], go_j * ao_i);
    }
}