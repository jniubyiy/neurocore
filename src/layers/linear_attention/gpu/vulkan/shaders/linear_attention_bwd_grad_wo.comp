// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_grad_wo.comp
//
// grad_Wo[k,i] = Σ_{r,t} go_h[r,t,k] · attn[r,t,i]
//
// Один поток на (k,i). Цикл по (r,t).
// Прямое присваивание (без атомики) — каждый (k,i) пишется одним потоком.
//
// Push: [batch, seq, d_head, d_model]  (16 байт)
// Dispatch: d_model · d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf       { float go[]; };
layout(binding = 1, std430) readonly buffer AttnBuf     { float attn[]; };
layout(binding = 2, std430) writeonly buffer GradWoBuf  { float grad_wo[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.d_model * pc.d_head) return;

    uint k = idx / pc.d_head;
    uint i = idx % pc.d_head;

    float sum = 0.0;
    for (uint t = 0u; t < pc.seq; ++t) {
        uint go_base   = (t * pc.d_model) * pc.batch;
        uint attn_base = (t * pc.d_head)  * pc.batch;
        for (uint r = 0u; r < pc.batch; ++r) {
            sum += go[go_base + k * pc.batch + r]
                 * attn[attn_base + i * pc.batch + r];
        }
    }
    grad_wo[idx] = sum;
}