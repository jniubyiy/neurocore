// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_main.comp
//
// Первый этап обратного прохода LinearAttention в column-major раскладке.
//
// Вход:  go (batch, seq_len * d_model), column-major
//        q_phi (batch, seq_len * d_model), column-major
//        kv (d_model, d_model), column-major: kv[i * d + l] = KV[l, i]
//        z (d_model,)
//        w_o (d_model, d_model), row-major
//
// Выход: d_attn_out (batch*seq_len, d_model), column-major,
//                    элемент (token_idx, i) по адресу i * token_count + token_idx
//        d_q_phi (batch, seq_len * d_model), column-major
//        d_kv (d_model, d_model), column-major, атомарное накопление
//        d_z (d_model,), атомарное накопление
//
// Математика:
//   denom[r,t]           = eps + Σ_l q_phi[r,t,l] * z[l]
//   attn_out[r,t,i]      = (Σ_l q_phi[r,t,l] * KV[l,i]) / denom[r,t]
//   d_attn_out[r,t,i]    = Σ_j go[r,t,j] * W_o[j,i]
//
//   d_q_phi[r,t,l]       = Σ_i d_attn_out[r,t,i] *
//                          (KV[l,i]/denom[r,t] - attn_out[r,t,i]*z[l]/denom[r,t]^2)
//   d_KV[l,i]           += Σ_{r,t} d_attn_out[r,t,i] * q_phi[r,t,l] / denom[r,t]
//   d_z[l]              += -Σ_{r,t} ( q_phi[r,t,l]/denom[r,t] *
//                                      Σ_i d_attn_out[r,t,i]*attn_out[r,t,i] )
//
// Push: batch, seq_len, d_model.
// Dispatch: batch * seq_len потоков.
// d_kv и d_z должны быть предварительно обнулены на хосте.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf {
    float go[];
};

layout(binding = 1, std430) readonly buffer WoBuf {
    float w_o[];
};

layout(binding = 2, std430) readonly buffer QPhiBuf {
    float q_phi[];
};

layout(binding = 3, std430) readonly buffer KVBuf {
    float kv[];
};

layout(binding = 4, std430) readonly buffer ZBuf {
    float z[];
};

layout(binding = 5, std430) writeonly buffer DAttnOutBuf {
    float d_attn_out[];
};

layout(binding = 6, std430) writeonly buffer DQPhiBuf {
    float d_q_phi[];
};

layout(binding = 7, std430) buffer DKVBuf {
    uint d_kv[];
};

layout(binding = 8, std430) buffer DZBuf {
    uint d_z[];
};

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint token_idx = gl_GlobalInvocationID.x;
    uint token_count = pc.batch * pc.seq_len;
    if (token_idx >= token_count) return;

    uint d = pc.d_model;

    const uint MAX_D = 256u;
    if (d > MAX_D) return;

    uint r = token_idx / pc.seq_len;
    uint t = token_idx % pc.seq_len;

    // База для (r, t) в column-major буферах q_phi, go, d_q_phi.
    // Элемент (r, t, k) лежит по адресу (t*d + k) * batch + r,
    // поэтому для фиксированных (r, t) шаг по k равен batch.
    uint tok_base = (t * d) * pc.batch + r;

    // ===== 1. Пересчёт denom и attn_out, вычисление d_attn_out =====
    float eps = 1e-6;
    float denom = eps;
    for (uint l = 0u; l < d; ++l) {
        float q_l = q_phi[tok_base + l * pc.batch];
        denom += q_l * z[l];
    }
    float inv_denom = 1.0 / denom;
    float inv_denom_sq = inv_denom * inv_denom;

    float attn_out_local[MAX_D];
    float d_attn_out_local[MAX_D];

    for (uint i = 0u; i < d; ++i) {
        float num = 0.0;
        for (uint l = 0u; l < d; ++l) {
            float q_l = q_phi[tok_base + l * pc.batch];
            num += q_l * kv[i * d + l];
        }
        attn_out_local[i] = num * inv_denom;

        float sum_j = 0.0;
        for (uint j = 0u; j < d; ++j) {
            float go_j = go[tok_base + j * pc.batch];
            sum_j += go_j * w_o[j * d + i];
        }
        d_attn_out_local[i] = sum_j;
        d_attn_out[i * token_count + token_idx] = sum_j;
    }

    // ===== 2. Вычисление d_q_phi и атомарное накопление d_kv, d_z =====
    for (uint l = 0u; l < d; ++l) {
        float q_l = q_phi[tok_base + l * pc.batch];

        float dq_l = 0.0;
        float sum_da_ao = 0.0;

        for (uint i = 0u; i < d; ++i) {
            float da = d_attn_out_local[i];
            float ao = attn_out_local[i];
            float kv_li = kv[i * d + l];

            dq_l += da * (kv_li * inv_denom - ao * z[l] * inv_denom_sq);
            sum_da_ao += da * ao;

            float d_kv_contrib = da * q_l * inv_denom;
            ATOMIC_ADD_FLOAT(d_kv[i * d + l], d_kv_contrib);
        }

        d_q_phi[tok_base + l * pc.batch] = dq_l;

        float d_z_contrib = -q_l * inv_denom * sum_da_ao;
        ATOMIC_ADD_FLOAT(d_z[l], d_z_contrib);
    }
}