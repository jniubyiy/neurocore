#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf {
    float go[];          // (batch * seq_len) x d_model, row-major
};

layout(binding = 1, std430) readonly buffer WoBuf {
    float w_o[];         // d_model x d_model, row-major
};

layout(binding = 2, std430) readonly buffer QPhiBuf {
    float q_phi[];       // (batch * seq_len) x d_model, row-major
};

layout(binding = 3, std430) readonly buffer KVBuf {
    float kv[];          // d_model x d_model, row-major
};

layout(binding = 4, std430) readonly buffer ZBuf {
    float z[];           // d_model
};

layout(binding = 5, std430) writeonly buffer DAttnOutBuf {
    float d_attn_out[];  // (batch * seq_len) x d_model, row-major
};

layout(binding = 6, std430) writeonly buffer DQPhiBuf {
    float d_q_phi[];     // (batch * seq_len) x d_model, row-major
};

layout(binding = 7, std430) buffer DKVBuf {
    uint d_kv[];         // d_model x d_model, битовое представление float
};

layout(binding = 8, std430) buffer DZBuf {
    uint d_z[];          // d_model, битовое представление float
};

// Вспомогательная функция атомарного сложения float
void atomicAddFloat(inout uint target, float value) {
    uint expected = target;
    uint desired;
    do {
        float cur = uintBitsToFloat(expected);
        desired = floatBitsToUint(cur + value);
        uint old = atomicCompSwap(target, expected, desired);
        if (old == expected) return;
        expected = old;
    } while (true);
}

void main() {
    uint token_idx = gl_GlobalInvocationID.x; // глобальный индекс токена (0..total_tokens-1)
    uint total_tokens = pc.batch * pc.seq_len;
    if (token_idx >= total_tokens) return;

    uint d = pc.d_model;
    uint base = token_idx * d;
    float eps = 1e-6;

    // 1. Вычислить denom для этого токена
    float denom = eps;
    for (uint l = 0; l < d; l++) {
        denom += q_phi[base + l] * z[l];
    }
    float inv_denom = 1.0 / denom;
    float inv_denom_sq = inv_denom * inv_denom;

    // 2. Вычислить attn_out для всех i и d_attn_out для всех i
    //    Для хранения временных массивов используем локальные массивы фиксированного размера (до 64?).
    //    Так как d_model может быть > 64, мы не можем объявить массивы произвольного размера в GLSL.
    //    Вместо этого используем повторные вычисления без хранения всех значений.
    //    Однако для формулы d_q_phi нужны attn_out[token,i] для всех i, а d_kv и d_z суммируются по i.
    //    Мы можем вычислить d_attn_out[token,i] на лету и сразу использовать в суммировании d_q_phi.
    //    Но для d_q_phi[l] необходимо сначала получить все d_attn_out и attn_out по i.
    //    Поэтому для каждого l придётся заново вычислять attn_out[i] и d_attn_out[i]? Это O(d^2) на токен, но d обычно невелик.
    //    Ради простоты и корректности примем ограничение: d_model <= 256.
    //    Если d_model > 256, шейдер не скомпилируется или будет переполнен.
    //    Для данного проекта d_model обычно не превышает 256, так что приемлемо.

    // Объявим массивы максимального размера 256. Если d_model больше, шейдер не сработает корректно,
    // но можно поменять константу. Для гибкости используем #define MAX_D 256 и проверку.
    // В GLSL нельзя динамически объявлять массивы переменной длины, поэтому используем фиксированный размер.

    const uint MAX_D = 256u;
    if (d > MAX_D) {
        return; // не поддерживается
    }

    float attn_out[MAX_D];
    float d_attn_out_local[MAX_D];

    // Вычислим attn_out и d_attn_out для всех i
    for (uint i = 0; i < d; i++) {
        float sum_l = 0.0;
        for (uint l = 0; l < d; l++) {
            sum_l += q_phi[base + l] * kv[l * d + i];
        }
        attn_out[i] = sum_l * inv_denom;

        float sum_j = 0.0;
        for (uint j = 0; j < d; j++) {
            sum_j += go[base + j] * w_o[j * d + i];
        }
        d_attn_out_local[i] = sum_j;
        d_attn_out[base + i] = sum_j;
    }

    // 3. Вычислить d_q_phi[l] и атомарно накопить d_kv, d_z
    for (uint l = 0; l < d; l++) {
        float q_l = q_phi[base + l];

        // d_q_phi[l]
        float sum_i = 0.0;
        for (uint i = 0; i < d; i++) {
            float val = d_attn_out_local[i] * (kv[l * d + i] * inv_denom - attn_out[i] * z[l] * inv_denom_sq);
            sum_i += val;

            // d_kv[l,i] += d_attn_out[i] * q_l * inv_denom
            float d_kv_contrib = d_attn_out_local[i] * q_l * inv_denom;
            atomicAddFloat(d_kv[l * d + i], d_kv_contrib);

            // d_z[l] += d_attn_out[i] * (-attn_out[i] * q_l * inv_denom_sq)
            float d_z_contrib = -d_attn_out_local[i] * attn_out[i] * q_l * inv_denom_sq;
            atomicAddFloat(d_z[l], d_z_contrib);
        }
        d_q_phi[base + l] = sum_i;
    }
}