// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_params.comp
//
// Второй этап обратного прохода LinearAttention в column-major раскладке.
//
// Вход:
//   x        (batch, seq_len * d_model), column-major
//   go       (batch, seq_len * d_model), column-major
//   params   содержит Wq, bq, Wk, bk, Wv, bv, Wo, bo (row-major для весов)
//   q_phi    (batch, seq_len * d_model), column-major
//   k_phi    (batch, seq_len * d_model), column-major
//   v        (batch, seq_len * d_model), column-major
//   q_raw    (batch, seq_len * d_model), column-major
//   k_raw    (batch, seq_len * d_model), column-major
//   d_q_phi  (batch, seq_len * d_model), column-major — из bwd_main
//   d_kv     (d_model, d_model), column-major, атомарное накопление — из bwd_main
//   d_z      (d_model,), атомарное накопление — из bwd_main
//   kv, z    — из forward
//
// Выход:
//   gi            (batch, seq_len * d_model), column-major
//   grad_params   — градиенты Wq, bq, Wk, bk, Wv, bv, Wo, bo (атомарно)
//
// Математика:
//   denom[r,t]      = eps + Σ_l q_phi[r,t,l] * z[l]
//   attn_out[r,t,i] = (Σ_l q_phi[r,t,l] * KV[l,i]) / denom[r,t]
//
//   d_attn_out[r,t,i] = Σ_j go[r,t,j] * Wo[j,i]
//
//   d_k_phi[r,t,l] = d_z[l] + Σ_i d_KV[l,i] * v[r,t,i]
//   d_v[r,t,i]     = Σ_l d_KV[l,i] * k_phi[r,t,l]
//
//   d_q_raw[r,t,l] = d_q_phi[r,t,l] * φ'(q_raw[r,t,l])
//   d_k_raw[r,t,l] = d_k_phi[r,t,l] * φ'(k_raw[r,t,l])
//
//   gi[r,t,i] = Σ_j ( d_q_raw[r,t,j] * Wq[j,i]
//                  + d_k_raw[r,t,j] * Wk[j,i]
//                  + d_v[r,t,j]     * Wv[j,i] )
//
//   grad_Wq[j,i] += d_q_raw[r,t,j] * x[r,t,i]
//   grad_bq[j]   += d_q_raw[r,t,j]
//   (аналогично для Wk, Wv, bq, bk, bv)
//
//   grad_Wo[j,i] += go[r,t,j] * attn_out[r,t,i]
//   grad_bo[j]   += go[r,t,j]
//
// Push: batch, seq_len, d_model.
// Dispatch: batch * seq_len потоков (один поток на токен).
// grad_params должен быть предварительно обнулён на хосте.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GoBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[];
};

layout(binding = 3, std430) readonly buffer QPhiBuf {
    float q_phi[];
};

layout(binding = 4, std430) readonly buffer KPhiBuf {
    float k_phi[];
};

layout(binding = 5, std430) readonly buffer VBuf {
    float v[];
};

layout(binding = 6, std430) readonly buffer QRawBuf {
    float q_raw[];
};

layout(binding = 7, std430) readonly buffer KRawBuf {
    float k_raw[];
};

layout(binding = 8, std430) readonly buffer DQPhiBuf {
    float d_q_phi[];
};

layout(binding = 9, std430) readonly buffer DKVBuf {
    uint d_kv[];
};

layout(binding = 10, std430) readonly buffer DZBuf {
    uint d_z[];
};

layout(binding = 11, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 12, std430) buffer GradParamsBuf {
    uint grad_params[];
};

layout(binding = 13, std430) readonly buffer KVBuf {
    float kv[];
};

layout(binding = 14, std430) readonly buffer ZBuf {
    float z[];
};

#define MAX_D 256u

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

// Производная φ(x) = ELU(x) + 1:
//   φ'(x) = 1     при x > 0
//   φ'(x) = exp(x) при x <= 0
float phi_derivative(float x) {
    return (x > 0.0) ? 1.0 : exp(x);
}

void main() {
    uint token_idx = gl_GlobalInvocationID.x;
    uint token_count = pc.batch * pc.seq_len;
    if (token_idx >= token_count) return;

    uint d = pc.d_model;
    if (d > MAX_D) return;

    uint r = token_idx / pc.seq_len;
    uint t = token_idx % pc.seq_len;

    // База для (r, t) в column-major буферах: элемент (r, t, k)
    // лежит по адресу (t*d + k) * batch + r = tok_base + k * batch.
    uint tok_base = (t * d) * pc.batch + r;

    // Смещения параметров в плоском буфере.
    uint wq_start = 0u;
    uint bq_start = wq_start + d * d;
    uint wk_start = bq_start + d;
    uint bk_start = wk_start + d * d;
    uint wv_start = bk_start + d;
    uint bv_start = wv_start + d * d;
    uint wo_start = bv_start + d;
    uint bo_start = wo_start + d * d;

    // ---------- 1. denom и inv_denom ----------
    float eps = 1e-6;
    float denom = eps;
    for (uint l = 0u; l < d; ++l) {
        float q_l = q_phi[tok_base + l * pc.batch];
        denom += q_l * z[l];
    }
    float inv_denom = 1.0 / denom;

    // ---------- 2. attn_out и d_attn_out ----------
    float attn_out_local[MAX_D];
    float d_attn_out_local[MAX_D];

    for (uint i = 0u; i < d; ++i) {
        float num = 0.0;
        for (uint l = 0u; l < d; ++l) {
            float q_l = q_phi[tok_base + l * pc.batch];
            num += q_l * kv[i * d + l];
        }
        attn_out_local[i] = num * inv_denom;

        float sum_j = 0.0;
        for (uint j = 0u; j < d; ++j) {
            float go_j = go[tok_base + j * pc.batch];
            sum_j += go_j * params[wo_start + j * d + i];
        }
        d_attn_out_local[i] = sum_j;
    }

    // ---------- 3. grad_Wo, grad_bo ----------
    for (uint j = 0u; j < d; ++j) {
        float go_j = go[tok_base + j * pc.batch];
        ATOMIC_ADD_FLOAT(grad_params[bo_start + j], go_j);
        for (uint i = 0u; i < d; ++i) {
            ATOMIC_ADD_FLOAT(
                grad_params[wo_start + j * d + i],
                go_j * attn_out_local[i]
            );
        }
    }

    // ---------- 4. d_k_phi и d_v ----------
    // d_k_phi[l] = d_z[l] + Σ_i d_KV[l,i] * v[i]
    // d_v[i]     = Σ_l d_KV[l,i] * k_phi[l]
    //
    // В column-major: d_KV[l,i] хранится в d_kv[i*d + l].
    float d_k_phi_local[MAX_D];
    float d_v_local[MAX_D];

    for (uint l = 0u; l < d; ++l) {
        float sum_k = uintBitsToFloat(d_z[l]);
        for (uint i = 0u; i < d; ++i) {
            float v_i = v[tok_base + i * pc.batch];
            sum_k += uintBitsToFloat(d_kv[i * d + l]) * v_i;
        }
        d_k_phi_local[l] = sum_k;
    }

    for (uint i = 0u; i < d; ++i) {
        float sum_v = 0.0;
        for (uint l = 0u; l < d; ++l) {
            float k_l = k_phi[tok_base + l * pc.batch];
            sum_v += uintBitsToFloat(d_kv[i * d + l]) * k_l;
        }
        d_v_local[i] = sum_v;
    }

    // ---------- 5. gi и градиенты параметров Q, K, V ----------
    float gi_local[MAX_D];
    for (uint i = 0u; i < d; ++i) {
        gi_local[i] = 0.0;
    }

    for (uint j = 0u; j < d; ++j) {
        float qr = q_raw[tok_base + j * pc.batch];
        float kr = k_raw[tok_base + j * pc.batch];
        float dq_phi = d_q_phi[tok_base + j * pc.batch];
        float dk_phi = d_k_phi_local[j];
        float dv_j = d_v_local[j];

        float dq = dq_phi * phi_derivative(qr);
        float dk = dk_phi * phi_derivative(kr);

        // Градиенты bias: Σ_{r,t} d_q_raw[r,t,j], и т.д.
        ATOMIC_ADD_FLOAT(grad_params[bq_start + j], dq);
        ATOMIC_ADD_FLOAT(grad_params[bk_start + j], dk);
        ATOMIC_ADD_FLOAT(grad_params[bv_start + j], dv_j);

        for (uint i = 0u; i < d; ++i) {
            float x_val = x[tok_base + i * pc.batch];

            // grad_Wq[j,i] += d_q_raw[j] * x[i]
            ATOMIC_ADD_FLOAT(
                grad_params[wq_start + j * d + i],
                dq * x_val
            );
            ATOMIC_ADD_FLOAT(
                grad_params[wk_start + j * d + i],
                dk * x_val
            );
            ATOMIC_ADD_FLOAT(
                grad_params[wv_start + j * d + i],
                dv_j * x_val
            );

            // gi[i] += Σ_j (d_q_raw[j]*Wq[j,i] + d_k_raw[j]*Wk[j,i] + d_v[j]*Wv[j,i])
            gi_local[i] += dq * params[wq_start + j * d + i]
                         + dk * params[wk_start + j * d + i]
                         + dv_j * params[wv_start + j * d + i];
        }
    }

    for (uint i = 0u; i < d; ++i) {
        gi[tok_base + i * pc.batch] = gi_local[i];
    }
}