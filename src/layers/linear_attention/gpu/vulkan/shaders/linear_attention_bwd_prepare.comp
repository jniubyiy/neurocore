// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_prepare.comp
//
// Первый этап обратного прохода LinearAttention.
//
// Один поток на токен. Считает:
//   denom[tok]      = eps + Σ_l q_phi[tok,l] · z[l]
//   attn_out[tok,i] = (Σ_l q_phi[tok,l] · kv[i,l]) / denom
//   d_attn_out[tok,i] = Σ_j go[tok,j] · W_o[j,i]
//   dot_da_ao[tok]  = Σ_i d_attn_out[tok,i] · attn_out[tok,i]
//
// Раскладка column-major для активаций (batch столбцов):
//   элемент (r, t, k) лежит по адресу (t·d + k)·batch + r.
//
// Push: batch, seq_len, d_model.
// Dispatch: batch · seq_len потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer QPhiBuf    { float q_phi[]; };
layout(binding = 1, std430) readonly buffer KVBuf      { float kv[]; };
layout(binding = 2, std430) readonly buffer ZBuf       { float z[]; };
layout(binding = 3, std430) readonly buffer GoBuf      { float go[]; };
layout(binding = 4, std430) readonly buffer WoBuf      { float w_o[]; };
layout(binding = 5, std430) writeonly buffer DenomBuf  { float denom[]; };
layout(binding = 6, std430) writeonly buffer AttnOutBuf { float attn_out[]; };
layout(binding = 7, std430) writeonly buffer DAttnOutBuf { float d_attn_out[]; };
layout(binding = 8, std430) writeonly buffer DotDaAoBuf { float dot_da_ao[]; };

void main() {
    uint tok = gl_GlobalInvocationID.x;
    uint token_count = pc.batch * pc.seq_len;
    if (tok >= token_count) return;

    uint d = pc.d_model;
    uint r = tok % pc.batch;
    uint t = tok / pc.batch;
    uint tok_base = (t * d) * pc.batch + r;

    // 1. denom
    float eps = 1e-6;
    float denom_val = eps;
    for (uint l = 0u; l < d; ++l) {
        float q_l = q_phi[tok_base + l * pc.batch];
        denom_val += q_l * z[l];
    }
    float inv_denom = 1.0 / denom_val;
    denom[tok] = denom_val;

    // 2. attn_out, d_attn_out, dot_da_ao
    float dot = 0.0;
    for (uint i = 0u; i < d; ++i) {
        float num = 0.0;
        for (uint l = 0u; l < d; ++l) {
            num += q_phi[tok_base + l * pc.batch] * kv[i * d + l];
        }
        float ao = num * inv_denom;
        attn_out[tok_base + i * pc.batch] = ao;

        float da = 0.0;
        for (uint j = 0u; j < d; ++j) {
            da += go[tok_base + j * pc.batch] * w_o[j * d + i];
        }
        d_attn_out[tok_base + i * pc.batch] = da;

        dot += da * ao;
    }
    dot_da_ao[tok] = dot;
}