// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_bwd_self_bias.comp
//
//   grad_self_bias = Σ_{r,t} d_denom[r,t]
//                  + Σ_{r,t,i} d_num[r,t,i] · v_raw[r,t,i]
//
// Один поток на (r,t). Цикл по i (d_head).
// Накопление в скаляр grad_self_bias[0] — атомарное (CAS).
//
// Push: [batch, seq, d_head]  (12 байт)
// Dispatch: batch · seq потоков.
//
// grad_self_bias должен быть обнулён на CPU перед запуском.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer DDenomBuf   { float d_denom[]; };
layout(binding = 1, std430) readonly buffer DNumBuf     { float d_num[]; };
layout(binding = 2, std430) readonly buffer VRawBuf     { float v_raw[]; };
layout(binding = 3, std430) buffer GradSelfBiasBuf      { uint grad_self_bias[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint rt = gl_GlobalInvocationID.x;
    if (rt >= pc.batch * pc.seq) return;

    uint r = rt % pc.batch;
    uint t = rt / pc.batch;

    uint base = (t * pc.d_head) * pc.batch + r;

    float contrib = d_denom[rt];
    for (uint i = 0u; i < pc.d_head; ++i) {
        uint off = base + i * pc.batch;
        contrib += d_num[off] * v_raw[off];
    }
    ATOMIC_ADD_FLOAT(grad_self_bias[0], contrib);
}