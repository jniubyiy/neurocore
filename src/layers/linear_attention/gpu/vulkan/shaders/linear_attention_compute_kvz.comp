// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_compute_kvz.comp
//
// Вычисление kv = K_phi^T · V и z = K_phi^T · 1 для одной головы.
//
// Один поток на элемент:
//   idx ∈ [0, d_head²):           kv[l, i], где l = idx / d_head, i = idx % d_head
//   idx ∈ [d_head², d_head²+d_head): z[l], где l = idx − d_head²
//
// Раскладка:
//   k_phi (batch, seq, d_head), column-major: k_phi[(t*dh + l) * batch + r]
//   v     (batch, seq, d_head), column-major: v[(t*dh + i) * batch + r]
//   kv    (d_head, d_head), row-major: kv[l * d_head + i]
//   z     (d_head,)
//
// Push: [batch, seq, d_head]  (12 байт)
// Dispatch: d_head² + d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer KBuf { float k_phi[]; };
layout(binding = 1, std430) readonly buffer VBuf { float v[]; };
layout(binding = 2, std430) writeonly buffer KVBuf { float kv[]; };
layout(binding = 3, std430) writeonly buffer ZBuf { float z[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint dh = pc.d_head;
    uint kv_size = dh * dh;
    if (idx >= kv_size + dh) return;

    if (idx < kv_size) {
        uint l = idx / dh;
        uint i = idx % dh;
        float sum = 0.0;
        for (uint t = 0u; t < pc.seq; ++t) {
            uint k_base = (t * dh + l) * pc.batch;
            uint v_base = (t * dh + i) * pc.batch;
            for (uint r = 0u; r < pc.batch; ++r) {
                sum += k_phi[k_base + r] * v[v_base + r];
            }
        }
        kv[l * dh + i] = sum;
    } else {
        uint l = idx - kv_size;
        float sum = 0.0;
        for (uint t = 0u; t < pc.seq; ++t) {
            uint k_base = (t * dh + l) * pc.batch;
            for (uint r = 0u; r < pc.batch; ++r) {
                sum += k_phi[k_base + r];
            }
        }
        z[l] = sum;
    }
}