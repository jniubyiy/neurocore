// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_compute_kvz.comp
//
// Вычисление kv = K_phi^T · V и z = K_phi^T · 1 для одной головы.
//
// FIX: kv и z теперь считаются ПО КАЖДОМУ ПРИМЕРУ r (как в CPU-версии).
// Раньше суммировалось глобально по всему (batch · seq), что делало
// attention глобальным pooling'ом, а не вниманием внутри примера.
//
// Dispatch: batch · (d_head² + d_head) потоков.
//
// idx ∈ [0, batch · (d_head² + d_head)):
//   r     = idx / (d_head² + d_head)
//   local = idx % (d_head² + d_head)
//
//   local ∈ [0, d_head²):        kv[r, l, i], l = local / d_head, i = local % d_head
//   local ∈ [d_head², d_head²+d_head): z[r, l], l = local − d_head²
//
// Раскладка:
//   k_phi (batch, seq, d_head), column-major: k_phi[(t*dh + l) * batch + r]
//   v     (batch, seq, d_head), column-major: v[(t*dh + i) * batch + r]
//   kv    (batch, d_head, d_head), row-major по (l, i), batch в старшем разряде:
//         kv[r * d_head·d_head + l * d_head + i]
//   z     (batch, d_head): z[r * d_head + l]
//
// Push-константы: [batch, seq, d_head]  (12 байт).

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer KBuf { float k_phi[]; };
layout(binding = 1, std430) readonly buffer VBuf { float v[]; };
layout(binding = 2, std430) writeonly buffer KVBuf { float kv[]; };
layout(binding = 3, std430) writeonly buffer ZBuf { float z[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint dh = pc.d_head;
    uint kv_size = dh * dh;
    uint per_example = kv_size + dh;
    if (idx >= pc.batch * per_example) return;

    uint r     = idx / per_example;
    uint local = idx % per_example;

    if (local < kv_size) {
        // kv[r, l, i] = Σ_t k_phi[t, r, l] · v[t, r, i]
        uint l = local / dh;
        uint i = local % dh;
        float sum = 0.0;
        for (uint t = 0u; t < pc.seq; ++t) {
            uint k_base = (t * dh + l) * pc.batch + r;
            uint v_base = (t * dh + i) * pc.batch + r;
            sum += k_phi[k_base] * v[v_base];
        }
        kv[r * kv_size + l * dh + i] = sum;
    } else {
        // z[r, l] = Σ_t k_phi[t, r, l]
        uint l = local - kv_size;
        float sum = 0.0;
        for (uint t = 0u; t < pc.seq; ++t) {
            uint k_base = (t * dh + l) * pc.batch + r;
            sum += k_phi[k_base];
        }
        z[r * dh + l] = sum;
    }
}