// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_compute_kvz.comp
//
// Вычисление матрицы KV = K_phi^T · V и вектора Z = K_phi^T · 1
// для слоя LinearAttention.
//
// Раскладка данных — column-major.
//
// Входы:
//   k_phi: (batch, seq_len * d_model), column-major:
//          k_phi[(t * d_model + i) * batch + r]
//   v:     (batch, seq_len * d_model), column-major:
//          v[(t * d_model + j) * batch + r]
//
// Выходы:
//   kv:    (d_model, d_model), column-major:
//          kv[j * d_model + i] = Σ_{r,t} k_phi[r,t,i] * v[r,t,j]
//   z:     (d_model,), линейный вектор:
//          z[i] = Σ_{r,t} k_phi[r,t,i]
//
// Push-константы: batch, seq_len, d_model
// Dispatch: d_model * d_model + d_model потоков.
//
// Индексация:
//   idx ∈ [0, d²)           → KV[i, j], где i = idx % d, j = idx / d
//                             (тогда kv[idx] = kv[j*d + i] напрямую)
//   idx ∈ [d², d² + d)      → Z[i], где i = idx - d²

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer KPhiBuf {
    float k_phi[];
};

layout(binding = 1, std430) readonly buffer VBuf {
    float v[];
};

layout(binding = 2, std430) writeonly buffer KVBuf {
    float kv[];
};

layout(binding = 3, std430) writeonly buffer ZBuf {
    float z[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint d = pc.d_model;
    uint kv_size = d * d;
    uint total = kv_size + d;

    if (idx >= total) return;

    if (idx < kv_size) {
        // Вычисляем KV[i, j], где i = idx % d (строка), j = idx / d (столбец).
        // kv[idx] = kv[j * d + i] — линейная запись в column-major.
        uint i = idx % d;
        uint j = idx / d;

        float sum = 0.0;
        for (uint t = 0u; t < pc.seq_len; ++t) {
            uint k_base = (t * d + i) * pc.batch;
            uint v_base = (t * d + j) * pc.batch;
            for (uint r = 0u; r < pc.batch; ++r) {
                sum += k_phi[k_base + r] * v[v_base + r];
            }
        }
        kv[idx] = sum;
    } else {
        // Вычисляем Z[i] для i = idx - d².
        uint i = idx - kv_size;

        float sum = 0.0;
        for (uint t = 0u; t < pc.seq_len; ++t) {
            uint k_base = (t * d + i) * pc.batch;
            for (uint r = 0u; r < pc.batch; ++r) {
                sum += k_phi[k_base + r];
            }
        }
        z[i] = sum;
    }
}