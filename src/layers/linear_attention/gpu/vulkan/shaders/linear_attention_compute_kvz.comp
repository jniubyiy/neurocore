#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer KPhiBuf {
    float k_phi[];   // row-major: (batch * seq_len) x d_model
};

layout(binding = 1, std430) readonly buffer VBuf {
    float v[];       // row-major: (batch * seq_len) x d_model
};

layout(binding = 2, std430) writeonly buffer KVBuf {
    float kv[];      // d_model x d_model
};

layout(binding = 3, std430) writeonly buffer ZBuf {
    float z[];       // d_model
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_tokens = pc.batch * pc.seq_len;
    uint kv_size = pc.d_model * pc.d_model;
    uint z_size = pc.d_model;

    if (idx < kv_size) {
        // Вычисляем KV[i,j]
        uint i = idx / pc.d_model; // строка KV (компонента K)
        uint j = idx % pc.d_model; // столбец KV (компонента V)

        float sum = 0.0;
        for (uint t = 0; t < total_tokens; ++t) {
            float k_val = k_phi[t * pc.d_model + i];
            float v_val = v[t * pc.d_model + j];
            sum += k_val * v_val;
        }
        kv[idx] = sum;
    } else if (idx < kv_size + z_size) {
        // Вычисляем Z[z_idx]
        uint z_idx = idx - kv_size;

        float sum = 0.0;
        for (uint t = 0; t < total_tokens; ++t) {
            sum += k_phi[t * pc.d_model + z_idx];
        }
        z[z_idx] = sum;
    }
}