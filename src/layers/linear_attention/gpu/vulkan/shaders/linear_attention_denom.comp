// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_denom.comp
//
// Вычисление знаменателя attention с обучаемым self_bias:
//
//   denom[r,t] = eps + self_bias + Σ_l q_phi[r,t,l] · z[r, l]
//
// FIX: z теперь per-example: z[r · d_head + l].
//
// Один поток на (r, t). Цикл по l (d_head).
//
// Раскладка:
//   q_phi (batch, seq, d_head), column-major: q_phi[(t*dh + l) * batch + r]
//   z     (batch, d_head):                    z[r * d_head + l]
//   denom (batch, seq), column-major:         denom[t * batch + r]
//
// Push: [batch, seq, d_head, self_bias_bits]  (16 байт)
// Dispatch: batch · seq потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
    float self_bias;
} pc;

layout(binding = 0, std430) readonly buffer QPhiBuf { float q_phi[]; };
layout(binding = 1, std430) readonly buffer ZBuf { float z[]; };
layout(binding = 2, std430) writeonly buffer DenomBuf { float denom[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq) return;

    uint r = idx % pc.batch;
    uint t = idx / pc.batch;

    float sum = 1e-6 + pc.self_bias;
    uint q_base = (t * pc.d_head) * pc.batch + r;
    uint z_r = r * pc.d_head;
    for (uint l = 0u; l < pc.d_head; ++l) {
        sum += q_phi[q_base + l * pc.batch] * z[z_r + l];
    }
    denom[idx] = sum;
}