// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_fwd.comp
//
// Прямой проход одной головы LinearAttention: вычисление attn.
//
//   num[r,t,i]  = self_bias · v[r,t,i] + Σ_l q_phi[r,t,l] · kv[l, i]
//   attn[r,t,i] = num[r,t,i] / denom[r,t]
//
// Один поток на (r, t, i). Цикл по l (d_head).
//
// Раскладка:
//   q_phi (batch, seq, d_head), column-major
//   v     (batch, seq, d_head), column-major
//   kv    (d_head, d_head), row-major: kv[l * d_head + i]
//   denom (batch, seq), column-major
//   attn  (batch, seq, d_head), column-major
//
// Push: [batch, seq, d_head, self_bias_bits]  (16 байт)
// Dispatch: batch · seq · d_head потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq;
    uint d_head;
    float self_bias;
} pc;

layout(binding = 0, std430) readonly buffer QPhiBuf { float q_phi[]; };
layout(binding = 1, std430) readonly buffer VBuf { float v[]; };
layout(binding = 2, std430) readonly buffer KVBuf { float kv[]; };
layout(binding = 3, std430) readonly buffer DenomBuf { float denom[]; };
layout(binding = 4, std430) writeonly buffer AttnBuf { float attn[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i = tmp % pc.d_head;
    uint t = tmp / pc.d_head;

    uint tok = t * pc.batch + r;
    float inv_denom = 1.0 / denom[tok];

    uint base = (t * pc.d_head) * pc.batch + r;
    float num = pc.self_bias * v[base + i * pc.batch];
    for (uint l = 0u; l < pc.d_head; ++l) {
        num += q_phi[base + l * pc.batch] * kv[l * pc.d_head + i];
    }

    attn[idx] = num * inv_denom;
}