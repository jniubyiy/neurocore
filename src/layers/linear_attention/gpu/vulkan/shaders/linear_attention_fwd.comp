#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer QPhiBuf {
    float q_phi[];   // row-major: (batch * seq_len) x d_model
};

layout(binding = 1, std430) readonly buffer KPhiBuf {
    float k_phi[];   // row-major: (batch * seq_len) x d_model (не используется в forward)
};

layout(binding = 2, std430) readonly buffer VBuf {
    float v[];       // row-major: (batch * seq_len) x d_model (не используется в forward)
};

layout(binding = 3, std430) readonly buffer KVBuf {
    float kv[];      // d_model x d_model (row-major)
};

layout(binding = 4, std430) readonly buffer ZBuf {
    float z[];       // d_model
};

layout(binding = 5, std430) readonly buffer WoBuf {
    float w_o[];     // d_model x d_model (row-major, индексация как w_o[j*d_model + i])
};

layout(binding = 6, std430) readonly buffer BoBuf {
    float b_o[];     // d_model
};

layout(binding = 7, std430) writeonly buffer OutBuf {
    float y[];       // row-major: (batch * seq_len) x d_model
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.seq_len * pc.d_model;
    if (idx >= total) return;

    uint d = pc.d_model;
    uint seq_total = pc.seq_len;
    uint batch_total = pc.batch;
    uint tokens_per_batch = seq_total; // количество токенов в одном примере

    // Определяем индекс токена (глобальный по всем батчам) и j
    uint token_idx = idx / d;         // индекс токена среди всех batch*seq_len токенов
    uint j = idx % d;                 // номер выходного признака

    // Вычисляем denom для данного токена: sum_i q_phi[token_idx*d + i] * z[i] + eps
    float eps = 1e-6;
    float denom = eps;
    // базовый указатель на q_phi для этого токена
    uint q_base = token_idx * d;
    for (uint i = 0; i < d; ++i) {
        denom += q_phi[q_base + i] * z[i];
    }

    // Вычисляем attn_out[token_idx, i] для всех i? Но нам нужно только для текущего j.
    // Однако attn_out зависит от KV и Q. Для y[token_idx, j] нужно:
    // attn_out[token_idx, i] для всех i, так как y = sum_i attn_out[token_idx, i] * w_o[j, i] + b_o[j]
    // Но attn_out[token_idx, i] = sum_l q_phi[token_idx, l] * kv[l, i] / denom
    // Подставим: y[token_idx, j] = sum_i (sum_l q_phi[token_idx, l] * kv[l, i] / denom) * w_o[j, i] + b_o[j]
    // = (1/denom) * sum_l q_phi[token_idx, l] * (sum_i kv[l, i] * w_o[j, i]) + b_o[j]

    // Можно вычислить эффективнее, если заранее посчитать матрицу temp[l,j] = sum_i kv[l,i]*w_o[j,i],
    // но для простоты сделаем двойной цикл внутри одного потока (неэффективно, но работает).
    float y_val = b_o[j];
    for (uint l = 0; l < d; ++l) {
        float q_l = q_phi[q_base + l];
        // Для каждого l суммируем по i: kv[l*d + i] * w_o[j*d + i]
        float sum_i = 0.0;
        for (uint i = 0; i < d; ++i) {
            sum_i += kv[l * d + i] * w_o[j * d + i];
        }
        y_val += q_l * sum_i / denom;
    }

    y[idx] = y_val;
}