// src/layers/linear_attention/gpu/vulkan/shaders/linear_attention_linear_per_token.comp
//
// Per-token линейное преобразование для слоя LinearAttention.
//
// Применяет матрицу весов W (out_features × in_features) и смещение b (out_features)
// независимо к каждому токену входного тензора.
//
// Раскладка данных — column-major, соответствующая общему стилю проекта.
//
// Вход:  (batch, seq_len * in_features), column-major:
//        x[(t * in_features + i) * batch + r]
// Веса:  (out_features, in_features), row-major:
//        w[j * in_features + i]
// Bias:  (out_features,):
//        b[j]
// Выход: (batch, seq_len * out_features), column-major:
//        y[(t * out_features + j) * batch + r]
//
// Формула для каждого (r, t, j):
//   y[r, t, j] = b[j] + Σ_i x[r, t, i] * w[j, i]
//
// Параллелизация: total = batch * seq_len * out_features потоков,
// каждый обрабатывает один выходной элемент.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer WeightBuf {
    float w[];
};

layout(binding = 2, std430) readonly buffer BiasBuf {
    float b[];
};

layout(binding = 3, std430) writeonly buffer OutputBuf {
    float y[];
};

void main() {
    uint total = pc.batch * pc.seq_len * pc.out_features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    // Восстанавливаем координаты (r, t, j) из column-major индекса.
    // idx = (t * out_features + j) * batch + r
    uint r   = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint j   = tmp % pc.out_features;
    uint t   = tmp / pc.out_features;

    uint in_base = t * pc.in_features;
    uint w_base  = j * pc.in_features;

    float sum = b[j];
    for (uint i = 0u; i < pc.in_features; ++i) {
        float x_val = x[(in_base + i) * pc.batch + r];
        float w_val = w[w_base + i];
        sum += x_val * w_val;
    }

    y[idx] = sum;
}