#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;       // общее количество элементов
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];       // входные данные (q_raw или k_raw)
};

layout(binding = 1, std430) writeonly buffer OutputBuf {
    float y[];       // выход после применения phi
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    float x_val = x[idx];

    // φ(x) = ELU(x) + 1
    // Для x > 0:  ELU(x) = x,        => φ = x + 1
    // Для x <= 0: ELU(x) = exp(x)-1, => φ = exp(x)
    // ВАЖНО: в CPU-реализации принято:
    //   if (x > 0.0) { x + 1.0 } else { exp(x) + 1.0 }
    // Мы следуем тому же правилу для совместимости.
    float phi;
    if (x_val > 0.0) {
        phi = x_val + 1.0;
    } else {
        phi = exp(x_val) + 1.0;
    }

    y[idx] = phi;
}