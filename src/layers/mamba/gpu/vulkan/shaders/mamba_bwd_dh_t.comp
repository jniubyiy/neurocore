// src/layers/mamba/gpu/vulkan/shaders/mamba_bwd_dh_t.comp
//
// Градиент по скрытому состоянию h_t на шаге t:
//
//   dh_t[r,i] = Σ_j C[j,i] · dy[r,t,j]
//             + Σ_k A_bar[k,i] · delta_next_in[r,k]
//
// где dy = go[r,t,*], delta_next_in — dh_{t+1} (нули при t = seq_len−1).
//
// Один поток на (r, i). Циклы по j и k — линейные, O(d + n) на поток.
// Локальных массивов нет, ограничений на n/d нет.
//
// Push: batch, d, n, seq_len, t.
// Dispatch: batch · n потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint d;
    uint n;
    uint seq_len;
    uint t;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf           { float go[]; };
layout(binding = 1, std430) readonly buffer CBuf            { float C[]; };
layout(binding = 2, std430) readonly buffer ABarBuf         { float A_bar[]; };
layout(binding = 3, std430) readonly buffer DeltaNextInBuf  { float delta_next_in[]; };
layout(binding = 4, std430) writeonly buffer DeltaNextOutBuf { float delta_next_out[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.batch * pc.n) return;

    uint r = gid / pc.n;
    uint i = gid % pc.n;

    // Вклад от C: Σ_j C[j,i] · dy[r,j]
    float sum_c = 0.0;
    for (uint j = 0u; j < pc.d; ++j) {
        float dy = go[(pc.t * pc.d + j) * pc.batch + r];
        sum_c += C[j * pc.n + i] * dy;
    }

    // Вклад от A_bar: Σ_k A_bar[k,i] · delta_next_in[r,k]
    float sum_a = 0.0;
    for (uint k = 0u; k < pc.n; ++k) {
        sum_a += A_bar[k * pc.n + i] * delta_next_in[r * pc.n + k];
    }

    delta_next_out[r * pc.n + i] = sum_c + sum_a;
}