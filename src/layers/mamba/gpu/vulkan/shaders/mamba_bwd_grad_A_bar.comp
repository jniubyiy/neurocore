// src/layers/mamba/gpu/vulkan/shaders/mamba_bwd_grad_A_bar.comp
//
// Накопление градиента по A_bar на шаге t (только t > 0):
//
//   grad_A_bar[i,k] += dh_t[r,i] · h_prev[r,k]
//
// Атомарное накопление через CAS.
//
// Один поток на (r, i, k). O(1) на поток.
//
// Push: batch, d, n, seq_len, t.
// Dispatch: batch · n · n потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint d;
    uint n;
    uint seq_len;
    uint t;
} pc;

layout(binding = 0, std430) readonly buffer DeltaNextOutBuf { float delta_next_out[]; };
layout(binding = 1, std430) readonly buffer HAllBuf         { float h_all[]; };
layout(binding = 2, std430) buffer GradABarBuf              { uint grad_A_bar[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.batch * pc.n * pc.n) return;

    uint r   = gid / (pc.n * pc.n);
    uint rem = gid % (pc.n * pc.n);
    uint i   = rem / pc.n;
    uint k   = rem % pc.n;

    float dh_i   = delta_next_out[r * pc.n + i];
    float h_prev = h_all[(r * pc.seq_len + (pc.t - 1u)) * pc.n + k];

    ATOMIC_ADD_FLOAT(grad_A_bar[i * pc.n + k], dh_i * h_prev);
}