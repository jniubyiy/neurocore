// src/layers/mamba/gpu/vulkan/shaders/mamba_bwd_grad_B_bar.comp
//
// Накопление градиента по B_bar на шаге t:
//
//   grad_B_bar[i,j] += dh_t[r,i] · x_t[r,j]
//
// Атомарное накопление через CAS.
//
// Один поток на (r, i, j). O(1) на поток.
//
// Push: batch, d, n, seq_len, t.
// Dispatch: batch · n · d потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint d;
    uint n;
    uint seq_len;
    uint t;
} pc;

layout(binding = 0, std430) readonly buffer DeltaNextOutBuf { float delta_next_out[]; };
layout(binding = 1, std430) readonly buffer XBuf            { float x[]; };
layout(binding = 2, std430) buffer GradBBarBuf              { uint grad_B_bar[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.batch * pc.n * pc.d) return;

    uint r   = gid / (pc.n * pc.d);
    uint rem = gid % (pc.n * pc.d);
    uint i   = rem / pc.d;
    uint j   = rem % pc.d;

    float dh_i = delta_next_out[r * pc.n + i];
    float x_tj = x[(pc.t * pc.d + j) * pc.batch + r];

    ATOMIC_ADD_FLOAT(grad_B_bar[i * pc.d + j], dh_i * x_tj);
}