// src/layers/mamba/gpu/vulkan/shaders/mamba_bwd_grad_C.comp
//
// Накопление градиента по C на шаге t:
//
//   grad_C[j,i] += dy[r,t,j] · h_t[r,i]
//
// Атомарное накопление через CAS.
//
// Один поток на (r, j, i). O(1) на поток.
//
// Push: batch, d, n, seq_len, t.
// Dispatch: batch · d · n потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint d;
    uint n;
    uint seq_len;
    uint t;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf    { float go[]; };
layout(binding = 1, std430) readonly buffer HAllBuf  { float h_all[]; };
layout(binding = 2, std430) buffer GradCBuf          { uint grad_C[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.batch * pc.d * pc.n) return;

    uint r   = gid / (pc.d * pc.n);
    uint rem = gid % (pc.d * pc.n);
    uint j   = rem / pc.n;
    uint i   = rem % pc.n;

    float dy  = go[(pc.t * pc.d + j) * pc.batch + r];
    float h_t = h_all[(r * pc.seq_len + pc.t) * pc.n + i];

    ATOMIC_ADD_FLOAT(grad_C[j * pc.n + i], dy * h_t);
}