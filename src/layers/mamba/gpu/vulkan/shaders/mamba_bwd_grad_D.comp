// src/layers/mamba/gpu/vulkan/shaders/mamba_bwd_grad_D.comp
//
// Накопление градиента по скаляру D на шаге t:
//
//   grad_D += dy[r,t,j] · x_t[r,j]
//
// Атомарное накопление в единственную ячейку grad_D.
//
// Один поток на (r, j). O(1) на поток.
//
// Push: batch, d, n, seq_len, t.
// Dispatch: batch · d потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint d;
    uint n;
    uint seq_len;
    uint t;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf   { float go[]; };
layout(binding = 1, std430) readonly buffer XBuf    { float x[]; };
layout(binding = 2, std430) buffer GradDBuf         { uint grad_D[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.batch * pc.d) return;

    uint r = gid / pc.d;
    uint j = gid % pc.d;

    float dy  = go[(pc.t * pc.d + j) * pc.batch + r];
    float x_t = x[(pc.t * pc.d + j) * pc.batch + r];

    ATOMIC_ADD_FLOAT(grad_D[0], dy * x_t);
}