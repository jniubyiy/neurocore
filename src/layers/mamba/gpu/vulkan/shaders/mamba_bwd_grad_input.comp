// src/layers/mamba/gpu/vulkan/shaders/mamba_bwd_grad_input.comp
//
// Градиент по входу на шаге t:
//
//   gi[r,t,j] = D · dy[r,t,j] + Σ_i B_bar[i,j] · dh_t[r,i]
//
// Каждый (r, j) обрабатывается ровно одним потоком за dispatch, поэтому
// atomicAdd не нужен — присваивание.
//
// Один поток на (r, j). Цикл по i — линейный, O(n) на поток.
//
// Push: batch, d, n, seq_len, t.
// Dispatch: batch · d потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint d;
    uint n;
    uint seq_len;
    uint t;
} pc;

layout(binding = 0, std430) readonly buffer DeltaNextOutBuf { float delta_next_out[]; };
layout(binding = 1, std430) readonly buffer GoBuf           { float go[]; };
layout(binding = 2, std430) readonly buffer BBarBuf         { float B_bar[]; };
layout(binding = 3, std430) readonly buffer DBuf            { float D[]; };
layout(binding = 4, std430) writeonly buffer GradInputBuf   { float gi[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.batch * pc.d) return;

    uint r = gid / pc.d;
    uint j = gid % pc.d;

    float dy = go[(pc.t * pc.d + j) * pc.batch + r];
    float sum = D[0] * dy;

    for (uint i = 0u; i < pc.n; ++i) {
        sum += B_bar[i * pc.d + j] * delta_next_out[r * pc.n + i];
    }

    uint gi_idx = (pc.t * pc.d + j) * pc.batch + r;
    gi[gi_idx] = sum;
}