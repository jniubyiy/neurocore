#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint d;          // input_dim
    uint n;          // state_dim
    uint seq_len;
    uint t;          // текущий шаг (0..seq_len-1)
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];            // column-major: x[(t*d + j)*batch + r]
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];           // column-major: go[(t*d + j)*batch + r]
};

layout(binding = 2, std430) readonly buffer HAllBuf {
    float h_all[];        // row-major: (r * seq_len + t) * n + i
};

layout(binding = 3, std430) readonly buffer A_barBuf {
    float A_bar[];        // n x n, row-major
};

layout(binding = 4, std430) readonly buffer B_barBuf {
    float B_bar[];        // n x d, row-major
};

layout(binding = 5, std430) readonly buffer CBuf {
    float C[];            // d x n, row-major
};

layout(binding = 6, std430) readonly buffer DBuf {
    float D;              // скаляр
};

layout(binding = 7, std430) readonly buffer DeltaNextInBuf {
    float delta_next_in[]; // размер batch * n
};

layout(binding = 8, std430) buffer GradA_barBuf {
    uint grad_A_bar[];    // битовое представление float, размер n*n
};

layout(binding = 9, std430) buffer GradB_barBuf {
    uint grad_B_bar[];    // битовое представление float, размер n*d
};

layout(binding = 10, std430) buffer GradCBuf {
    uint grad_C[];        // битовое представление float, размер d*n
};

layout(binding = 11, std430) buffer GradDBuf {
    uint grad_D;          // битовое представление float, размер 1
};

layout(binding = 12, std430) buffer GradInputBuf {
    uint gi[];            // битовое представление float, полный размер batch*seq_len*d (column-major как x)
};

layout(binding = 13, std430) writeonly buffer DeltaNextOutBuf {
    float delta_next_out[]; // размер batch * n
};

// Максимально допустимый размер state_dim
#define MAX_N 256

// Макрос атомарного сложения float
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint r = gl_GlobalInvocationID.x;   // индекс примера
    if (r >= pc.batch) return;

    float dh_t[MAX_N];
    if (pc.n > MAX_N) return; // защита

    // ---------- 1. Вычисляем dh_t[i] для всех i ----------
    for (uint i = 0u; i < pc.n; ++i) {
        float sum = 0.0;
        for (uint j = 0u; j < pc.d; ++j) {
            float dy_val = go[(pc.t * pc.d + j) * pc.batch + r];
            sum += C[j * pc.n + i] * dy_val;
        }

        float sum2 = 0.0;
        for (uint k = 0u; k < pc.n; ++k) {
            sum2 += A_bar[k * pc.n + i] * delta_next_in[r * pc.n + k];
        }

        dh_t[i] = sum + sum2;
    }

    // Записываем delta_next_out (равен dh_t)
    for (uint i = 0u; i < pc.n; ++i) {
        delta_next_out[r * pc.n + i] = dh_t[i];
    }

    // ---------- 2. Накопление градиентов по A_bar и B_bar ----------
    if (pc.t > 0u) {
        for (uint i = 0u; i < pc.n; ++i) {
            for (uint k = 0u; k < pc.n; ++k) {
                float h_prev = h_all[(r * pc.seq_len + pc.t - 1u) * pc.n + k];
                float grad_a = dh_t[i] * h_prev;
                ATOMIC_ADD_FLOAT(grad_A_bar[i * pc.n + k], grad_a);
            }
        }
    }

    for (uint i = 0u; i < pc.n; ++i) {
        for (uint j = 0u; j < pc.d; ++j) {
            float x_t_j = x[(pc.t * pc.d + j) * pc.batch + r];
            float grad_b = dh_t[i] * x_t_j;
            ATOMIC_ADD_FLOAT(grad_B_bar[i * pc.d + j], grad_b);
        }
    }

    // ---------- 3. Накопление градиентов по C, D и входу ----------
    for (uint j = 0u; j < pc.d; ++j) {
        float dy_val = go[(pc.t * pc.d + j) * pc.batch + r];
        for (uint i = 0u; i < pc.n; ++i) {
            float h_t = h_all[(r * pc.seq_len + pc.t) * pc.n + i];
            ATOMIC_ADD_FLOAT(grad_C[j * pc.n + i], dy_val * h_t);
        }
    }

    float grad_D_val = 0.0;
    for (uint j = 0u; j < pc.d; ++j) {
        float dy_val = go[(pc.t * pc.d + j) * pc.batch + r];
        float x_t_j = x[(pc.t * pc.d + j) * pc.batch + r];
        grad_D_val += dy_val * x_t_j;
    }
    ATOMIC_ADD_FLOAT(grad_D, grad_D_val);

    for (uint j = 0u; j < pc.d; ++j) {
        float dy_val = go[(pc.t * pc.d + j) * pc.batch + r];
        float grad_x = D * dy_val;
        for (uint i = 0u; i < pc.n; ++i) {
            float b_val = B_bar[i * pc.d + j];
            grad_x += b_val * dh_t[i];
        }

        uint gi_idx = (pc.t * pc.d + j) * pc.batch + r;
        ATOMIC_ADD_FLOAT(gi[gi_idx], grad_x);
    }
}