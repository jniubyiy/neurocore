#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint n;          // state_dim
    uint d;          // input_dim
    float delta;     // шаг дискретизации
    uint padding;
} pc;

layout(binding = 0, std430) readonly buffer ABuf {
    float A[];           // n x n, row-major
};

layout(binding = 1, std430) readonly buffer BBuf {
    float B[];           // n x d, row-major
};

layout(binding = 2, std430) readonly buffer GradA_barBuf {
    uint grad_A_bar[];   // n x n, битовое представление float
};

layout(binding = 3, std430) readonly buffer GradB_barBuf {
    uint grad_B_bar[];   // n x d, битовое представление float
};

layout(binding = 4, std430) writeonly buffer GradABuf {
    uint grad_A[];       // n x n, битовое представление float
};

layout(binding = 5, std430) writeonly buffer GradBBuf {
    uint grad_B[];       // n x d, битовое представление float
};

layout(binding = 6, std430) buffer GradDeltaBuf {
    uint grad_delta;     // битовое представление float, единственный элемент
};

// Макрос атомарного сложения float
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_A = pc.n * pc.n;
    uint total_B = pc.n * pc.d;

    if (idx < total_A) {
        float grad_A_bar_val = uintBitsToFloat(grad_A_bar[idx]);
        float grad_A_val = pc.delta * grad_A_bar_val;
        grad_A[idx] = floatBitsToUint(grad_A_val);

        ATOMIC_ADD_FLOAT(grad_delta, A[idx] * grad_A_bar_val);
    }
    else if (idx < total_A + total_B) {
        uint local_idx = idx - total_A;
        float grad_B_bar_val = uintBitsToFloat(grad_B_bar[local_idx]);
        float grad_B_val = pc.delta * grad_B_bar_val;
        grad_B[local_idx] = floatBitsToUint(grad_B_val);

        ATOMIC_ADD_FLOAT(grad_delta, B[local_idx] * grad_B_bar_val);
    }
}