#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint n;          // state_dim
    uint d;          // input_dim
    float delta;     // шаг дискретизации
    uint padding;
} pc;

layout(binding = 0, std430) readonly buffer ABuf {
    float A[];       // n x n, row-major
};

layout(binding = 1, std430) readonly buffer BBuf {
    float B[];       // n x d, row-major
};

layout(binding = 2, std430) writeonly buffer A_barBuf {
    float A_bar[];   // n x n, row-major
};

layout(binding = 3, std430) writeonly buffer B_barBuf {
    float B_bar[];   // n x d, row-major
};

#define MAX_N 64  // максимально допустимый размер state_dim

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_A = pc.n * pc.n;
    uint total_B = pc.n * pc.d;

    if (idx < total_A) {
        // Вычисляем A_bar[i,j]
        uint i = idx / pc.n;
        uint j = idx % pc.n;

        // Проверка на допустимый размер
        if (pc.n > MAX_N) return;

        // Инициализация term = I (строка i)
        float term[MAX_N];
        for (uint l = 0u; l < pc.n; l++) {
            term[l] = (l == i) ? 1.0 : 0.0;
        }

        // result = I (начальное приближение expm)
        float result = (i == j) ? 1.0 : 0.0;
        float factorial = 1.0;

        // Ряд Тейлора до 10 членов
        for (uint k = 1u; k <= 10u; k++) {
            factorial *= float(k);

            // new_term[l] = sum_m term[m] * (delta * A)[m,l] / k
            float new_term[MAX_N];
            for (uint l = 0u; l < pc.n; l++) {
                float sum = 0.0;
                for (uint m = 0u; m < pc.n; m++) {
                    sum += term[m] * (pc.delta * A[m * pc.n + l]);
                }
                new_term[l] = sum / factorial;
            }

            // Копируем new_term в term
            for (uint l = 0u; l < pc.n; l++) {
                term[l] = new_term[l];
            }

            // Добавляем вклад в result
            result += term[j];
        }

        A_bar[idx] = result;
    }
    else if (idx < total_A + total_B) {
        // Вычисляем B_bar[i,j]
        uint local_idx = idx - total_A;
        uint i = local_idx / pc.d;
        uint j = local_idx % pc.d;

        B_bar[local_idx] = pc.delta * B[local_idx];
    }
}