// src/layers/mamba/gpu/vulkan/shaders/mamba_discretize_accum.comp
//
// Накопление очередного члена ряда Тейлора: A_bar[i,j] += T[i,j].
//
// Каждый (i,j) обрабатывается ровно одним потоком за dispatch,
// поэтому atomicAdd не нужен — между dispatch'ами синхронизация
// выполняется на стороне Rust.
//
// Один поток на элемент. O(1) на поток.
//
// Push: n.
// Dispatch: n · n потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint n;
} pc;

layout(binding = 0, std430) readonly buffer TBuf     { float T[]; };
layout(binding = 1, std430) buffer         ABarBuf  { float A_bar[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint n = pc.n;
    if (idx >= n * n) return;

    A_bar[idx] = A_bar[idx] + T[idx];
}