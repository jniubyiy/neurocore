// src/layers/mamba/gpu/vulkan/shaders/mamba_discretize_init.comp
//
// Инициализация ряда Тейлора для A_bar = exp(Δ·A).
//
// T := I (единичная матрица n×n, row-major).
// A_bar := 0.
//
// Один поток на элемент (i, j). O(1) на поток.
//
// Push: n.
// Dispatch: n · n потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint n;
} pc;

layout(binding = 0, std430) writeonly buffer TBuf     { float T[]; };
layout(binding = 1, std430) writeonly buffer ABarBuf  { float A_bar[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint n = pc.n;
    if (idx >= n * n) return;

    uint i = idx / n;
    uint j = idx % n;

    T[idx]     = (i == j) ? 1.0 : 0.0;
    A_bar[idx] = 0.0;
}