// src/layers/mamba/gpu/vulkan/shaders/mamba_discretize_scale_b.comp
//
// B_bar = Δ · B (поэлементно).
//
// Один поток на элемент (i, j) матрицы B (n × d, row-major).
//
// Push: n, d, delta.
// Dispatch: n · d потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint  n;
    uint  d;
    float delta;
} pc;

layout(binding = 0, std430) readonly buffer BBuf      { float B[]; };
layout(binding = 1, std430) writeonly buffer BBarBuf  { float B_bar[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.n * pc.d) return;
    B_bar[idx] = pc.delta * B[idx];
}