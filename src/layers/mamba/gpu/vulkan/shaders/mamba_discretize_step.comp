// src/layers/mamba/gpu/vulkan/shaders/mamba_discretize_step.comp
//
// Один шаг ряда Тейлора: T_next[i,j] = (Δ/k) · Σ_l T[i,l] · A[l,j].
//
// Все матрицы — row-major, n × n.
// Один поток на элемент (i,j). Цикл по l — линейный, O(n) на поток.
// Никаких локальных массивов, ограничений на n нет.
//
// Push: n, k (номер шага, 1-indexed), delta.
// Dispatch: n · n потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint  n;
    uint  k;      // 1, 2, ..., 10
    float delta;  // шаг дискретизации
} pc;

layout(binding = 0, std430) readonly buffer TBuf      { float T[]; };
layout(binding = 1, std430) readonly buffer ABuf      { float A[]; };
layout(binding = 2, std430) writeonly buffer TNextBuf { float T_next[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint n = pc.n;
    if (idx >= n * n) return;

    uint i = idx / n;
    uint j = idx % n;

    float sum = 0.0;
    for (uint l = 0u; l < n; ++l) {
        sum += T[i * n + l] * A[l * n + j];
    }

    float factor = pc.delta / float(pc.k);
    T_next[idx] = factor * sum;
}