#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint d;          // input_dim (d_model)
    uint n;          // state_dim
    uint seq_len;
    uint t;          // текущий шаг (0..seq_len-1)
    uint phase;      // 0 = вычисление h_t, 1 = вычисление y_t
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];           // column-major: x[(t*d + j)*batch + r]
};

layout(binding = 1, std430) readonly buffer A_barBuf {
    float A_bar[];       // n x n, row-major
};

layout(binding = 2, std430) readonly buffer B_barBuf {
    float B_bar[];       // n x d, row-major
};

layout(binding = 3, std430) readonly buffer CBuf {
    float C[];           // d x n, row-major
};

layout(binding = 4, std430) readonly buffer DBuf {
    float D;             // скаляр
};

layout(binding = 5, std430) buffer HAllBuf {
    float h_all[];       // (batch * seq_len) x n, row-major по (r,t,i)
};

layout(binding = 6, std430) writeonly buffer OutputBuf {
    float y[];           // column-major: y[(t*d + j)*batch + r]
};

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (pc.phase == 0u) {
        // Фаза 0: вычисление h_t^r[i]
        uint total_h = pc.batch * pc.n;
        if (idx >= total_h) return;

        uint r = idx / pc.n;
        uint i = idx % pc.n;

        // Чтение предыдущего скрытого состояния (для t=0 оно нулевое)
        float h_prev = 0.0;
        if (pc.t > 0u) {
            uint h_prev_idx = (r * pc.seq_len + pc.t - 1u) * pc.n + i;
            h_prev = h_all[h_prev_idx];
        }

        // Линейная комбинация A_bar * h_prev + B_bar * x_t
        float sum = 0.0;
        for (uint k = 0u; k < pc.n; ++k) {
            float a_val = A_bar[i * pc.n + k];
            float h_val = 0.0;
            if (pc.t > 0u) {
                // h_prev[k]
                h_val = h_all[(r * pc.seq_len + pc.t - 1u) * pc.n + k];
            }
            sum += a_val * h_val;
        }
        for (uint l = 0u; l < pc.d; ++l) {
            float b_val = B_bar[i * pc.d + l];
            float x_val = x[(pc.t * pc.d + l) * pc.batch + r];
            sum += b_val * x_val;
        }

        // Запись нового скрытого состояния
        h_all[(r * pc.seq_len + pc.t) * pc.n + i] = sum;
    } else {
        // Фаза 1: вычисление y_t^r[j]
        uint total_y = pc.batch * pc.d;
        if (idx >= total_y) return;

        uint r = idx / pc.d;
        uint j = idx % pc.d;

        float sum = D * x[(pc.t * pc.d + j) * pc.batch + r];
        for (uint i = 0u; i < pc.n; ++i) {
            float c_val = C[j * pc.n + i];
            float h_val = h_all[(r * pc.seq_len + pc.t) * pc.n + i];
            sum += c_val * h_val;
        }

        y[(pc.t * pc.d + j) * pc.batch + r] = sum;
    }
}