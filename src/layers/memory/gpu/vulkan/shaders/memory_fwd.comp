#version 450
// NO extensions required – используем только core Vulkan 1.0

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
    float alpha;
} pc;

layout(binding = 0, std430) readonly buffer In {
    float x[];
};

// state хранится как int (битовое представление float)
layout(binding = 1, std430) buffer StateBuf {
    int state[];   // [min[0..features-1], max[features..2*features-1]]
};

layout(binding = 2, std430) writeonly buffer Out {
    float y[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.batch * pc.features) return;

    uint c = i % pc.features;
    float x_val = x[i];

    // Читаем текущие значения, преобразуя биты обратно во float
    float min_val = intBitsToFloat(state[c]);
    float max_val = intBitsToFloat(state[pc.features + c]);

    // Основная логика Memory слоя
    float d_min = abs(x_val - min_val);
    float d_max = abs(x_val - max_val);
    float closest = (d_min <= d_max) ? min_val : max_val;
    float y_val = x_val + pc.alpha * (closest - x_val);
    y[i] = y_val;

    // Атомарное обновление минимума и максимума через целочисленные атомарные операции
    // atomicMin/atomicMax для знаковых int корректно работают с битовым представлением float
    atomicMin(state[c], floatBitsToInt(x_val));
    atomicMax(state[pc.features + c], floatBitsToInt(x_val));
}