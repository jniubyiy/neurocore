// src/layers/memory/gpu/vulkan/shaders/memory_fwd.comp
//
// Прямой проход Memory на GPU (column-major, сглаживание как в CPU).
//
// Раскладка активаций — column-major: x[c * batch + r].
// State хранится как float-буфер: state[c] = min_cells[c],
// state[features + c] = max_cells[c].
//
// Формула сглаживания (совпадает с CPU-версией, порядок обхода r = 0..batch):
//   closest = argmin(|x − min|, |x − max|)
//   y = x + alpha · (closest − x)
//
// Обновление якорей:
//   если x > max: max ← max + alpha · (x − max)
//   если x < min: min ← min + alpha · (x − min)
//   иначе:        min ← min + alpha · (x − min);
//                 max ← max + alpha · (x − max)
//
// Один поток на признак c. Внутри — линейный цикл по batch.
// Параллелизм — по features. Порядок обхода r внутри одного признака
// сохраняется, поэтому семантика идентична CPU-версии.
//
// Push-константы: batch, features, alpha.
// Dispatch: features потоков.

#version 450
// NO extensions required — только core Vulkan 1.0

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint  batch;
    uint  features;
    float alpha;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf { float x[]; };

// State — float-буфер (не int-биты!).
// [min_0, min_1, …, min_{F−1}, max_0, max_1, …, max_{F−1}]
layout(binding = 1, std430) buffer StateBuf { float state[]; };

layout(binding = 2, std430) writeonly buffer OutBuf { float y[]; };

void main() {
    uint c = gl_GlobalInvocationID.x;
    if (c >= pc.features) return;

    float min_val = state[c];
    float max_val = state[pc.features + c];
    uint base = c * pc.batch;

    for (uint r = 0u; r < pc.batch; ++r) {
        uint idx = base + r;
        float x_val = x[idx];

        float d_min = abs(x_val - min_val);
        float d_max = abs(x_val - max_val);
        float closest = (d_min <= d_max) ? min_val : max_val;
        y[idx] = x_val + pc.alpha * (closest - x_val);

        // Обновление якорей — последовательно по r, как в CPU.
        if (x_val > max_val) {
            max_val = max_val + pc.alpha * (x_val - max_val);
        } else if (x_val < min_val) {
            min_val = min_val + pc.alpha * (x_val - min_val);
        } else {
            min_val = min_val + pc.alpha * (x_val - min_val);
            max_val = max_val + pc.alpha * (x_val - max_val);
        }
    }

    state[c] = min_val;
    state[pc.features + c] = max_val;
}