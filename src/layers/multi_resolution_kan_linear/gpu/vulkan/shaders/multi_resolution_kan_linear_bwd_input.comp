// src/layers/multi_resolution_kan_linear/gpu/vulkan/shaders/multi_resolution_kan_linear_bwd_input.comp
//
// Фаза 1 обратного прохода MultiResolutionKANLinear:
// вычисление градиента по входу.
//
// Один поток на элемент (r, i). Внутри — цикл по j, O(out) на поток.
// Локальных массивов нет, ограничений нет.
//
// Push: batch, in_features, out_features.
// Dispatch: batch · in_features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf   { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf { float go[]; };
layout(binding = 2, std430) readonly buffer ParamsBuf  { float params[]; };
layout(binding = 3, std430) writeonly buffer GradInBuf { float gi[]; };

#define COARSE_GRID 4u
#define FINE_GRID   8u

float linear_interpolate_deriv_value(float x_val, uint grid_size, uint coeff_base) {
    float t = (clamp(x_val, -1.0, 1.0) + 1.0) * 0.5;
    float scaled = t * float(grid_size - 1u);
    uint  idx0 = uint(floor(scaled));
    uint  idx1 = min(idx0 + 1u, grid_size - 1u);
    float frac = scaled - float(idx0);
    float w0 = 1.0 - frac;
    float w1 = frac;
    return (params[coeff_base + idx1] - params[coeff_base + idx0])
         * float(grid_size - 1u) * 0.5 * w0
         + 0.0
         + ((params[coeff_base + idx1] - params[coeff_base + idx0])
            * float(grid_size - 1u) * 0.5) * (w1 - w0);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.in_features;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint i = idx / pc.batch;

    uint in_feat  = pc.in_features;
    uint out_feat = pc.out_features;

    uint coarse_offset = 0u;
    uint fine_offset   = coarse_offset + in_feat * out_feat * COARSE_GRID;

    float sum = 0.0;
    float x_val = x[i * pc.batch + r];

    for (uint j = 0u; j < out_feat; ++j) {
        float gout = go[j * pc.batch + r];

        // Производная каждой из двух сеток по входу.
        // d/dx линейной интерполяции = (coeff[idx1] - coeff[idx0]) * (grid-1) * 0.5.
        uint c_base = coarse_offset + (j * in_feat + i) * COARSE_GRID;
        uint f_base = fine_offset   + (j * in_feat + i) * FINE_GRID;

        // Для производной нужны те же idx0/idx1, что и в forward.
        float t_c = (clamp(x_val, -1.0, 1.0) + 1.0) * 0.5;
        float scaled_c = t_c * float(COARSE_GRID - 1u);
        uint  c_idx0 = uint(floor(scaled_c));
        uint  c_idx1 = min(c_idx0 + 1u, COARSE_GRID - 1u);

        float t_f = (clamp(x_val, -1.0, 1.0) + 1.0) * 0.5;
        float scaled_f = t_f * float(FINE_GRID - 1u);
        uint  f_idx0 = uint(floor(scaled_f));
        uint  f_idx1 = min(f_idx0 + 1u, FINE_GRID - 1u);

        float c_deriv = (params[c_base + c_idx1] - params[c_base + c_idx0])
                      * float(COARSE_GRID - 1u) * 0.5;
        float f_deriv = (params[f_base + f_idx1] - params[f_base + f_idx0])
                      * float(FINE_GRID - 1u) * 0.5;

        sum += gout * (c_deriv + f_deriv);
    }

    gi[i * pc.batch + r] = sum;
}