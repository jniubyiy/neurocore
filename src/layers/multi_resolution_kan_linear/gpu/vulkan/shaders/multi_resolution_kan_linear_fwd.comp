#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];          // column-major: x[i * batch + r]
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[];     // [coarse (in*out*4), fine (in*out*8), bias (out)]
};

layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];          // column-major: y[j * batch + r]
};

// Константы сеток (как в CPU-версии)
#define COARSE_GRID 4u
#define FINE_GRID   8u

// Линейная интерполяция по равномерной сетке на [-1,1].
float linear_interpolate(float x_val, uint grid_size, uint coeff_base, const in float coeffs[]) {
    // Нормализуем x в [0,1]
    float t = (clamp(x_val, -1.0, 1.0) + 1.0) * 0.5;
    float scaled = t * float(grid_size - 1u);
    uint idx0 = uint(floor(scaled));
    uint idx1 = min(idx0 + 1u, grid_size - 1u);
    float frac = scaled - float(idx0);
    float w0 = 1.0 - frac;
    float w1 = frac;
    // Коэффициенты для этой сетки хранятся последовательно
    return w0 * coeffs[coeff_base + idx0] + w1 * coeffs[coeff_base + idx1];
}

void main() {
    uint total = pc.batch * pc.out_features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint j = idx / pc.batch;

    uint in_feat = pc.in_features;
    uint out_feat = pc.out_features;

    // Смещения внутри буфера параметров
    uint coarse_offset = 0u;
    uint fine_offset = coarse_offset + in_feat * out_feat * COARSE_GRID;
    uint bias_offset = fine_offset + in_feat * out_feat * FINE_GRID;

    float sum = params[bias_offset + j]; // bias

    for (uint i = 0u; i < in_feat; ++i) {
        float x_val = x[i * pc.batch + r];

        // База для пары (j, i) в общей области coarse
        uint coarse_base = coarse_offset + (j * in_feat + i) * COARSE_GRID;
        float coarse_val = linear_interpolate(x_val, COARSE_GRID, coarse_base, params);

        // База для fine
        uint fine_base = fine_offset + (j * in_feat + i) * FINE_GRID;
        float fine_val = linear_interpolate(x_val, FINE_GRID, fine_base, params);

        sum += coarse_val + fine_val;
    }

    y[idx] = sum;
}