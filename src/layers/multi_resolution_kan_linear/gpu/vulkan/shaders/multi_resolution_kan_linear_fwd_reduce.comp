// src/layers/multi_resolution_kan_linear/gpu/vulkan/shaders/multi_resolution_kan_linear_fwd_reduce.comp
//
// KAN v2 forward, фаза 2: суммирование edge-вкладов по i + bias.
//
//   y[j, r] = bias[j] + Σ_i edge_out[(j · in + i) · batch + r]
//
// Push: [batch, in_features, out_features]  (12 байт)
// Dispatch: batch · out_features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer EdgeOutBuf {
    float edge_out[];
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[];    // bias[j] лежит в начале блока параметров
};

layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];
};

void main() {
    uint total = pc.batch * pc.out_features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    // idx = j * batch + r
    uint r = idx % pc.batch;
    uint j = idx / pc.batch;

    float sum = params[j];
    uint base = (j * pc.in_features) * pc.batch + r;
    for (uint i = 0u; i < pc.in_features; ++i) {
        sum += edge_out[base + i * pc.batch];
    }
    y[idx] = sum;
}