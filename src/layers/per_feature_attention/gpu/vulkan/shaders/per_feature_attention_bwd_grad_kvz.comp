// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_bwd_grad_kvz.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer GradNumBuf { float grad_num[]; };
layout(binding = 1, std430) readonly buffer GradDenBuf { float grad_denom[]; };
layout(binding = 2, std430) readonly buffer QPhiBuf    { float q_phi[]; };
layout(binding = 3, std430) writeonly buffer GradKVBuf { float grad_kv[]; };
layout(binding = 4, std430) writeonly buffer GradZBuf  { float grad_z[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.d_model * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i = tmp % pc.d_head;
    uint h = tmp / pc.d_head;

    uint dh = pc.d_head;

    for (uint j = 0u; j < dh; ++j) {
        float sum = 0.0;
        for (uint t = 0u; t < pc.seq_len; ++t) {
            uint base = ((t * pc.d_model + h) * dh) * pc.batch + r;
            sum += grad_num[base + j * pc.batch] * q_phi[base + i * pc.batch];
        }
        grad_kv[((h * dh + i) * dh + j) * pc.batch + r] = sum;
    }

    float zsum = 0.0;
    for (uint t = 0u; t < pc.seq_len; ++t) {
        uint base = ((t * pc.d_model + h) * dh) * pc.batch + r;
        float gd = grad_denom[(t * pc.d_model + h) * pc.batch + r];
        zsum += gd * q_phi[base + i * pc.batch];
    }
    grad_z[(h * dh + i) * pc.batch + r] = zsum;
}