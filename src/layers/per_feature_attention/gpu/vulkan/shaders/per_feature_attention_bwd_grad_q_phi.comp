// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_bwd_grad_q_phi.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer GradNumBuf   { float grad_num[]; };
layout(binding = 1, std430) readonly buffer GradDenBuf   { float grad_denom[]; };
layout(binding = 2, std430) readonly buffer KVBuf        { float kv[]; };
layout(binding = 3, std430) readonly buffer ZBuf         { float z[]; };
layout(binding = 4, std430) writeonly buffer GradQPhiBuf { float grad_q_phi[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq_len * pc.d_model * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i = tmp % pc.d_head;
    uint tmp2 = tmp / pc.d_head;
    uint h = tmp2 % pc.d_model;
    uint t = tmp2 / pc.d_model;

    uint dh = pc.d_head;
    uint base = ((t * pc.d_model + h) * dh) * pc.batch + r;

    float gd = grad_denom[(t * pc.d_model + h) * pc.batch + r];
    float z_i = z[(h * dh + i) * pc.batch + r];

    float gq = gd * z_i;
    for (uint j = 0u; j < dh; ++j) {
        gq += grad_num[base + j * pc.batch]
            * kv[((h * dh + i) * dh + j) * pc.batch + r];
    }
    grad_q_phi[base + i * pc.batch] = gq;
}