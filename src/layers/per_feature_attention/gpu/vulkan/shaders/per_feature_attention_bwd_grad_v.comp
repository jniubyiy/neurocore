// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_bwd_grad_v.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer GradNumBuf   { float grad_num[]; };
layout(binding = 1, std430) readonly buffer GradKVBuf    { float grad_kv[]; };
layout(binding = 2, std430) readonly buffer KPhiBuf      { float k_phi[]; };
layout(binding = 3, std430) readonly buffer ParamsBuf    { float params[]; };
layout(binding = 4, std430) writeonly buffer GradVRawBuf { float grad_v_raw[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq_len * pc.d_model * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint j = tmp % pc.d_head;
    uint tmp2 = tmp / pc.d_head;
    uint h = tmp2 % pc.d_model;
    uint t = tmp2 / pc.d_model;

    uint dh = pc.d_head;
    uint head_pc = 10u * dh + 2u;
    uint sb_off = h * head_pc + 10u * dh + 1u;
    float sb = params[sb_off];

    uint base = ((t * pc.d_model + h) * dh) * pc.batch + r;

    float gv = sb * grad_num[base + j * pc.batch];
    for (uint i = 0u; i < dh; ++i) {
        gv += grad_kv[((h * dh + i) * dh + j) * pc.batch + r]
            * k_phi[base + i * pc.batch];
    }
    grad_v_raw[base + j * pc.batch] = gv;
}