// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_bwd_grad_x.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer GradQRawBuf { float grad_q_raw[]; };
layout(binding = 1, std430) readonly buffer GradKRawBuf { float grad_k_raw[]; };
layout(binding = 2, std430) readonly buffer GradVRawBuf { float grad_v_raw[]; };
layout(binding = 3, std430) readonly buffer ParamsBuf   { float params[]; };
layout(binding = 4, std430) writeonly buffer GradXBuf   { float grad_x[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq_len * pc.d_model) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint h = tmp % pc.d_model;
    uint t = tmp / pc.d_model;

    uint dh = pc.d_head;
    uint head_pc = 10u * dh + 2u;
    uint wq_off = h * head_pc;
    uint wk_off = wq_off + 2u * dh + dh;
    uint wv_off = wk_off + 2u * dh + dh;

    uint bt = ((t * pc.d_model + h) * dh) * pc.batch + r;

    float du0 = 0.0;
    float du1 = 0.0;
    for (uint i = 0u; i < dh; ++i) {
        float gq = grad_q_raw[bt + i * pc.batch];
        float gk = grad_k_raw[bt + i * pc.batch];
        float gv = grad_v_raw[bt + i * pc.batch];

        du0 += gq * params[wq_off + i * 2u + 0u]
             + gk * params[wk_off + i * 2u + 0u]
             + gv * params[wv_off + i * 2u + 0u];
        du1 += gq * params[wq_off + i * 2u + 1u]
             + gk * params[wk_off + i * 2u + 1u]
             + gv * params[wv_off + i * 2u + 1u];
    }

    float du1_next = 0.0;
    if (t + 1u < pc.seq_len) {
        uint bn = (((t + 1u) * pc.d_model + h) * dh) * pc.batch + r;
        for (uint i = 0u; i < dh; ++i) {
            float gq = grad_q_raw[bn + i * pc.batch];
            float gk = grad_k_raw[bn + i * pc.batch];
            float gv = grad_v_raw[bn + i * pc.batch];

            du1_next += gq * params[wq_off + i * 2u + 1u]
                      + gk * params[wk_off + i * 2u + 1u]
                      + gv * params[wv_off + i * 2u + 1u];
        }
    }

    grad_x[(t * pc.d_model + h) * pc.batch + r] = du0 + du1 - du1_next;
}