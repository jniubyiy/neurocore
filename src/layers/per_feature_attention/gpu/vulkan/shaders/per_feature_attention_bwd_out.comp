// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_bwd_out.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf        { float grad_out[]; };
layout(binding = 1, std430) readonly buffer AttnBuf      { float attn[]; };
layout(binding = 2, std430) readonly buffer VRawBuf      { float v_raw[]; };
layout(binding = 3, std430) readonly buffer DenomBuf     { float denom[]; };
layout(binding = 4, std430) readonly buffer ParamsBuf    { float params[]; };
layout(binding = 5, std430) buffer GradParamsBuf         { uint grad_params[]; };
layout(binding = 6, std430) writeonly buffer GradAttnBuf { float grad_attn[]; };
layout(binding = 7, std430) writeonly buffer GradNumBuf  { float grad_num[]; };
layout(binding = 8, std430) writeonly buffer GradDenBuf  { float grad_denom[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq_len * pc.d_model) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint h = tmp % pc.d_model;
    uint t = tmp / pc.d_model;

    uint dh = pc.d_head;
    uint head_pc = 10u * dh + 2u;
    uint hbase = h * head_pc;
    uint wo_off = hbase + 9u * dh;
    uint bo_off = hbase + 10u * dh;
    uint sb_off = bo_off + 1u;

    float go = grad_out[(t * pc.d_model + h) * pc.batch + r];
    float d = denom[(t * pc.d_model + h) * pc.batch + r];
    float inv_d = 1.0 / d;

    ATOMIC_ADD_FLOAT(grad_params[bo_off], go);

    uint base = ((t * pc.d_model + h) * dh) * pc.batch + r;
    float ddenom = 0.0;
    float dsb = 0.0;

    for (uint j = 0u; j < dh; ++j) {
        float wo_j = params[wo_off + j];
        float dattn = go * wo_j;
        float a_j = attn[base + j * pc.batch];
        grad_attn[base + j * pc.batch] = dattn;

        float dnum = dattn * inv_d;
        grad_num[base + j * pc.batch] = dnum;

        ATOMIC_ADD_FLOAT(grad_params[wo_off + j], go * a_j);
        ddenom -= dattn * a_j * inv_d;
        dsb += dnum * v_raw[base + j * pc.batch];
    }

    grad_denom[(t * pc.d_model + h) * pc.batch + r] = ddenom;
    dsb += ddenom;

    ATOMIC_ADD_FLOAT(grad_params[sb_off], dsb);
}