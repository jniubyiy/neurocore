// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_bwd_qk_raw.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer GradQPhiBuf  { float grad_q_phi[]; };
layout(binding = 1, std430) readonly buffer GradKVBuf    { float grad_kv[]; };
layout(binding = 2, std430) readonly buffer GradZBuf     { float grad_z[]; };
layout(binding = 3, std430) readonly buffer VRawBuf      { float v_raw[]; };
layout(binding = 4, std430) readonly buffer QRawBuf      { float q_raw[]; };
layout(binding = 5, std430) readonly buffer KRawBuf      { float k_raw[]; };
layout(binding = 6, std430) writeonly buffer GradQRawBuf { float grad_q_raw[]; };
layout(binding = 7, std430) writeonly buffer GradKRawBuf { float grad_k_raw[]; };

float phi_derivative(float v) {
    return (v > 0.0) ? 1.0 : exp(v);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.seq_len * pc.d_model * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i = tmp % pc.d_head;
    uint tmp2 = tmp / pc.d_head;
    uint h = tmp2 % pc.d_model;
    uint t = tmp2 / pc.d_model;

    uint dh = pc.d_head;
    uint base = ((t * pc.d_model + h) * dh) * pc.batch + r;

    float gk = grad_z[(h * dh + i) * pc.batch + r];
    for (uint j = 0u; j < dh; ++j) {
        gk += grad_kv[((h * dh + i) * dh + j) * pc.batch + r]
            * v_raw[base + j * pc.batch];
    }

    float qr = q_raw[base + i * pc.batch];
    float kr = k_raw[base + i * pc.batch];

    grad_q_raw[base + i * pc.batch] =
        grad_q_phi[base + i * pc.batch] * phi_derivative(qr);
    grad_k_raw[base + i * pc.batch] = gk * phi_derivative(kr);
}