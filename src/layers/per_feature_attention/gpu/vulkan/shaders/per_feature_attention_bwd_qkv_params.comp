// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_bwd_qkv_params.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer GradQRawBuf  { float grad_q_raw[]; };
layout(binding = 1, std430) readonly buffer GradKRawBuf  { float grad_k_raw[]; };
layout(binding = 2, std430) readonly buffer GradVRawBuf  { float grad_v_raw[]; };
layout(binding = 3, std430) readonly buffer InputBuf     { float x[]; };
layout(binding = 4, std430) buffer GradParamsBuf         { uint grad_params[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.batch * pc.d_model * pc.d_head) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i = tmp % pc.d_head;
    uint h = tmp / pc.d_head;

    uint dh = pc.d_head;
    uint head_pc = 10u * dh + 2u;
    uint wq_off = h * head_pc;
    uint bq_off = wq_off + 2u * dh;
    uint wk_off = bq_off + dh;
    uint bk_off = wk_off + 2u * dh;
    uint wv_off = bk_off + dh;
    uint bv_off = wv_off + 2u * dh;

    float swq0 = 0.0, swq1 = 0.0, sbq = 0.0;
    float swk0 = 0.0, swk1 = 0.0, sbk = 0.0;
    float swv0 = 0.0, swv1 = 0.0, sbv = 0.0;

    for (uint t = 0u; t < pc.seq_len; ++t) {
        float x_t = x[(t * pc.d_model + h) * pc.batch + r];
        float x_prev = (t > 0u) ? x[((t - 1u) * pc.d_model + h) * pc.batch + r] : 0.0;
        float dx_t = (t > 0u) ? (x_t - x_prev) : x_t;

        uint b = ((t * pc.d_model + h) * dh + i) * pc.batch + r;
        float gq = grad_q_raw[b];
        float gk = grad_k_raw[b];
        float gv = grad_v_raw[b];

        swq0 += gq * x_t;   swq1 += gq * dx_t;   sbq += gq;
        swk0 += gk * x_t;   swk1 += gk * dx_t;   sbk += gk;
        swv0 += gv * x_t;   swv1 += gv * dx_t;   sbv += gv;
    }

    ATOMIC_ADD_FLOAT(grad_params[wq_off + i * 2u + 0u], swq0);
    ATOMIC_ADD_FLOAT(grad_params[wq_off + i * 2u + 1u], swq1);
    ATOMIC_ADD_FLOAT(grad_params[bq_off + i], sbq);
    ATOMIC_ADD_FLOAT(grad_params[wk_off + i * 2u + 0u], swk0);
    ATOMIC_ADD_FLOAT(grad_params[wk_off + i * 2u + 1u], swk1);
    ATOMIC_ADD_FLOAT(grad_params[bk_off + i], sbk);
    ATOMIC_ADD_FLOAT(grad_params[wv_off + i * 2u + 0u], swv0);
    ATOMIC_ADD_FLOAT(grad_params[wv_off + i * 2u + 1u], swv1);
    ATOMIC_ADD_FLOAT(grad_params[bv_off + i], sbv);
}