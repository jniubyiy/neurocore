// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_fwd_kvz.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer KPhiBuf { float k_phi[]; };
layout(binding = 1, std430) readonly buffer VRawBuf { float v_raw[]; };
layout(binding = 2, std430) writeonly buffer KVBuf  { float kv[]; };
layout(binding = 3, std430) writeonly buffer ZBuf   { float z[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint dh = pc.d_head;
    uint kv_size = dh * dh;
    uint per_head = kv_size + dh;
    uint total = pc.batch * pc.d_model * per_head;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint local = tmp % per_head;
    uint h = tmp / per_head;

    if (local < kv_size) {
        uint i = local / dh;
        uint j = local % dh;
        float sum = 0.0;
        for (uint t = 0u; t < pc.seq_len; ++t) {
            uint k_idx = ((t * pc.d_model + h) * dh + i) * pc.batch + r;
            uint v_idx = ((t * pc.d_model + h) * dh + j) * pc.batch + r;
            sum += k_phi[k_idx] * v_raw[v_idx];
        }
        kv[((h * dh + i) * dh + j) * pc.batch + r] = sum;
    } else {
        uint i = local - kv_size;
        float sum = 0.0;
        for (uint t = 0u; t < pc.seq_len; ++t) {
            uint k_idx = ((t * pc.d_model + h) * dh + i) * pc.batch + r;
            sum += k_phi[k_idx];
        }
        z[(h * dh + i) * pc.batch + r] = sum;
    }
}