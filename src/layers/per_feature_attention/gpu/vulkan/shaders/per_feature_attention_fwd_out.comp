// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_fwd_out.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer QPhiBuf  { float q_phi[]; };
layout(binding = 1, std430) readonly buffer VRawBuf  { float v_raw[]; };
layout(binding = 2, std430) readonly buffer KVBuf    { float kv[]; };
layout(binding = 3, std430) readonly buffer ZBuf     { float z[]; };
layout(binding = 4, std430) readonly buffer ParamsBuf{ float params[]; };
layout(binding = 5, std430) writeonly buffer OutBuf  { float out_val[]; };
layout(binding = 6, std430) writeonly buffer DenomBuf{ float denom[]; };
layout(binding = 7, std430) writeonly buffer AttnBuf { float attn[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.seq_len * pc.d_model;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint h = tmp % pc.d_model;
    uint t = tmp / pc.d_model;

    uint dh = pc.d_head;
    uint head_pc = 10u * dh + 2u;
    uint hbase = h * head_pc;
    uint wo_off = hbase + 9u * dh;
    uint bo_off = hbase + 10u * dh;
    uint sb_off = bo_off + 1u;

    float sb = params[sb_off];
    uint base = ((t * pc.d_model + h) * dh) * pc.batch + r;

    float d = sb;
    for (uint i = 0u; i < dh; ++i) {
        d += q_phi[base + i * pc.batch] * z[(h * dh + i) * pc.batch + r];
    }
    float inv_d = 1.0 / d;
    denom[(t * pc.d_model + h) * pc.batch + r] = d;

    float y = params[bo_off];
    for (uint j = 0u; j < dh; ++j) {
        float v_j = v_raw[base + j * pc.batch];
        float num = sb * v_j;
        for (uint i = 0u; i < dh; ++i) {
            num += q_phi[base + i * pc.batch]
                 * kv[((h * dh + i) * dh + j) * pc.batch + r];
        }
        float a_j = num * inv_d;
        attn[base + j * pc.batch] = a_j;
        y += params[wo_off + j] * a_j;
    }
    out_val[(t * pc.d_model + h) * pc.batch + r] = y;
}