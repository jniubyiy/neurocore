// src/layers/per_feature_attention/gpu/vulkan/shaders/per_feature_attention_fwd_qkv.comp
#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
    uint d_head;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf  { float x[]; };
layout(binding = 1, std430) readonly buffer ParamsBuf { float params[]; };
layout(binding = 2, std430) writeonly buffer QRawBuf  { float q_raw[]; };
layout(binding = 3, std430) writeonly buffer KRawBuf  { float k_raw[]; };
layout(binding = 4, std430) writeonly buffer VRawBuf  { float v_raw[]; };
layout(binding = 5, std430) writeonly buffer QPhiBuf  { float q_phi[]; };
layout(binding = 6, std430) writeonly buffer KPhiBuf  { float k_phi[]; };

float phi(float v) {
    return (v > 0.0) ? (v + 1.0) : (exp(v) + 1.0);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.seq_len * pc.d_model;
    if (idx >= total) return;

    // idx = (t * d_model + h) * batch + r
    uint r = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint h = tmp % pc.d_model;
    uint t = tmp / pc.d_model;

    float x_t = x[(t * pc.d_model + h) * pc.batch + r];
    float x_prev = (t > 0u) ? x[((t - 1u) * pc.d_model + h) * pc.batch + r] : 0.0;
    float dx_t = (t > 0u) ? (x_t - x_prev) : x_t;

    uint dh = pc.d_head;
    uint head_pc = 10u * dh + 2u;
    uint wq_off = h * head_pc;
    uint bq_off = wq_off + 2u * dh;
    uint wk_off = bq_off + dh;
    uint bk_off = wk_off + 2u * dh;
    uint wv_off = bk_off + dh;
    uint bv_off = wv_off + 2u * dh;

    for (uint i = 0u; i < dh; ++i) {
        float qv = params[bq_off + i]
                 + params[wq_off + i * 2u + 0u] * x_t
                 + params[wq_off + i * 2u + 1u] * dx_t;
        float kv = params[bk_off + i]
                 + params[wk_off + i * 2u + 0u] * x_t
                 + params[wk_off + i * 2u + 1u] * dx_t;
        float vv = params[bv_off + i]
                 + params[wv_off + i * 2u + 0u] * x_t
                 + params[wv_off + i * 2u + 1u] * dx_t;

        uint bi = ((t * pc.d_model + h) * dh + i) * pc.batch + r;
        q_raw[bi] = qv;
        k_raw[bi] = kv;
        v_raw[bi] = vv;
        q_phi[bi] = phi(qv);
        k_phi[bi] = phi(kv);
    }
}