// src/layers/relative_position_attention/gpu/vulkan/shaders/relative_position_attention_bwd_dk.comp
//
// Градиент по K для RelativePositionAttention.
//
//   d_k[r,s,i] = scale · Σ_t d_scores[r,t,s] · q[r,t,i]
//
// Один поток на (r, s, i). Цикл по t — линейный, O(seq) на поток.
//
// Push: batch, seq_len, d_model.
// Dispatch: batch · seq_len · d_model потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer DScoresBuf { float d_scores[]; };
layout(binding = 1, std430) readonly buffer QBuf       { float q[]; };
layout(binding = 2, std430) writeonly buffer DKBuf     { float d_k[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.seq_len * pc.d_model;
    if (idx >= total) return;

    uint d = pc.d_model;
    uint seq = pc.seq_len;

    uint r   = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i   = tmp % d;
    uint s   = tmp / d;

    float scale = inversesqrt(float(d));

    float sum = 0.0;
    for (uint t = 0u; t < seq; ++t) {
        uint ds_idx = (t * seq + s) * pc.batch + r;
        uint q_idx  = (t * d + i) * pc.batch + r;
        sum += d_scores[ds_idx] * q[q_idx];
    }
    d_k[idx] = sum * scale;
}