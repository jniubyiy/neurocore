// src/layers/relative_position_attention/gpu/vulkan/shaders/relative_position_attention_bwd_dq.comp
//
// Градиент по Q для RelativePositionAttention.
//
// Раскладка column-major. Элемент (r, t, i) тензора формы (batch, seq_len·d)
// лежит по адресу (t·d + i)·batch + r.
// Элемент (r, t, s) тензора формы (batch, seq_len²) — по адресу
// (t·seq + s)·batch + r.
//
//   d_q[r,t,i] = scale · Σ_s d_scores[r,t,s] · k[r,s,i]
//   scale = 1 / sqrt(d_model)
//
// Один поток на (r, t, i). Цикл по s — линейный, O(seq) на поток.
//
// Push: batch, seq_len, d_model.
// Dispatch: batch · seq_len · d_model потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer DScoresBuf { float d_scores[]; };
layout(binding = 1, std430) readonly buffer KBuf       { float k[]; };
layout(binding = 2, std430) writeonly buffer DQBuf     { float d_q[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.seq_len * pc.d_model;
    if (idx >= total) return;

    uint d = pc.d_model;
    uint seq = pc.seq_len;

    uint r   = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint i   = tmp % d;
    uint t   = tmp / d;

    float scale = inversesqrt(float(d));

    uint ds_base = (t * seq) * pc.batch + r;

    float sum = 0.0;
    for (uint s = 0u; s < seq; ++s) {
        uint k_idx = (s * d + i) * pc.batch + r;
        sum += d_scores[ds_base + s * pc.batch] * k[k_idx];
    }
    d_q[idx] = sum * scale;
}