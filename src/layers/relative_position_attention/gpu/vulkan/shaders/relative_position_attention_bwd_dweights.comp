// src/layers/relative_position_attention/gpu/vulkan/shaders/relative_position_attention_bwd_dweights.comp
//
// Градиент по весам внимания RelativePositionAttention (до softmax-backward).
//
//   d_weights[r,t,s] = Σ_i d_attn_out[r,t,i] · v[r,s,i]
//
// Один поток на (r, t, s). Цикл по i — линейный, O(d) на поток.
//
// Push: batch, seq_len, d_model.
// Dispatch: batch · seq_len · seq_len потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer DAttnOutBuf { float d_attn_out[]; };
layout(binding = 1, std430) readonly buffer VBuf        { float v[]; };
layout(binding = 2, std430) writeonly buffer DWeightsBuf { float d_weights[]; };

void main() {
    uint local = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.seq_len * pc.seq_len;
    if (local >= total) return;

    uint d   = pc.d_model;
    uint seq = pc.seq_len;

    // local = (t * seq + s) * batch + r
    uint r   = local % pc.batch;
    uint tmp = local / pc.batch;
    uint s   = tmp % seq;
    uint t   = tmp / seq;

    uint da_base = (t * d) * pc.batch + r;
    uint v_base  = (s * d) * pc.batch + r;

    float sum = 0.0;
    for (uint i = 0u; i < d; ++i) {
        sum += d_attn_out[da_base + i * pc.batch] * v[v_base + i * pc.batch];
    }
    d_weights[local] = sum;
}