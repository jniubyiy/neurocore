#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

// Входной тензор (row-major: (batch*seq_len) x d_model)
layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

// Градиенты по Q (row-major)
layout(binding = 1, std430) readonly buffer DQBuf {
    float d_q[];
};

// Градиенты по K (row-major)
layout(binding = 2, std430) readonly buffer DKBuf {
    float d_k[];
};

// Градиенты по V (row-major)
layout(binding = 3, std430) readonly buffer DVBuf {
    float d_v[];
};

// Параметры слоя (полный блок: Wq,bq,Wk,bk,Wv,bv,Wo,bo,rel_bias)
layout(binding = 4, std430) readonly buffer ParamsBuf {
    float params[];
};

// Выходной градиент по входу (row-major)
layout(binding = 5, std430) writeonly buffer GradInBuf {
    float gi[];
};

// Буфер градиентов параметров (uint для атомарного накопления)
layout(binding = 6, std430) buffer GradParamsBuf {
    uint grad_params[];
};

// Макрос атомарного сложения float
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_tokens = pc.batch * pc.seq_len;
    uint total_elements = total_tokens * pc.d_model;
    if (idx >= total_elements) return;

    uint token_idx = idx / pc.d_model;
    uint j = idx % pc.d_model;

    uint d = pc.d_model;

    // Смещения параметров (согласовано с CPU/GPU forward)
    uint wq_start = 0u;
    uint bq_start = wq_start + d * d;
    uint wk_start = bq_start + d;
    uint bk_start = wk_start + d * d;
    uint wv_start = bk_start + d;
    uint bv_start = wv_start + d * d;

    // 1. Вычисляем градиент по входу для текущего j
    float gi_val = 0.0;
    for (uint i = 0u; i < d; ++i) {
        gi_val += d_q[token_idx * d + i] * params[wq_start + i * d + j];
        gi_val += d_k[token_idx * d + i] * params[wk_start + i * d + j];
        gi_val += d_v[token_idx * d + i] * params[wv_start + i * d + j];
    }
    gi[token_idx * d + j] = gi_val;

    // 2. Атомарное накопление градиентов по параметрам Q, K, V.
    float x_val = x[token_idx * d + j];

    // W_q[i,j] += d_q[i] * x_val, b_q[i] += d_q[i]
    for (uint i = 0u; i < d; ++i) {
        float dq = d_q[token_idx * d + i];
        ATOMIC_ADD_FLOAT(grad_params[bq_start + i], dq);
        ATOMIC_ADD_FLOAT(grad_params[wq_start + i * d + j], dq * x_val);
    }

    // W_k[i,j] += d_k[i] * x_val, b_k[i] += d_k[i]
    for (uint i = 0u; i < d; ++i) {
        float dk = d_k[token_idx * d + i];
        ATOMIC_ADD_FLOAT(grad_params[bk_start + i], dk);
        ATOMIC_ADD_FLOAT(grad_params[wk_start + i * d + j], dk * x_val);
    }

    // W_v[i,j] += d_v[i] * x_val, b_v[i] += d_v[i]
    for (uint i = 0u; i < d; ++i) {
        float dv = d_v[token_idx * d + i];
        ATOMIC_ADD_FLOAT(grad_params[bv_start + i], dv);
        ATOMIC_ADD_FLOAT(grad_params[wv_start + i * d + j], dv * x_val);
    }
}