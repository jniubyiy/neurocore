// src/layers/relative_position_attention/gpu/vulkan/shaders/relative_position_attention_bwd_output_params.comp
//
// Обратный проход через выходной линейный слой (W_o, b_o) для
// слоя RelativePositionAttention.
//
// Раскладка данных — column-major (для активаций). Веса W_o хранятся
// в row-major.
//
// Вход:
//   go       (batch, seq_len * d_model), column-major:
//     go[(t * d + j) * batch + r]
//   attn_out (batch, seq_len * d_model), column-major:
//     attn_out[(t * d + i) * batch + r]
//   w_o      (d_model, d_model), row-major:
//     w_o[j * d + i]
//   b_o      (d_model,), линейный вектор (не используется в этом шейдере,
//            оставлен для совместимости с интерфейсом)
//
// Выход:
//   d_attn_out (batch, seq_len * d_model), column-major:
//     d_attn_out[(t * d + i) * batch + r]
//
//   grad_params (атомарное накопление через CAS):
//     grad_b_o[j]   += go[r,t,j]
//     grad_W_o[j,i] += go[r,t,j] * attn_out[r,t,i]
//
// Push-константы: batch, seq_len, d_model.
// Dispatch: batch * seq_len потоков (один поток на токен (r, t)).

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer GoBuf {
    float go[];
};

layout(binding = 1, std430) readonly buffer AttnOutBuf {
    float attn_out[];
};

layout(binding = 2, std430) readonly buffer WoBuf {
    float w_o[];
};

layout(binding = 3, std430) readonly buffer BoBuf {
    float b_o[];
};

layout(binding = 4, std430) writeonly buffer DAttnOutBuf {
    float d_attn_out[];
};

layout(binding = 5, std430) buffer GradParamsBuf {
    uint grad_params[];
};

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint token_idx = gl_GlobalInvocationID.x;
    uint total_tokens = pc.batch * pc.seq_len;
    if (token_idx >= total_tokens) return;

    uint d = pc.d_model;

    uint r = token_idx / pc.seq_len;
    uint t = token_idx % pc.seq_len;

    // База для (r, t, 0) в column-major:
    //   элемент (r, t, k) лежит по адресу (t*d + k) * batch + r,
    //   значит шаг по k равен batch.
    uint tok_base = (t * d) * pc.batch + r;

    // Смещения блоков в grad_params. Раскладка:
    //   W_q: [0, d²)
    //   b_q: [d², d² + d)
    //   W_k: [d² + d, 2d² + d)
    //   b_k: [2d² + d, 2d² + 2d)
    //   W_v: [2d² + 2d, 3d² + 2d)
    //   b_v: [3d² + 2d, 3d² + 3d)
    //   W_o: [3d² + 3d, 4d² + 3d)
    //   b_o: [4d² + 3d, 4d² + 4d)
    uint d2 = d * d;
    uint wo_start = 3u * d2 + 3u * d;
    uint bo_start = wo_start + d2;

    // ===== 1. d_attn_out[r, t, i] = Σ_j go[r,t,j] * W_o[j, i] =====
    for (uint i = 0u; i < d; ++i) {
        float sum = 0.0;
        for (uint j = 0u; j < d; ++j) {
            float go_j = go[tok_base + j * pc.batch];
            sum += go_j * w_o[j * d + i];
        }
        d_attn_out[tok_base + i * pc.batch] = sum;
    }

    // ===== 2. Накопление grad_W_o, grad_b_o =====
    for (uint j = 0u; j < d; ++j) {
        float go_j = go[tok_base + j * pc.batch];
        ATOMIC_ADD_FLOAT(grad_params[bo_start + j], go_j);
        for (uint i = 0u; i < d; ++i) {
            float ao_i = attn_out[tok_base + i * pc.batch];
            ATOMIC_ADD_FLOAT(
                grad_params[wo_start + j * d + i],
                go_j * ao_i
            );
        }
    }
}