#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

// Градиент по выходу (row-major, (batch*seq_len) x d_model)
layout(binding = 0, std430) readonly buffer GoBuf {
    float go[];
};

// Результат внимания до выходного линейного слоя (row-major, (batch*seq_len) x d_model)
layout(binding = 1, std430) readonly buffer AttnOutBuf {
    float attn_out[];
};

// Матрица выходного линейного слоя W_o (row-major, d_model x d_model)
layout(binding = 2, std430) readonly buffer WoBuf {
    float wo[];
};

// Смещения выходного линейного слоя b_o (длина d_model)
layout(binding = 3, std430) readonly buffer BoBuf {
    float bo[];
};

// Градиент по attn_out (row-major, (batch*seq_len) x d_model)
layout(binding = 4, std430) writeonly buffer DAttnOutBuf {
    float d_attn_out[];
};

// Общий буфер градиентов параметров (uint для атомарного накопления)
layout(binding = 5, std430) buffer GradParamsBuf {
    uint grad_params[];
};

// Атомарное сложение float через CAS.
// Использование макроса гарантирует, что atomicCompSwap вызывается
// непосредственно с l-value (элементом storage buffer).
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint token_idx = gl_GlobalInvocationID.x;
    uint total_tokens = pc.batch * pc.seq_len;
    if (token_idx >= total_tokens) return;

    uint d = pc.d_model;
    uint base = token_idx * d;

    // 1. Вычисляем d_attn_out[base..base+d] = go * W_o^T
    for (uint i = 0u; i < d; ++i) {
        float sum = 0.0;
        for (uint j = 0u; j < d; ++j) {
            sum += go[base + j] * wo[j * d + i];
        }
        d_attn_out[base + i] = sum;
    }

    // Смещения в общем буфере параметров (согласовано с CPU/GPU layout)
    uint d2 = d * d;
    uint wq_start = 0u;
    uint bq_start = wq_start + d2;
    uint wk_start = bq_start + d;
    uint bk_start = wk_start + d2;
    uint wv_start = bk_start + d;
    uint bv_start = wv_start + d2;
    uint wo_start = bv_start + d;
    uint bo_start = wo_start + d2;

    // 2. Атомарно накапливаем градиенты W_o и b_o
    for (uint j = 0u; j < d; ++j) {
        float go_val = go[base + j];
        ATOMIC_ADD_FLOAT(grad_params[bo_start + j], go_val);
        for (uint i = 0u; i < d; ++i) {
            ATOMIC_ADD_FLOAT(grad_params[wo_start + j * d + i], go_val * attn_out[base + i]);
        }
    }
}