// src/layers/relative_position_attention/gpu/vulkan/shaders/relative_position_attention_bwd_qkv_params.comp
//
// Обратный проход через Q, K и relative position bias для слоя
// RelativePositionAttention.
//
// Раскладка данных — column-major.
//
// Вход:
//   q        (batch, seq_len * d_model), column-major:
//     q[(t * d + i) * batch + r]
//   k        (batch, seq_len * d_model), column-major:
//     k[(s * d + i) * batch + r]
//   d_scores (batch, seq_len * seq_len), column-major:
//     d_scores[(t * seq_len + s) * batch + r]
//
// Выход:
//   d_q (batch, seq_len * d_model), column-major:
//     d_q[(t * d + i) * batch + r] = scale * Σ_s d_scores[r,t,s] * k[r,s,i]
//
//   d_k (batch, seq_len * d_model), column-major:
//     d_k[(s * d + i) * batch + r] = scale * Σ_t d_scores[r,t,s] * q[r,t,i]
//
//   grad_rel_bias (длина 2 * seq_len - 1), атомарное накопление:
//     grad_rel_bias[s - t + (seq_len - 1)] += d_scores[r,t,s]
//
// Push-константы: batch, seq_len, d_model.
// Dispatch: 2 * batch * seq_len * d_model + batch * seq_len * seq_len потоков.
//
// Секции:
//   [0, Nq)          → d_q,        где Nq = batch * seq_len * d_model
//   [Nq, Nq + Nk)    → d_k,        где Nk = batch * seq_len * d_model
//   [Nq + Nk, ...)   → grad_rel_bias, где всего batch * seq_len * seq_len потоков

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer QBuf {
    float q[];
};

layout(binding = 1, std430) readonly buffer KBuf {
    float k[];
};

layout(binding = 2, std430) readonly buffer DScoresBuf {
    float d_scores[];
};

layout(binding = 3, std430) writeonly buffer DQBuf {
    float d_q[];
};

layout(binding = 4, std430) writeonly buffer DKBuf {
    float d_k[];
};

layout(binding = 5, std430) buffer GradRelBiasBuf {
    uint grad_rel_bias[];
};

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint d = pc.d_model;
    uint seq = pc.seq_len;

    uint n_q = pc.batch * seq * d;
    uint n_k = pc.batch * seq * d;
    uint n_scores = pc.batch * seq * seq;

    uint idx = gl_GlobalInvocationID.x;
    uint total = n_q + n_k + n_scores;
    if (idx >= total) return;

    float scale = inversesqrt(float(d));

    if (idx < n_q) {
        // ============ Секция 1: d_q ============
        // idx = (t * d + i) * batch + r
        uint r   = idx % pc.batch;
        uint tmp = idx / pc.batch;
        uint i   = tmp % d;
        uint t   = tmp / d;

        // База для d_scores[r, t, 0]: элемент (r, t, s) лежит
        // по адресу (t * seq + s) * batch + r, шаг по s = batch.
        uint ds_base = (t * seq) * pc.batch + r;

        float sum = 0.0;
        for (uint s = 0u; s < seq; ++s) {
            // k[r, s, i] в column-major: (s * d + i) * batch + r
            uint k_idx = (s * d + i) * pc.batch + r;
            float ds = d_scores[ds_base + s * pc.batch];
            sum += ds * k[k_idx];
        }
        d_q[idx] = sum * scale;
    } else if (idx < n_q + n_k) {
        // ============ Секция 2: d_k ============
        uint local = idx - n_q;
        // local = (s * d + i) * batch + r
        uint r   = local % pc.batch;
        uint tmp = local / pc.batch;
        uint i   = tmp % d;
        uint s   = tmp / d;

        float sum = 0.0;
        for (uint t = 0u; t < seq; ++t) {
            // d_scores[r, t, s] в column-major: (t * seq + s) * batch + r
            uint ds_idx = (t * seq + s) * pc.batch + r;
            // q[r, t, i] в column-major: (t * d + i) * batch + r
            uint q_idx = (t * d + i) * pc.batch + r;
            sum += d_scores[ds_idx] * q[q_idx];
        }
        d_k[local] = sum * scale;
    } else {
        // ============ Секция 3: grad_rel_bias ============
        uint local = idx - n_q - n_k;
        // local = (t * seq + s) * batch + r
        uint r   = local % pc.batch;
        uint tmp = local / pc.batch;
        uint s   = tmp % seq;
        uint t   = tmp / seq;

        int rel_idx = int(s) - int(t) + int(seq - 1u);

        // d_scores[r, t, s] в column-major: (t * seq + s) * batch + r = local
        float ds = d_scores[local];
        ATOMIC_ADD_FLOAT(grad_rel_bias[uint(rel_idx)], ds);
    }
}