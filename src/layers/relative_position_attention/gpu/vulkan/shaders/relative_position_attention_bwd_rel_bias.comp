// src/layers/relative_position_attention/gpu/vulkan/shaders/relative_position_attention_bwd_rel_bias.comp
//
// Градиент по относительному смещению relative_bias для RelativePositionAttention.
//
//   grad_rel_bias[s - t + (seq - 1)] += d_scores[r,t,s]
//
// Накопление через атомарный CAS — все потоки пишут в один компактный
// массив длины (2·seq − 1).
//
// Один поток на (r, t, s). Никаких циклов, O(1) на поток.
//
// Push: batch, seq_len, d_model.
// Dispatch: batch · seq_len · seq_len потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer DScoresBuf  { float d_scores[]; };
layout(binding = 1, std430) buffer GradRelBiasBuf       { uint grad_rel_bias[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint local = gl_GlobalInvocationID.x;
    uint total = pc.batch * pc.seq_len * pc.seq_len;
    if (local >= total) return;

    // local = (t * seq + s) * batch + r
    uint r   = local % pc.batch;
    uint tmp = local / pc.batch;
    uint s   = tmp % pc.seq_len;
    uint t   = tmp / pc.seq_len;

    int rel_idx = int(s) - int(t) + int(pc.seq_len - 1u);

    float ds = d_scores[local];
    ATOMIC_ADD_FLOAT(grad_rel_bias[uint(rel_idx)], ds);
}