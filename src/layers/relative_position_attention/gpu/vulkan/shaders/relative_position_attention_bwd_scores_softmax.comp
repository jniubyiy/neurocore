// src/layers/relative_position_attention/gpu/vulkan/shaders/relative_position_attention_bwd_scores_softmax.comp
//
// Обратный проход через softmax для матрицы скоров внимания
// слоя RelativePositionAttention.
//
// Раскладка данных — column-major.
//
// Вход:
//   weights   (batch, seq_len * seq_len), column-major:
//     weights[(t * seq_len + s) * batch + r]
//   d_weights (batch, seq_len * seq_len), column-major:
//     d_weights[(t * seq_len + s) * batch + r]
//
// Выход:
//   d_scores  (batch, seq_len * seq_len), column-major:
//     d_scores[(t * seq_len + s) * batch + r]
//
// Математика для каждой строки (r, t):
//   dot          = Σ_s weights[r,t,s] * d_weights[r,t,s]
//   d_scores[s]  = weights[r,t,s] * ( d_weights[r,t,s] - dot )
//
// Push-константы: batch, seq_len, d_model (d_model не используется).
// Dispatch: batch * seq_len потоков (один поток на строку (r, t)).

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer WeightsBuf {
    float weights[];
};

layout(binding = 1, std430) readonly buffer DWeightsBuf {
    float d_weights[];
};

layout(binding = 2, std430) writeonly buffer DScoresBuf {
    float d_scores[];
};

void main() {
    uint row = gl_GlobalInvocationID.x;
    uint total_rows = pc.batch * pc.seq_len;
    if (row >= total_rows) return;

    uint seq = pc.seq_len;

    uint r = row / seq;
    uint t = row % seq;

    // База для weights[r, t, 0] в column-major:
    //   элемент (r, t, s) лежит по адресу (t * seq + s) * batch + r,
    //   шаг по s равен batch.
    uint s_base = (t * seq) * pc.batch + r;

    // ===== 1. Вычисляем dot = Σ_s weights[s] * d_weights[s] =====
    float dot = 0.0;
    for (uint s = 0u; s < seq; ++s) {
        uint off = s_base + s * pc.batch;
        dot += weights[off] * d_weights[off];
    }

    // ===== 2. d_scores[s] = weights[s] * (d_weights[s] - dot) =====
    for (uint s = 0u; s < seq; ++s) {
        uint off = s_base + s * pc.batch;
        float w = weights[off];
        float dw = d_weights[off];
        d_scores[off] = w * (dw - dot);
    }
}