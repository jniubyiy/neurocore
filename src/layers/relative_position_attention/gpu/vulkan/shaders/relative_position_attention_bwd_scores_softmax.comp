#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model; // не используется, но сохранён для единообразия
} pc;

layout(binding = 0, std430) readonly buffer WeightsBuf {
    float weights[];   // (batch * seq_len) x seq_len, row-major
};

layout(binding = 1, std430) readonly buffer DWeightsBuf {
    float d_weights[]; // (batch * seq_len) x seq_len, row-major
};

layout(binding = 2, std430) writeonly buffer DScoresBuf {
    float d_scores[];  // (batch * seq_len) x seq_len, row-major
};

void main() {
    uint row = gl_GlobalInvocationID.x; // индекс ряда (batch * t)
    uint total_rows = pc.batch * pc.seq_len;
    if (row >= total_rows) return;

    uint seq = pc.seq_len;
    uint base = row * seq;

    // Вычисляем dot = sum_s weights[base+s] * d_weights[base+s]
    float dot = 0.0;
    for (uint s = 0u; s < seq; ++s) {
        dot += weights[base + s] * d_weights[base + s];
    }

    // d_scores = w * (d_weights - dot)
    for (uint s = 0u; s < seq; ++s) {
        float w = weights[base + s];
        float dw = d_weights[base + s];
        d_scores[base + s] = w * (dw - dot);
    }
}