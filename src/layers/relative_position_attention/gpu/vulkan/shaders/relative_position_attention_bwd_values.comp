#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

// Градиент по attn_out (row-major, (batch*seq_len) x d_model)
layout(binding = 0, std430) readonly buffer DAttnOutBuf {
    float d_attn_out[];
};

// Веса внимания после softmax (row-major, (batch*seq_len) x seq_len)
layout(binding = 1, std430) readonly buffer WeightsBuf {
    float weights[];
};

// Значения V (row-major, (batch*seq_len) x d_model)
layout(binding = 2, std430) readonly buffer VBuf {
    float v[];
};

// Градиент по V (row-major, (batch*seq_len) x d_model)
layout(binding = 3, std430) writeonly buffer DVBuf {
    float d_v[];
};

// Градиент по весам внимания (row-major, (batch*seq_len) x seq_len)
layout(binding = 4, std430) writeonly buffer DWeightsBuf {
    float d_weights[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_tokens = pc.batch * pc.seq_len;
    uint d = pc.d_model;
    uint seq = pc.seq_len;

    uint dv_count = total_tokens * d;
    uint dw_count = total_tokens * seq;

    if (idx < dv_count) {
        // ---- Фаза 1: вычисляем d_v ----
        // idx = token_idx * d + i
        uint token_idx = idx / d;
        uint i = idx % d;

        uint r = token_idx / seq;
        // uint t_local = token_idx % seq; // не используется в фазе 1 напрямую

        float sum = 0.0;
        uint weight_base = token_idx * seq;
        for (uint s = 0u; s < seq; ++s) {
            float w = weights[weight_base + s];
            uint v_idx = (r * seq + s) * d + i;
            sum += w * v[v_idx];
        }
        d_v[idx] = sum;
    } else if (idx < dv_count + dw_count) {
        // ---- Фаза 2: вычисляем d_weights ----
        uint local_idx = idx - dv_count;
        // local_idx = token_idx * seq + s
        uint token_idx = local_idx / seq;
        uint s = local_idx % seq;

        uint r = token_idx / seq;
        // uint t_local = token_idx % seq; // не требуется

        float sum = 0.0;
        uint attn_base = token_idx * d;
        for (uint i = 0u; i < d; ++i) {
            uint v_idx = (r * seq + s) * d + i;
            sum += d_attn_out[attn_base + i] * v[v_idx];
        }
        d_weights[local_idx] = sum;
    }
}