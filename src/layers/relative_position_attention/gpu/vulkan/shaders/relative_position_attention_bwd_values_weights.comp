// src/layers/relative_position_attention/gpu/vulkan/shaders/relative_position_attention_bwd_values_weights.comp
//
// Обратный проход через V и weights для слоя RelativePositionAttention.
//
// Раскладка данных — column-major.
//
// Вход:
//   d_attn_out (batch, seq_len * d_model), column-major:
//     d_attn_out[(t * d + i) * batch + r]
//   weights    (batch, seq_len * seq_len), column-major:
//     weights[(t * seq + s) * batch + r]
//   v          (batch, seq_len * d_model), column-major:
//     v[(s * d + i) * batch + r]
//
// Выход:
//   d_v (batch, seq_len * d_model), column-major:
//     d_v[(s * d + i) * batch + r] = Σ_t d_attn_out[r,t,i] * weights[r,t,s]
//
//   d_weights (batch, seq_len * seq_len), column-major:
//     d_weights[(t * seq + s) * batch + r] = Σ_i d_attn_out[r,t,i] * v[r,s,i]
//
// Push-константы: batch, seq_len, d_model.
// Dispatch: batch * seq_len * d_model + batch * seq_len * seq_len потоков.
//
// Секции:
//   [0, n_dv)         → d_v,        где n_dv = batch * seq_len * d_model
//   [n_dv, n_dv+n_dw) → d_weights,  где n_dw = batch * seq_len * seq_len

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer DAttnOutBuf {
    float d_attn_out[];
};

layout(binding = 1, std430) readonly buffer WeightsBuf {
    float weights[];
};

layout(binding = 2, std430) readonly buffer VBuf {
    float v[];
};

layout(binding = 3, std430) writeonly buffer DVBuf {
    float d_v[];
};

layout(binding = 4, std430) writeonly buffer DWeightsBuf {
    float d_weights[];
};

void main() {
    uint d = pc.d_model;
    uint seq = pc.seq_len;

    uint n_dv = pc.batch * seq * d;
    uint n_dw = pc.batch * seq * seq;
    uint total = n_dv + n_dw;

    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    if (idx < n_dv) {
        // ============ Секция 1: d_v ============
        // idx = (s * d + i) * batch + r
        uint r   = idx % pc.batch;
        uint tmp = idx / pc.batch;
        uint i   = tmp % d;
        uint s   = tmp / d;

        float sum = 0.0;
        for (uint t = 0u; t < seq; ++t) {
            // d_attn_out[r, t, i] = (t * d + i) * batch + r
            uint da_idx = (t * d + i) * pc.batch + r;
            // weights[r, t, s] = (t * seq + s) * batch + r
            uint w_idx = (t * seq + s) * pc.batch + r;
            sum += d_attn_out[da_idx] * weights[w_idx];
        }
        d_v[idx] = sum;
    } else {
        // ============ Секция 2: d_weights ============
        uint local = idx - n_dv;
        // local = (t * seq + s) * batch + r
        uint r   = local % pc.batch;
        uint tmp = local / pc.batch;
        uint s   = tmp % seq;
        uint t   = tmp / seq;

        // База для d_attn_out[r, t, 0] в column-major: (t * d + 0) * batch + r
        // шаг по i = batch.
        uint da_base = (t * d) * pc.batch + r;
        // База для v[r, s, 0] в column-major: (s * d + 0) * batch + r
        // шаг по i = batch.
        uint v_base = (s * d) * pc.batch + r;

        float sum = 0.0;
        for (uint i = 0u; i < d; ++i) {
            sum += d_attn_out[da_base + i * pc.batch] * v[v_base + i * pc.batch];
        }
        d_weights[local] = sum;
    }
}