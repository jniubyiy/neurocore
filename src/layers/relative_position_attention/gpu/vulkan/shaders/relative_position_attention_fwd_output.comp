// src/layers/relative_position_attention/gpu/vulkan/shaders/relative_position_attention_fwd_output.comp
//
// Финальный forward-шейдер RelativePositionAttention: вычисление выхода
// после выходного линейного слоя W_o с использованием весов внимания.
//
// Раскладка данных — column-major.
//
// Вход:
//   weights (batch, seq_len * seq_len), column-major:
//     weights[(t * seq_len + s) * batch + r]
//   v (batch, seq_len * d_model), column-major:
//     v[(s * d_model + i) * batch + r]
//   w_o (d_model, d_model), row-major:
//     w_o[j * d_model + i]
//   b_o (d_model,), линейный вектор
//
// Выход:
//   y (batch, seq_len * d_model), column-major:
//     y[(t * d_model + j) * batch + r]
//
// Математика для каждого (r, t, j):
//   y[r,t,j] = b_o[j] + Σ_s weights[r,t,s] * ( Σ_i v[r,s,i] * w_o[j,i] )
//
// Push-константы: batch, seq_len, d_model.
// Dispatch: batch * seq_len * d_model потоков (один поток на выходной элемент).

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer WeightsBuf {
    float weights[];
};

layout(binding = 1, std430) readonly buffer VBuf {
    float v[];
};

layout(binding = 2, std430) readonly buffer WoBuf {
    float w_o[];
};

layout(binding = 3, std430) readonly buffer BoBuf {
    float b_o[];
};

layout(binding = 4, std430) writeonly buffer OutBuf {
    float y[];
};

void main() {
    uint d = pc.d_model;
    uint seq = pc.seq_len;
    uint total = pc.batch * seq * d;

    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    // Восстанавливаем (r, t, j) из column-major индекса:
    //   idx = (t * d + j) * batch + r
    uint r   = idx % pc.batch;
    uint tmp = idx / pc.batch;
    uint j   = tmp % d;
    uint t   = tmp / d;

    // База для weights[r, t, 0] в column-major:
    //   элемент (r, t, s) лежит по адресу (t * seq + s) * batch + r,
    //   шаг по s равен batch.
    uint w_base = (t * seq) * pc.batch + r;

    // База для w_o[j, 0] в row-major.
    uint wo_base = j * d;

    float sum = b_o[j];
    for (uint s = 0u; s < seq; ++s) {
        float w_val = weights[w_base + s * pc.batch];

        // База для v[r, s, 0] в column-major:
        //   элемент (r, s, i) лежит по адресу (s * d + i) * batch + r,
        //   шаг по i равен batch.
        uint v_base = (s * d) * pc.batch + r;

        float dot = 0.0;
        for (uint i = 0u; i < d; ++i) {
            dot += v[v_base + i * pc.batch] * w_o[wo_base + i];
        }

        sum += w_val * dot;
    }

    y[idx] = sum;
}