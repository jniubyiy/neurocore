#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer WeightsBuf {
    float weights[];    // (batch * seq_len) x seq_len, row-major
};

layout(binding = 1, std430) readonly buffer VBuf {
    float v[];          // (batch * seq_len) x d_model, row-major
};

layout(binding = 2, std430) readonly buffer WoBuf {
    float w_o[];        // d_model x d_model, row-major
};

layout(binding = 3, std430) readonly buffer BoBuf {
    float b_o[];        // d_model
};

layout(binding = 4, std430) writeonly buffer OutBuf {
    float y[];          // (batch * seq_len) x d_model, row-major
};

void main() {
    uint total = pc.batch * pc.seq_len * pc.d_model;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint token_idx = idx / pc.d_model;   // глобальный индекс токена (от 0 до batch*seq_len-1)
    uint j = idx % pc.d_model;           // выходной признак

    uint d = pc.d_model;
    uint seq = pc.seq_len;
    uint batch = pc.batch;

    uint r = token_idx / seq;            // номер примера
    uint t = token_idx % seq;            // позиция токена

    float y_val = b_o[j];

    // y[token,j] = sum_s weights[token,s] * (sum_i V[s,i] * W_o[j,i]) + b_o[j]
    for (uint s = 0u; s < seq; ++s) {
        uint v_base = (r * seq + s) * d;
        float dot = 0.0;
        for (uint i = 0u; i < d; ++i) {
            dot += v[v_base + i] * w_o[j * d + i];
        }
        y_val += weights[token_idx * seq + s] * dot;
    }

    y[idx] = y_val;
}