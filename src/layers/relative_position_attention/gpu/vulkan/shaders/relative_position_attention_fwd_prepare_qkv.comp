#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];          // row-major: (batch * seq_len) x d_model
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[];     // содержит все параметры, включая W_q, b_q, W_k, b_k, W_v, b_v
};

layout(binding = 2, std430) writeonly buffer QBuf {
    float q[];          // row-major: (batch * seq_len) x d_model
};

layout(binding = 3, std430) writeonly buffer KBuf {
    float k[];
};

layout(binding = 4, std430) writeonly buffer VBuf {
    float v[];
};

void main() {
    uint total_qkv = pc.batch * pc.seq_len * pc.d_model * 3u;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total_qkv) return;

    uint buffer_type = idx / (pc.batch * pc.seq_len * pc.d_model);
    uint remaining = idx % (pc.batch * pc.seq_len * pc.d_model);
    uint token = remaining / pc.d_model;
    uint out_idx = remaining % pc.d_model;

    // Смещения в params
    uint d = pc.d_model;
    uint wq_start = 0u;
    uint bq_start = wq_start + d * d;
    uint wk_start = bq_start + d;
    uint bk_start = wk_start + d * d;
    uint wv_start = bk_start + d;
    uint bv_start = wv_start + d * d;

    uint w_start;
    uint b_start;
    if (buffer_type == 0u) {
        w_start = wq_start;
        b_start = bq_start;
    } else if (buffer_type == 1u) {
        w_start = wk_start;
        b_start = bk_start;
    } else {
        w_start = wv_start;
        b_start = bv_start;
    }

    // Линейное преобразование
    float sum = params[b_start + out_idx];
    uint input_base = token * d;
    for (uint j = 0u; j < d; ++j) {
        sum += x[input_base + j] * params[w_start + out_idx * d + j];
    }

    // Запись результата в соответствующий буфер
    uint out_pos = token * d + out_idx;
    if (buffer_type == 0u) {
        q[out_pos] = sum;
    } else if (buffer_type == 1u) {
        k[out_pos] = sum;
    } else {
        v[out_pos] = sum;
    }
}