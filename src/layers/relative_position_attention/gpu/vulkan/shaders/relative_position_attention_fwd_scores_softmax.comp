#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint seq_len;
    uint d_model;
} pc;

layout(binding = 0, std430) readonly buffer QBuf {
    float q[];          // row-major: (batch * seq_len) x d_model
};

layout(binding = 1, std430) readonly buffer KBuf {
    float k[];          // row-major: (batch * seq_len) x d_model
};

layout(binding = 2, std430) readonly buffer RelBiasBuf {
    float rel_bias[];   // длина 2*seq_len - 1
};

// ScoresBuf используется и для записи, и для чтения (вычисление softmax),
// поэтому его квалификатор не может быть writeonly.
layout(binding = 3, std430) buffer ScoresBuf {
    float scores[];     // (batch * seq_len) x seq_len, row-major
};

layout(binding = 4, std430) writeonly buffer WeightsBuf {
    float weights[];    // (batch * seq_len) x seq_len, row-major
};

void main() {
    uint row = gl_GlobalInvocationID.x; // глобальный индекс строки (batch*t)
    uint total_rows = pc.batch * pc.seq_len;
    if (row >= total_rows) return;

    uint r = row / pc.seq_len;
    uint t = row % pc.seq_len;
    uint q_base = row * pc.d_model;
    uint seq = pc.seq_len;
    uint d = pc.d_model;

    float scale = inversesqrt(float(d));

    // Первый проход: вычисляем все скоры и находим максимум
    float max_score = -1e30;
    for (uint s = 0u; s < seq; ++s) {
        uint k_base = (r * seq + s) * d;
        float dot = 0.0;
        for (uint j = 0u; j < d; ++j) {
            dot += q[q_base + j] * k[k_base + j];
        }
        dot *= scale;

        // Относительный индекс смещения
        int rel_idx = int(s) - int(t) + int(seq - 1u);
        float bias_val = rel_bias[uint(rel_idx)];

        float score = dot + bias_val;
        scores[row * seq + s] = score;
        if (score > max_score) {
            max_score = score;
        }
    }

    // Второй проход: softmax
    float sum_exp = 0.0;
    for (uint s = 0u; s < seq; ++s) {
        float e = exp(scores[row * seq + s] - max_score);
        sum_exp += e;
    }
    for (uint s = 0u; s < seq; ++s) {
        float e = exp(scores[row * seq + s] - max_score);
        weights[row * seq + s] = e / sum_exp;
    }
}