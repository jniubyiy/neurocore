#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major: x[c * batch + r]
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[]; // [gamma; eps_raw] для каждого признака (всего 2*features)
};

layout(binding = 3, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 4, std430) buffer GradParamsBuf {
    uint grad_params[]; // битовое представление float
};

layout(binding = 5, std430) readonly buffer RowRmsSqBuf {
    float row_rms_sq[]; // размер batch
};

// Макрос атомарного сложения float через CAS
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

// Нижняя граница для ε (синхронно с forward-шейдером и CPU-путем).
const float EPS_MIN = 1e-6;

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint c = idx / pc.batch;

    float gamma   = params[0 * pc.features + c];
    float eps_raw = params[1 * pc.features + c];
    // Параметризация: ε = EPS_MIN + exp(eps_raw).
    float eps     = EPS_MIN + exp(eps_raw);

    float mean_sq = row_rms_sq[r];
    float denom   = sqrt(mean_sq + eps);
    float denom3  = denom * denom * denom;

    float x_val = x[idx];
    float gout  = go[idx];

    // Градиент по входу (фикс B):
    //   gi_c = go_c·γ_c/d_c − (x_c / F) · Σ_j go_j·γ_j·x_j / d_j³
    //
    // Куб знаменателя стоит ПОД суммой по j, поскольку ε_j — per-feature.
    // При ε_j = const формула совпадает с PyTorch-канонической.
    float sum_j = 0.0;
    for (uint j = 0u; j < pc.features; ++j) {
        float gamma_j   = params[0 * pc.features + j];
        float eps_raw_j = params[1 * pc.features + j];
        float eps_j     = EPS_MIN + exp(eps_raw_j);
        float denom_j   = sqrt(mean_sq + eps_j);
        float d3        = denom_j * denom_j * denom_j;
        float x_j       = x[j * pc.batch + r];
        float go_j      = go[j * pc.batch + r];
        sum_j += go_j * gamma_j * x_j / d3;
    }

    float term1 = gout * gamma / denom;
    float term2 = (1.0 / float(pc.features)) * x_val * sum_j;
    gi[idx] = term1 - term2;

    // Градиенты параметров.
    //   ∂y/∂γ  = x / d
    //   ∂y/∂ε  = −0.5 · γ · x / d³
    float d_gamma = gout * x_val / denom;
    float d_eps   = -0.5 * gout * gamma * x_val / denom3;

    // Chain-rule к eps_raw: ∂L/∂eps_raw = ∂L/∂ε · exp(eps_raw).
    float deps_draw = exp(eps_raw);
    float d_eps_raw = d_eps * deps_draw;

    ATOMIC_ADD_FLOAT(grad_params[0 * pc.features + c], d_gamma);
    ATOMIC_ADD_FLOAT(grad_params[1 * pc.features + c], d_eps_raw);
}