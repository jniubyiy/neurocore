#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major: x[c * batch + r]
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[]; // [gamma; eps] для каждого признака (всего 2*features)
};

layout(binding = 3, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 4, std430) buffer GradParamsBuf {
    uint grad_params[]; // битовое представление float
};

layout(binding = 5, std430) readonly buffer RowRmsSqBuf {
    float row_rms_sq[]; // размер batch
};

// Вспомогательная функция атомарного сложения float
void atomicAddFloat(inout uint target, float value) {
    uint expected = target;
    uint desired;
    do {
        float cur = uintBitsToFloat(expected);
        desired = floatBitsToUint(cur + value);
        uint old = atomicCompSwap(target, expected, desired);
        if (old == expected) return;
        expected = old;
    } while (true);
}

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint c = idx / pc.batch;

    float gamma = params[0 * pc.features + c];
    float eps   = params[1 * pc.features + c];

    float mean_sq = row_rms_sq[r];
    float denom = sqrt(mean_sq + eps);

    float x_val = x[idx];
    float gout  = go[idx];

    // Градиент по входу (упрощённо, без учёта влияния на статистику)
    gi[idx] = gout * gamma / denom;

    // Накопление градиентов по параметрам
    float d_gamma = gout * x_val / denom;
    float d_eps   = -0.5 * gout * gamma * x_val / (denom * denom * denom);

    atomicAddFloat(grad_params[0 * pc.features + c], d_gamma);
    atomicAddFloat(grad_params[1 * pc.features + c], d_eps);
}