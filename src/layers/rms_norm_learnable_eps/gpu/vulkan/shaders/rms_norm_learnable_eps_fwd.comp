#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];   // column-major: x[c * batch + r]
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[]; // [gamma; eps] для каждого признака (всего 2*features)
};

layout(binding = 2, std430) readonly buffer RowRmsSqBuf {
    float row_rms_sq[]; // размер batch
};

layout(binding = 3, std430) writeonly buffer OutputBuf {
    float y[];          // column-major: y[c * batch + r]
};

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint c = idx / pc.batch;

    float gamma = params[0 * pc.features + c];
    float eps   = params[1 * pc.features + c];

    float mean_sq = row_rms_sq[r];
    float denom = sqrt(mean_sq + eps);

    y[idx] = (x[idx] / denom) * gamma;
}