#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[]; // [gamma; eps]
};

layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];
};

void main() {
    uint total = pc.batch * pc.features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint c = idx / pc.batch; // feature
    uint r = idx % pc.batch; // sample

    float gamma = params[0 * pc.features + c];
    float eps   = params[1 * pc.features + c];

    // Заглушка: используем mean_sq = 1.0 для простоты (некорректно, но компилируется)
    float mean_sq = 1.0; // TODO: вычислить реальное среднее квадратов по строке r

    float denom = sqrt(mean_sq + eps);
    y[idx] = (x[idx] / denom) * gamma;
}