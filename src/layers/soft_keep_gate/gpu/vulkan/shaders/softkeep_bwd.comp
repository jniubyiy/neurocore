// src/layers/soft_keep_gate/gpu/vulkan/shaders/softkeep_bwd.comp
//
// Обратный проход SoftKeepGate на GPU (column-major).
//
// Формулы (совпадают с CPU-версией):
//   z = (thresh[c] − |x|) / T
//   s = sigmoid(z)
//   ds = s · (1 − s) / T
//   df_dx = s − |x| · ds
//
//   gi[i]            = go[i] · df_dx
//   grad_thresh[c]  += go[i] · x_val · ds
//
// Накопление через канонический макрос ATOMIC_ADD_FLOAT над uint-буфером.
//
// Push-константы: batch, features, temperature.
// Dispatch: batch · features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint  batch;
    uint  features;
    float temperature;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf    { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf  { float go[]; };
layout(binding = 2, std430) readonly buffer ThreshBuf   { float thresh[]; };
layout(binding = 3, std430) writeonly buffer GradInBuf  { float gi[]; };
layout(binding = 4, std430) buffer GradThreshBuf        { uint gthresh[]; };

#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.batch * pc.features) return;

    uint c = i / pc.batch;

    float x_val = x[i];
    float abs_x = abs(x_val);
    float z = (thresh[c] - abs_x) / pc.temperature;
    float s = 1.0 / (1.0 + exp(-z));
    float ds = s * (1.0 - s) / pc.temperature;
    float df_dx = s - abs_x * ds;

    gi[i] = go[i] * df_dx;

    // Градиент по порогу (знак + совпадает с CPU).
    float inc = go[i] * x_val * ds;
    ATOMIC_ADD_FLOAT(gthresh[c], inc);
}