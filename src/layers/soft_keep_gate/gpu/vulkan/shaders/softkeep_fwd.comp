// src/layers/soft_keep_gate/gpu/vulkan/shaders/softkeep_fwd.comp
//
// Прямой проход SoftKeepGate на GPU (column-major).
//
// Раскладка активаций — column-major: x[c * batch + r].
//
// Формула:
//   z = (thresh[c] − |x|) / temperature
//   s = sigmoid(z)
//   y = x · s
//
// Push-константы: batch, features, temperature.
// Dispatch: batch · features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint  batch;
    uint  features;
    float temperature;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf  { float x[]; };
layout(binding = 1, std430) readonly buffer ThreshBuf { float thresh[]; };
layout(binding = 2, std430) writeonly buffer OutputBuf { float y[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.batch * pc.features) return;

    uint c = i / pc.batch;

    float x_val = x[i];
    float z = (thresh[c] - abs(x_val)) / pc.temperature;
    float s = 1.0 / (1.0 + exp(-z));
    y[i] = x_val * s;
}