#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    float temperature;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};
layout(binding = 1, std430) readonly buffer ThreshBuf {
    float thresh[];
};
layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;

    uint c = i % pc.features;
    float x_val = x[i];
    float z = (thresh[c] - abs(x_val)) / pc.temperature;
    float s = 1.0f / (1.0f + exp(-z));
    y[i] = x_val * s;
}