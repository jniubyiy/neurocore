#version 450
// NO extensions required

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    float temperature;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf { float go[]; };
layout(binding = 2, std430) readonly buffer ThreshBuf { float thresh[]; };
layout(binding = 3, std430) writeonly buffer GradInBuf { float gi[]; };
layout(binding = 4, std430) buffer GradThreshBuf { int gthresh[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) return;

    uint c = i % pc.features;
    float x_val = x[i];
    float abs_x = abs(x_val);
    float z = (abs_x - thresh[c]) / pc.temperature;
    float s = 1.0f / (1.0f + exp(-z));
    float ds = s * (1.0f - s) / pc.temperature;
    float df_dx = s + abs_x * ds;

    gi[i] = go[i] * df_dx;

    // Атомарное сложение для gthresh[c]
    float d_s_dthr = -ds;
    float inc = go[i] * x_val * d_s_dthr;
    int expected = gthresh[c];
    int desired;
    do {
        float cur = intBitsToFloat(expected);
        desired = floatBitsToInt(cur + inc);
        int old = atomicCompSwap(gthresh[c], expected, desired);
        if (old == expected) break;
        expected = old;
    } while (true);
}