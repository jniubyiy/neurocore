// src/layers/softmax/gpu/vulkan/shaders/softmax.comp
//
// Прямой проход Softmax на GPU (column-major, workgroup на строку).
//
// Раскладка активаций — column-major: x[c · batch + r], где r — строка (пример).
// Группа из 256 потоков обрабатывает одну строку r. Внутри группы применяется
// двухэтапная shared-редукция: max, затем сумма экспонент.
//
// Push-константы: batch, features.
// Dispatch: batch workgroups, каждая — 256 потоков (local_size_x = 256).

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf  { float data[]; };
layout(binding = 1, std430) writeonly buffer OutputBuf { float result[]; };

shared float partial[256];

void main() {
    uint r   = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (r >= pc.batch) return;

    uint stride = gl_WorkGroupSize.x;
    uint cols = pc.features;

    // ============ 1. Максимум по строке r ============
    // Элемент (r, c) лежит по адресу c · batch + r.
    float local_max = -3.4e38; // ≈ -FLT_MAX
    for (uint c = tid; c < cols; c += stride) {
        float v = data[c * pc.batch + r];
        if (v > local_max) local_max = v;
    }

    partial[tid] = local_max;
    barrier();

    for (uint s = stride / 2u; s > 0u; s >>= 1u) {
        if (tid < s) {
            if (partial[tid + s] > partial[tid]) {
                partial[tid] = partial[tid + s];
            }
        }
        barrier();
    }
    float max_val = partial[0];
    barrier();

    // ============ 2. Сумма экспонент ============
    float local_sum = 0.0;
    for (uint c = tid; c < cols; c += stride) {
        local_sum += exp(data[c * pc.batch + r] - max_val);
    }

    partial[tid] = local_sum;
    barrier();

    for (uint s = stride / 2u; s > 0u; s >>= 1u) {
        if (tid < s) {
            partial[tid] += partial[tid + s];
        }
        barrier();
    }
    float sum_exp = partial[0];
    float inv_sum = 1.0 / sum_exp;
    barrier();

    // ============ 3. Запись нормализованных значений ============
    for (uint c = tid; c < cols; c += stride) {
        uint idx = c * pc.batch + r;
        result[idx] = exp(data[idx] - max_val) * inv_sum;
    }
}