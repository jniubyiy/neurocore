// src/layers/softmax/gpu/vulkan/shaders/softmax_backward.comp
//
// Обратный проход Softmax на GPU (column-major, workgroup на строку).
//
// Формула (по строкам):
//   dot[r]      = Σ_c y[c, r] · go[c, r]
//   gi[c, r]    = y[c, r] · (go[c, r] − dot[r])
//
// y — выход прямого softmax (column-major). Группа из 256 потоков обрабатывает
// одну строку r. Одна shared-редукция для dot.
//
// Push-константы: batch, features.
// Dispatch: batch workgroups.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer YBuf       { float y_data[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf { float grad_out_data[]; };
layout(binding = 2, std430) writeonly buffer GradInBuf { float grad_in_data[]; };

shared float partial[256];

void main() {
    uint r   = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (r >= pc.batch) return;

    uint stride = gl_WorkGroupSize.x;
    uint cols = pc.features;

    // ============ 1. dot = Σ_c y[c,r] · go[c,r] ============
    float local_dot = 0.0;
    for (uint c = tid; c < cols; c += stride) {
        uint idx = c * pc.batch + r;
        local_dot += y_data[idx] * grad_out_data[idx];
    }

    partial[tid] = local_dot;
    barrier();

    for (uint s = stride / 2u; s > 0u; s >>= 1u) {
        if (tid < s) {
            partial[tid] += partial[tid + s];
        }
        barrier();
    }
    float dot = partial[0];
    barrier();

    // ============ 2. Градиент по входу ============
    for (uint c = tid; c < cols; c += stride) {
        uint idx = c * pc.batch + r;
        float y_val = y_data[idx];
        grad_in_data[idx] = y_val * (grad_out_data[idx] - dot);
    }
}