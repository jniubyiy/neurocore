#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];
};

layout(binding = 2, std430) readonly buffer ParamsBuf {
    float params[];
};

layout(binding = 3, std430) writeonly buffer GradInBuf {
    float gi[];
};

layout(binding = 4, std430) buffer GradParamsBuf {
    uint grad_params[]; // битовое представление float
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    uint c = idx % pc.features;
    float x_val = x[idx];
    float gout = go[idx];
    float logit = params[c];
    float temperature = abs(params[pc.features]) + 1e-6;
    float mask = 1.0 / (1.0 + exp(-logit / temperature));
    float dsig_dlogit = mask * (1.0 - mask) / temperature;
    float dsig_dtemp = -mask * (1.0 - mask) * logit / (temperature * temperature);

    // Градиент по входу
    gi[idx] = gout * mask;

    // Градиенты по параметрам (атомарное накопление)
    // Для logits[c]
    {
        float inc = gout * x_val * dsig_dlogit;
        uint expected = grad_params[c];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_params[c], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }

    // Для temperature (накапливаем в grad_params[features])
    {
        float inc = gout * x_val * dsig_dtemp;
        uint expected = grad_params[pc.features];
        uint desired;
        do {
            float cur = uintBitsToFloat(expected);
            desired = floatBitsToUint(cur + inc);
            uint old = atomicCompSwap(grad_params[pc.features], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
}