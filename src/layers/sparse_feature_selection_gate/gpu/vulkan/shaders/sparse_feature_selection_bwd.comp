// src/layers/sparse_feature_selection_gate/gpu/vulkan/shaders/sparse_feature_selection_bwd.comp
//
// Обратный проход SparseFeatureSelectionGate на GPU.
//
// Раскладка активаций — column-major: x[c * batch + r].
// Для элемента с индексом idx:
//   batch = total / features
//   c = idx / batch,  r = idx % batch.
//
// y = x * mask,  mask = sigmoid(logit[c] / T)
//
// ∂y/∂x          = mask
// ∂y/∂logit[c]  += go * x * mask * (1 - mask) / T
// ∂y/∂T         += go * x * mask * (1 - mask) * (-logit / T²)
//
// Push: total, features.
// Dispatch: total потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;
    uint features;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf     { float x[]; };
layout(binding = 1, std430) readonly buffer GradOutBuf   { float go[]; };
layout(binding = 2, std430) readonly buffer ParamsBuf    { float params[]; };
layout(binding = 3, std430) writeonly buffer GradInBuf   { float gi[]; };
layout(binding = 4, std430) buffer GradParamsBuf         { uint grad_params[]; };

// Канонический макрос атомарного сложения float через CAS.
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    // Column-major: c = idx / batch.
    uint batch = pc.total / pc.features;
    uint c = idx / batch;

    float x_val = x[idx];
    float gout = go[idx];
    float logit = params[c];
    float temperature = abs(params[pc.features]) + 1e-6;
    float mask = 1.0 / (1.0 + exp(-logit / temperature));
    float dsig_dlogit = mask * (1.0 - mask) / temperature;
    float dsig_dtemp  = -mask * (1.0 - mask) * logit / (temperature * temperature);

    // Градиент по входу
    gi[idx] = gout * mask;

    // Градиент по логитам: накопление через канонический макрос.
    ATOMIC_ADD_FLOAT(grad_params[c], gout * x_val * dsig_dlogit);

    // Градиент по температуре: накопление через канонический макрос.
    ATOMIC_ADD_FLOAT(grad_params[pc.features], gout * x_val * dsig_dtemp);
}