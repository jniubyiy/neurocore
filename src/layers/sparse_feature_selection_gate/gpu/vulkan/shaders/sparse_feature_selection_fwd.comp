#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint total;      // batch * features
    uint features;   // количество признаков
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];
};

layout(binding = 1, std430) readonly buffer ParamsBuf {
    float params[]; // [logits (features), temperature (1)]
};

layout(binding = 2, std430) writeonly buffer OutputBuf {
    float y[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.total) return;

    uint c = idx % pc.features;
    float x_val = x[idx];
    float logit = params[c];
    float temperature = abs(params[pc.features]) + 1e-6;
    float mask = 1.0 / (1.0 + exp(-logit / temperature));
    y[idx] = x_val * mask;
}