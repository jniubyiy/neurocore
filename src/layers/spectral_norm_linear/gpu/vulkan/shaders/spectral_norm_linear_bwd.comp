#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
    float scale;
    float sigma;
    uint phase;   // 0 = градиенты параметров, 1 = градиент по входу
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];      // column-major: x[j * batch + r]
};

layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];     // column-major: go[i * batch + r]
};

layout(binding = 2, std430) readonly buffer WeightBuf {
    float W[];      // row-major: W[i * in_features + j]
};

layout(binding = 3, std430) buffer GradWeightBuf {
    uint grad_W[];  // битовое представление float, размер out_features * in_features
};

layout(binding = 4, std430) buffer GradBiasBuf {
    uint grad_bias[]; // битовое представление float, размер out_features
};

layout(binding = 5, std430) buffer GradScaleBuf {
    uint grad_scale;  // битовое представление float, единственный элемент
};

layout(binding = 6, std430) writeonly buffer GradInBuf {
    float gi[];     // column-major: gi[j * batch + r]
};

// Вспомогательная функция атомарного сложения float.
// Проблема с inout параметром устранена: используем макрос для прямого кода.
#define ATOMIC_ADD_FLOAT(target, value) \
{ \
    uint expected = target; \
    uint desired; \
    do { \
        float cur = uintBitsToFloat(expected); \
        desired = floatBitsToUint(cur + (value)); \
        uint old = atomicCompSwap(target, expected, desired); \
        if (old == expected) break; \
        expected = old; \
    } while (true); \
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (pc.phase == 0u) {
        // ==================== Градиенты по параметрам ====================
        uint total = pc.batch * pc.out_features;
        if (idx >= total) return;

        uint r = idx % pc.batch;
        uint i = idx / pc.batch; // выходной признак

        float gout = go[idx]; // go[i * batch + r]

        // Вычисляем (W x)_i = sum_j W[i,j] * x[j,r]
        float wx = 0.0;
        for (uint j = 0u; j < pc.in_features; ++j) {
            wx += W[i * pc.in_features + j] * x[j * pc.batch + r];
        }

        // Градиент по bias
        ATOMIC_ADD_FLOAT(grad_bias[i], gout);

        // Градиент по scale
        float grad_s = gout * wx / pc.sigma;
        ATOMIC_ADD_FLOAT(grad_scale, grad_s);

        // Градиент по W
        float effective_scale = pc.scale / pc.sigma;
        for (uint j = 0u; j < pc.in_features; ++j) {
            float contrib = effective_scale * gout * x[j * pc.batch + r];
            ATOMIC_ADD_FLOAT(grad_W[i * pc.in_features + j], contrib);
        }
    } else {
        // ==================== Градиент по входу ====================
        uint total = pc.batch * pc.in_features;
        if (idx >= total) return;

        uint r = idx % pc.batch;
        uint j = idx / pc.batch; // входной признак

        float effective_scale = pc.scale / pc.sigma;
        float sum = 0.0;
        for (uint i = 0u; i < pc.out_features; ++i) {
            sum += effective_scale * W[i * pc.in_features + j] * go[i * pc.batch + r];
        }

        gi[idx] = sum;
    }
}