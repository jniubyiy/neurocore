#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint in_features;
    uint out_features;
    float scale;
    float sigma;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float x[];      // column-major: x[j * batch + r]
};

layout(binding = 1, std430) readonly buffer WeightBuf {
    float W[];      // row-major: W[i * in_features + j]
};

layout(binding = 2, std430) readonly buffer BiasBuf {
    float bias[];   // длина out_features
};

layout(binding = 3, std430) writeonly buffer OutputBuf {
    float y[];      // column-major: y[i * batch + r]
};

void main() {
    uint total = pc.batch * pc.out_features;
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= total) return;

    uint r = idx % pc.batch;
    uint i = idx / pc.batch; // индекс выходного признака

    float effective_scale = pc.scale / pc.sigma;

    float sum = bias[i];
    for (uint j = 0u; j < pc.in_features; ++j) {
        sum += W[i * pc.in_features + j] * x[j * pc.batch + r] * effective_scale;
    }

    y[idx] = sum;
}