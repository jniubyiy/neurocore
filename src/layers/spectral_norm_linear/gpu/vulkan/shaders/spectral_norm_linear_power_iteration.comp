#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint in_features;
    uint out_features;
    float eps;
} pc;

layout(binding = 0, std430) readonly buffer WeightBuf {
    float W[];   // out_features * in_features, row-major: W[i*in_features + j]
};

layout(binding = 1, std430) buffer UBuf {
    float u[];   // in_features
};

layout(binding = 2, std430) buffer VBuf {
    float v[];   // out_features
};

layout(binding = 3, std430) writeonly buffer SigmaBuf {
    float sigma;
};

// Максимальные поддерживаемые размеры (можно увеличить при необходимости)
#define MAX_DIM 256

void main() {
    if (gl_GlobalInvocationID.x != 0u) return;

    uint in_feat = pc.in_features;
    uint out_feat = pc.out_features;

    if (in_feat > MAX_DIM || out_feat > MAX_DIM) {
        // В случае превышения максимального размера возвращаемся без изменений.
        // В реальной интеграции следует использовать редукции.
        return;
    }

    float v_new[MAX_DIM];
    float u_new[MAX_DIM];

    // 1. v = W * u
    for (uint i = 0u; i < out_feat; ++i) {
        float sum = 0.0;
        for (uint j = 0u; j < in_feat; ++j) {
            sum += W[i * in_feat + j] * u[j];
        }
        v_new[i] = sum;
    }

    // Нормализация v
    float norm_v = 0.0;
    for (uint i = 0u; i < out_feat; ++i) {
        norm_v += v_new[i] * v_new[i];
    }
    norm_v = sqrt(norm_v);
    if (norm_v > pc.eps) {
        for (uint i = 0u; i < out_feat; ++i) {
            v[i] = v_new[i] / norm_v;
        }
    } else {
        for (uint i = 0u; i < out_feat; ++i) {
            v[i] = v_new[i];
        }
    }

    // 2. u = W^T * v
    for (uint j = 0u; j < in_feat; ++j) {
        float sum = 0.0;
        for (uint i = 0u; i < out_feat; ++i) {
            sum += W[i * in_feat + j] * v[i];
        }
        u_new[j] = sum;
    }

    // Нормализация u
    float norm_u = 0.0;
    for (uint j = 0u; j < in_feat; ++j) {
        norm_u += u_new[j] * u_new[j];
    }
    norm_u = sqrt(norm_u);
    if (norm_u > pc.eps) {
        for (uint j = 0u; j < in_feat; ++j) {
            u[j] = u_new[j] / norm_u;
        }
    } else {
        for (uint j = 0u; j < in_feat; ++j) {
            u[j] = u_new[j];
        }
    }

    // 3. sigma = u^T W v
    float sigma_val = 0.0;
    for (uint i = 0u; i < out_feat; ++i) {
        float sum = 0.0;
        for (uint j = 0u; j < in_feat; ++j) {
            sum += W[i * in_feat + j] * u[j];
        }
        sigma_val += sum * v[i];
    }

    sigma = sigma_val;
}