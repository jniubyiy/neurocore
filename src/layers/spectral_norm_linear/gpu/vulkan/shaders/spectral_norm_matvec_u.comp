// src/layers/spectral_norm_linear/gpu/vulkan/shaders/spectral_norm_matvec_u.comp
//
// Один шаг power-итерации: u = Wᵀ · v.
//
// W хранится row-major: W[i * in_features + j].
//
// Один поток на входной признак j. Цикл по i — линейный, O(out) на поток.
//
// Push: in_features, out_features.
// Dispatch: in_features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer WeightBuf { float W[]; };
layout(binding = 1, std430) readonly buffer VBuf      { float v[]; };
layout(binding = 2, std430) writeonly buffer UBuf     { float u[]; };

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= pc.in_features) return;

    float sum = 0.0;
    for (uint i = 0u; i < pc.out_features; ++i) {
        sum += W[i * pc.in_features + j] * v[i];
    }
    u[j] = sum;
}