// src/layers/spectral_norm_linear/gpu/vulkan/shaders/spectral_norm_matvec_v.comp
//
// Один шаг power-итерации: v = W · u.
//
// W хранится row-major: W[i * in_features + j], i ∈ [0, out_features).
//
// Один поток на выходной признак i. Цикл по j — линейный, O(in) на поток.
// Локальных массивов нет, ограничений на размерности нет.
//
// Push: in_features, out_features.
// Dispatch: out_features потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer WeightBuf { float W[]; };
layout(binding = 1, std430) readonly buffer UBuf      { float u[]; };
layout(binding = 2, std430) writeonly buffer VBuf     { float v[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.out_features) return;

    float sum = 0.0;
    for (uint j = 0u; j < pc.in_features; ++j) {
        sum += W[i * pc.in_features + j] * u[j];
    }
    v[i] = sum;
}