// src/layers/spectral_norm_linear/gpu/vulkan/shaders/spectral_norm_normalize.comp
//
// Нормализация вектора на месте: v := v / max(‖v‖₂, eps).
//
// Одна workgroup (local_size_x = 256) обрабатывает весь вектор.
// Редукция суммы квадратов — через shared-память и барьеры.
// Никаких локальных массивов на поток, ограничений на длину нет.
//
// Push: len (элементов в векторе), eps (float-биты).
// Dispatch: [1, 1, 1] (одна группа).

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint len;
    float eps;
} pc;

layout(binding = 0, std430) buffer VecBuf { float vec[]; };

shared float partial[256];

void main() {
    uint tid    = gl_LocalInvocationID.x;
    uint stride = gl_WorkGroupSize.x;

    float sum_sq = 0.0;
    for (uint i = tid; i < pc.len; i += stride) {
        float val = vec[i];
        sum_sq += val * val;
    }

    partial[tid] = sum_sq;
    barrier();

    // Редукция в shared.
    for (uint s = stride / 2u; s > 0u; s >>= 1u) {
        if (tid < s) {
            partial[tid] += partial[tid + s];
        }
        barrier();
    }

    float norm = sqrt(partial[0]);
    if (!(norm > pc.eps)) {
        norm = pc.eps;
    }

    for (uint i = tid; i < pc.len; i += stride) {
        vec[i] /= norm;
    }
}