// src/layers/spectral_norm_linear/gpu/vulkan/shaders/spectral_norm_sigma.comp
//
// Вычисление σ = uᵀ · (W · v).
//
// Один поток. Два вложенных линейных цикла: O(out · in).
// Локальных массивов нет, ограничений нет.
//
// Push: in_features, out_features.
// Dispatch: [1, 1, 1].

#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint in_features;
    uint out_features;
} pc;

layout(binding = 0, std430) readonly buffer WeightBuf { float W[]; };
layout(binding = 1, std430) readonly buffer UBuf      { float u[]; };
layout(binding = 2, std430) readonly buffer VBuf      { float v[]; };
layout(binding = 3, std430) writeonly buffer SigmaBuf { float sigma[]; };

void main() {
    float sum = 0.0;
    for (uint i = 0u; i < pc.out_features; ++i) {
        float wv = 0.0;
        for (uint j = 0u; j < pc.in_features; ++j) {
            wv += W[i * pc.in_features + j] * v[j];
        }
        sum += u[i] * wv;
    }
    sigma[0] = sum;
}