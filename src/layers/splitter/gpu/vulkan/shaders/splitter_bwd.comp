#version 450
// NO extensions required

layout(local_size_x = 256) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;
    uint p;
    uint q;
} pc;

layout(binding = 0, std430) readonly buffer X    { float x[]; };
layout(binding = 1, std430) readonly buffer Da   { float da[]; };
layout(binding = 2, std430) readonly buffer Db   { float db[]; };
layout(binding = 3, std430) readonly buffer PreA { float pre_a[]; };
layout(binding = 4, std430) readonly buffer PreB { float pre_b[]; };
layout(binding = 5, std430) readonly buffer Wa   { float wa[]; };
layout(binding = 6, std430) readonly buffer Wb   { float wb[]; };
layout(binding = 7, std430) writeonly buffer Dx  { float dx[]; };
layout(binding = 8, std430) buffer DWa    { int dwa[]; };
layout(binding = 9, std430) buffer DBiasA { int dbiasa[]; };
layout(binding =10, std430) buffer DWb    { int dwb[]; };
layout(binding =11, std430) buffer DBiasB { int dbiasb[]; };

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.batch) return;

    for (uint k = 0; k < pc.n; ++k) {
        float sum = 0.0;
        for (uint j = 0; j < pc.p; ++j) {
            float dpa = da[row * pc.p + j] * (pre_a[row * pc.p + j] > 0.0 ? 1.0 : 0.0);
            sum += dpa * wa[j * pc.n + k];
            // CAS для dwa[j,k]
            float inc = dpa * x[row * pc.n + k];
            int expected = dwa[j * pc.n + k];
            int desired;
            do {
                float cur = intBitsToFloat(expected);
                desired = floatBitsToInt(cur + inc);
                int old = atomicCompSwap(dwa[j * pc.n + k], expected, desired);
                if (old == expected) break;
                expected = old;
            } while (true);
        }
        for (uint j = 0; j < pc.q; ++j) {
            float dpb = db[row * pc.q + j] * (pre_b[row * pc.q + j] > 0.0 ? 1.0 : 0.0);
            sum += dpb * wb[j * pc.n + k];
            // CAS для dwb[j,k]
            float inc = dpb * x[row * pc.n + k];
            int expected = dwb[j * pc.n + k];
            int desired;
            do {
                float cur = intBitsToFloat(expected);
                desired = floatBitsToInt(cur + inc);
                int old = atomicCompSwap(dwb[j * pc.n + k], expected, desired);
                if (old == expected) break;
                expected = old;
            } while (true);
        }
        dx[row * pc.n + k] = sum;
    }

    for (uint j = 0; j < pc.p; ++j) {
        float dpa = da[row * pc.p + j] * (pre_a[row * pc.p + j] > 0.0 ? 1.0 : 0.0);
        int expected = dbiasa[j];
        int desired;
        do {
            float cur = intBitsToFloat(expected);
            desired = floatBitsToInt(cur + dpa);
            int old = atomicCompSwap(dbiasa[j], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
    for (uint j = 0; j < pc.q; ++j) {
        float dpb = db[row * pc.q + j] * (pre_b[row * pc.q + j] > 0.0 ? 1.0 : 0.0);
        int expected = dbiasb[j];
        int desired;
        do {
            float cur = intBitsToFloat(expected);
            desired = floatBitsToInt(cur + dpb);
            int old = atomicCompSwap(dbiasb[j], expected, desired);
            if (old == expected) break;
            expected = old;
        } while (true);
    }
}