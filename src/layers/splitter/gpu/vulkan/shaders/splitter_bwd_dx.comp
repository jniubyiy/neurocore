// src/layers/splitter/gpu/vulkan/shaders/splitter_bwd_dx.comp
//
// Обратный проход Splitter: градиент по входу x.
//
// Один поток на элемент (r, c). Цикл по k — линейный.
//
//   dx[c, r] = Σ_k d_pre_a[k, r] · wa[k, c]
//            + Σ_k d_pre_b[k, r] · wb[k, c]
//   где d_pre_a[k, r] = (pre_a[k,r] > 0) ? da[k,r] : 0
//
// Раскладка активаций — column-major.
//
// Push-константы: batch, n, p, q.
// Dispatch: batch · n потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;
    uint p;
    uint q;
} pc;

layout(binding = 0, std430) readonly buffer DaBuf   { float da[]; };
layout(binding = 1, std430) readonly buffer DbBuf   { float db[]; };
layout(binding = 2, std430) readonly buffer PreABuf { float pre_a[]; };
layout(binding = 3, std430) readonly buffer PreBBuf { float pre_b[]; };
layout(binding = 4, std430) readonly buffer WaBuf   { float wa[]; };
layout(binding = 5, std430) readonly buffer WbBuf   { float wb[]; };
layout(binding = 6, std430) writeonly buffer DxBuf  { float dx[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.batch * pc.n) return;

    uint r = gid % pc.batch;
    uint c = gid / pc.batch;

    float sum = 0.0;
    for (uint k = 0u; k < pc.p; ++k) {
        float pre_a_val = pre_a[k * pc.batch + r];
        float d_pre_a = (pre_a_val > 0.0) ? da[k * pc.batch + r] : 0.0;
        sum += d_pre_a * wa[k * pc.n + c];
    }
    for (uint k = 0u; k < pc.q; ++k) {
        float pre_b_val = pre_b[k * pc.batch + r];
        float d_pre_b = (pre_b_val > 0.0) ? db[k * pc.batch + r] : 0.0;
        sum += d_pre_b * wb[k * pc.n + c];
    }
    dx[c * pc.batch + r] = sum;
}