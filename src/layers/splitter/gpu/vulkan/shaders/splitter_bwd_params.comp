// src/layers/splitter/gpu/vulkan/shaders/splitter_bwd_params.comp
//
// Обратный проход Splitter: градиенты по wa, wb, bias_a, bias_b.
//
// Распараллелено так: один поток на параметр.
//   [0, p·n)                — grad_wa[j·n + k]
//   [p·n, p·n + q·n)        — grad_wb[(j−p)·n + k]
//   [p·n + q·n, p·n + q·n+p) — grad_bias_a[j]
//   [...+p, ...+p+q)         — grad_bias_b[j]
//
// Прямая запись — каждый индекс пишется ровно один раз, атомика не нужна.
//
// Раскладка активаций — column-major.
//
// Push-константы: batch, n, p, q.
// Dispatch: p·n + q·n + p + q потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;
    uint p;
    uint q;
} pc;

layout(binding = 0, std430) readonly buffer XBuf     { float x[]; };
layout(binding = 1, std430) readonly buffer DaBuf    { float da[]; };
layout(binding = 2, std430) readonly buffer DbBuf    { float db[]; };
layout(binding = 3, std430) readonly buffer PreABuf  { float pre_a[]; };
layout(binding = 4, std430) readonly buffer PreBBuf  { float pre_b[]; };
layout(binding = 5, std430) writeonly buffer DWaBuf   { float d_wa[]; };
layout(binding = 6, std430) writeonly buffer DBiasABuf { float d_bias_a[]; };
layout(binding = 7, std430) writeonly buffer DWbBuf   { float d_wb[]; };
layout(binding = 8, std430) writeonly buffer DBiasBBuf { float d_bias_b[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint p_n = pc.p * pc.n;
    uint q_n = pc.q * pc.n;
    uint total = p_n + q_n + pc.p + pc.q;
    if (gid >= total) return;

    if (gid < p_n) {
        uint j = gid / pc.n;
        uint k = gid % pc.n;
        float acc = 0.0;
        for (uint r = 0u; r < pc.batch; ++r) {
            float pre_val = pre_a[j * pc.batch + r];
            float d_pre = (pre_val > 0.0) ? da[j * pc.batch + r] : 0.0;
            acc += d_pre * x[k * pc.batch + r];
        }
        d_wa[gid] = acc;
    } else if (gid < p_n + q_n) {
        uint local = gid - p_n;
        uint j = local / pc.n;
        uint k = local % pc.n;
        float acc = 0.0;
        for (uint r = 0u; r < pc.batch; ++r) {
            float pre_val = pre_b[j * pc.batch + r];
            float d_pre = (pre_val > 0.0) ? db[j * pc.batch + r] : 0.0;
            acc += d_pre * x[k * pc.batch + r];
        }
        d_wb[local] = acc;
    } else if (gid < p_n + q_n + pc.p) {
        uint j = gid - p_n - q_n;
        float acc = 0.0;
        for (uint r = 0u; r < pc.batch; ++r) {
            float pre_val = pre_a[j * pc.batch + r];
            float d_pre = (pre_val > 0.0) ? da[j * pc.batch + r] : 0.0;
            acc += d_pre;
        }
        d_bias_a[j] = acc;
    } else {
        uint j = gid - p_n - q_n - pc.p;
        float acc = 0.0;
        for (uint r = 0u; r < pc.batch; ++r) {
            float pre_val = pre_b[j * pc.batch + r];
            float d_pre = (pre_val > 0.0) ? db[j * pc.batch + r] : 0.0;
            acc += d_pre;
        }
        d_bias_b[j] = acc;
    }
}