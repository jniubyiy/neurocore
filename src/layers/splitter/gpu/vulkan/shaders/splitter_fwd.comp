#version 450
layout(local_size_x = 256) in;
layout(push_constant) uniform PushConsts { uint batch; uint n; uint p; uint q; } pc;
layout(binding = 0, std430) readonly buffer X { float x[]; };
layout(binding = 1, std430) readonly buffer Wa { float wa[]; }; // p * n
layout(binding = 2, std430) readonly buffer BiasA { float ba[]; }; // p
layout(binding = 3, std430) readonly buffer Wb { float wb[]; }; // q * n
layout(binding = 4, std430) readonly buffer BiasB { float bb[]; }; // q
layout(binding = 5, std430) writeonly buffer OutA { float a[]; };
layout(binding = 6, std430) writeonly buffer PreA { float pre_a[]; };
layout(binding = 7, std430) writeonly buffer OutB { float b[]; };
layout(binding = 8, std430) writeonly buffer PreB { float pre_b[]; };

void main() {
    uint row = gl_GlobalInvocationID.x; // строка батча
    if (row >= pc.batch) return;
    uint n = pc.n;
    uint p = pc.p;
    uint q = pc.q;
    float x_val;
    float sum;
    // ветка A
    for (uint j = 0; j < p; j++) {
        sum = ba[j];
        for (uint k = 0; k < n; k++) {
            sum += x[row * n + k] * wa[j * n + k];
        }
        pre_a[row * p + j] = sum;
        a[row * p + j] = max(sum, 0.0);
    }
    // ветка B
    for (uint j = 0; j < q; j++) {
        sum = bb[j];
        for (uint k = 0; k < n; k++) {
            sum += x[row * n + k] * wb[j * n + k];
        }
        pre_b[row * q + j] = sum;
        b[row * q + j] = max(sum, 0.0);
    }
}