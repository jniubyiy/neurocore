// src/layers/splitter/gpu/vulkan/shaders/splitter_fwd.comp
//
// Прямой проход Splitter (column-major).
//
// Один поток на выходной элемент (r, j), где j ∈ [0, p+q).
//   j < p — ветвь A: out_a[j, r] = ReLU(bias_a[j] + Σ_k x[k,r] · wa[j,k])
//   j ≥ p — ветвь B: out_b[j−p, r] = ReLU(bias_b[j−p] + Σ_k x[k,r] · wb[j−p,k])
//
// Раскладка активаций — column-major: x[k · batch + r].
// Веса — row-major: wa[j · n + k].
//
// Push-константы: batch, n, p, q.
// Dispatch: batch · (p + q) потоков.

#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint n;
    uint p;
    uint q;
} pc;

layout(binding = 0, std430) readonly buffer XBuf      { float x[]; };
layout(binding = 1, std430) readonly buffer WaBuf     { float wa[]; };
layout(binding = 2, std430) readonly buffer BiasABuf  { float bias_a[]; };
layout(binding = 3, std430) readonly buffer WbBuf     { float wb[]; };
layout(binding = 4, std430) readonly buffer BiasBBuf  { float bias_b[]; };
layout(binding = 5, std430) writeonly buffer OutABuf  { float out_a[]; };
layout(binding = 6, std430) writeonly buffer PreABuf  { float pre_a[]; };
layout(binding = 7, std430) writeonly buffer OutBBuf  { float out_b[]; };
layout(binding = 8, std430) writeonly buffer PreBBuf  { float pre_b[]; };

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = pc.batch * (pc.p + pc.q);
    if (gid >= total) return;

    // Column-major: gid = j · batch + r.
    uint r = gid % pc.batch;
    uint j = gid / pc.batch;

    if (j < pc.p) {
        float sum = bias_a[j];
        for (uint k = 0u; k < pc.n; ++k) {
            sum += x[k * pc.batch + r] * wa[j * pc.n + k];
        }
        pre_a[j * pc.batch + r] = sum;
        out_a[j * pc.batch + r] = max(sum, 0.0);
    } else {
        uint jj = j - pc.p;
        float sum = bias_b[jj];
        for (uint k = 0u; k < pc.n; ++k) {
            sum += x[k * pc.batch + r] * wb[jj * pc.n + k];
        }
        pre_b[jj * pc.batch + r] = sum;
        out_b[jj * pc.batch + r] = max(sum, 0.0);
    }
}