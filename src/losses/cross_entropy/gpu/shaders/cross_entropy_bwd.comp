// src/losses/cross_entropy/gpu/shaders/cross_entropy_bwd.comp

#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint num_classes;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float data[];  // column-major: логиты + индекс класса
};
layout(binding = 1, std430) readonly buffer GradOutBuf {
    float go[];    // градиент по loss (по одному на батч)
};
layout(binding = 2, std430) writeonly buffer GradInBuf {
    float gi[];    // градиент по входу (размер batch * (num_classes+1))
};

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.batch) return;

    uint nclass = pc.num_classes;
    uint class_idx = uint(data[nclass * pc.batch + r]);
    float grad = go[r];

    // Устойчивый softmax
    float max_val = data[0 * pc.batch + r];
    for (uint c = 1; c < nclass; c++) {
        float v = data[c * pc.batch + r];
        if (v > max_val) max_val = v;
    }

    float sum_exp = 0.0;
    for (uint c = 0; c < nclass; c++) {
        float v = data[c * pc.batch + r];
        sum_exp += exp(v - max_val);
    }

    // Градиенты по логитам: softmax_c - indicator(c == class_idx)
    for (uint c = 0; c < nclass; c++) {
        float v = data[c * pc.batch + r];
        float softmax_c = exp(v - max_val) / sum_exp;
        float indicator = (c == class_idx) ? 1.0 : 0.0;
        gi[c * pc.batch + r] = grad * (softmax_c - indicator);
    }

    // Градиент по индексу класса всегда 0
    gi[nclass * pc.batch + r] = 0.0;
}
 