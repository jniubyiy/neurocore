#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint num_classes;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float data[];
};
layout(binding = 1, std430) writeonly buffer OutputBuf {
    float loss[];
};

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.batch) return;

    uint base = r * (pc.num_classes + 1);
    uint class_idx = uint(data[base + pc.num_classes]);

    // Устойчивый softmax: вычитаем максимальный логит
    float max_val = data[base];
    for (uint c = 1; c < pc.num_classes; c++) {
        if (data[base + c] > max_val) max_val = data[base + c];
    }

    float sum_exp = 0.0f;
    for (uint c = 0; c < pc.num_classes; c++) {
        sum_exp += exp(data[base + c] - max_val);
    }

    float log_softmax = data[base + class_idx] - max_val - log(sum_exp);
    loss[r] = -log_softmax;
}