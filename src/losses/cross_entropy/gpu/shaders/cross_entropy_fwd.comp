// src/losses/cross_entropy/gpu/shaders/cross_entropy_fwd.comp

#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint batch;
    uint num_classes;
} pc;

layout(binding = 0, std430) readonly buffer InputBuf {
    float data[];  // column-major: логиты (num_classes столбцов) + индекс класса (последний столбец)
};
layout(binding = 1, std430) writeonly buffer OutputBuf {
    float loss[];  // по одному значению на батч
};

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.batch) return;

    uint nclass = pc.num_classes;
    // Индекс правильного класса хранится в последнем столбце (nclass * batch + r)
    uint class_idx = uint(data[nclass * pc.batch + r]);

    // Устойчивый softmax: находим максимум по логитам
    float max_val = data[0 * pc.batch + r];
    for (uint c = 1; c < nclass; c++) {
        float v = data[c * pc.batch + r];
        if (v > max_val) max_val = v;
    }

    // Сумма экспонент
    float sum_exp = 0.0;
    for (uint c = 0; c < nclass; c++) {
        float v = data[c * pc.batch + r];
        sum_exp += exp(v - max_val);
    }

    // Логит правильного класса
    float logit = data[class_idx * pc.batch + r];

    // CrossEntropy loss = -(logit - max_val - log(sum_exp))
    loss[r] = -(logit - max_val - log(sum_exp));
}