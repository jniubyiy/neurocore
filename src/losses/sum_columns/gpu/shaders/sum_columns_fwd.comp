#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConsts {
    uint rows;
    uint cols;
} pc;

layout(binding = 0, std430) readonly buffer InBuf {
    float data[];   // column-major: data[c * rows + r]
};

layout(binding = 1, std430) writeonly buffer OutBuf {
    float result[]; // result[r]
};

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.rows) return;

    float sum = 0.0;
    for (uint c = 0; c < pc.cols; ++c) {
        sum += data[c * pc.rows + r];
    }
    result[r] = sum;
}